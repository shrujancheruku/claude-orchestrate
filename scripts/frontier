#!/usr/bin/env python3
"""frontier [--parent <n> | --ticket <n>] [--all] [--fix-drift] [--snapshot FILE] [--repo DIR] : which tickets are takeable now?

Default: one line per takeable ticket, `#<n> <title> model <name>`, ascending, then the verdict line.
`model <name>` is the model to dispatch the ticket's worker with (Config.model_for: the Worker row of the config's Models
table, the ticket's `size:` label, "investigate"/"design" in its title or body, and the touch map). The scout's map is not
known yet when the line first prints, so an unlabelled ticket shows the default model; `--ticket <n> --touch-map '<map>'`
prints the line again with the model the map earns (the small model only for a map within the S file limit and off every
risk path).
--all appends four sections, each `<name>:` then one line per item, or `none`:
    not-takeable:    `#<n> <reason>` for every other `ready-for-agent` ticket (claimed, blocked-by #<m>..., parent, lead, wayfinder)
    ready-for-human: `#<n> <title>`
    parents-closed:  `#<n> <title>`, open parents whose sub-issues are all closed
    drift:           `#<n> body says blocked by #<m>, tracker does not`
--parent <n> limits every section to that parent's sub-issues, --ticket <n> to one ticket (its line, or its reason).
--ticket <n> for a number absent from the open issues prints `#<n> not open` and exits 0.
An unreadable docs/agents/triage-labels.md is exit 2 with one stderr line; a missing one keeps the default labels.
--fix-drift adds the native `blocked_by` edge for every `drift:` line in scope (the tracker doc's Blocking command), prints
`added #<n> blocked by #<m>` for each, and then prints as usual with those lines gone from `drift:`; the orchestrator never runs it.
The rules are in scripts/tracker.py. Reads the open issues through a Snapshot (every page of one `gh api graphql` query;
--snapshot FILE reads the file `snapshot` wrote instead of fetching) and the label strings from
docs/agents/triage-labels.md (the defaults when it is missing). Exit codes: 0 ran; 2 could not run
(no `gh`, a failed `gh` call, a malformed reply), one line on stderr and no partial output. The output ends with the
one verdict line (ADR-0014; an empty frontier prints only it): `next: done` (0) | `retry-after <time>` (2, a rate limit) |
`could-not-run [<Class>: <message>]` (2). Stdlib only, Python 3.9+.
"""

import argparse
import re
import sys
from pathlib import Path

import common
import config
import github
import runlog
import touchmap
import tracker

def titled(i) -> str:
    return f"#{i['number']} {i['title']}"


def section(name, lines) -> list:
    return [f"{name}:", *(lines or ["none"])]


INVESTIGATE = re.compile(r"\b(?:investigate|design)\b", re.IGNORECASE)


def model_of(issue, cfg, touch_map) -> str:
    """The worker model for a ticket: Config.model_for over its labels, its title and body, and the touch map's paths
    (None until the scout has produced one)."""
    paths = None if touch_map is None else [e.path for e in touch_map]
    return cfg.model_for(issue["labels"], paths, bool(INVESTIGATE.search(f"{issue['title']} {issue['body']}")))


def render(issues, scope, labels, show_all, cfg=None, touch_map=None) -> list:
    """The output lines; `issues` is the whole snapshot (blockers are judged against it), `scope` the part to print.
    Each takeable line ends `model <name>`, the model to dispatch its worker with (`touch_map` is --touch-map's)."""
    cfg = cfg or config.Config()
    scope = sorted(scope, key=lambda i: i["number"])
    ready = [i for i in scope if labels["ready"] in i["labels"]]
    taken = {i["number"] for i in tracker.takeable(issues, labels)}
    out = [f"{titled(i)} model {model_of(i, cfg, touch_map)}" for i in ready if i["number"] in taken]
    if not show_all:
        return out
    in_scope = {i["number"] for i in scope}
    out += section("not-takeable", [f"#{i['number']} {tracker.why_not(i, labels, issues)}"
                                    for i in ready if i["number"] not in taken])
    out += section("ready-for-human", [titled(i) for i in scope if labels["human"] in i["labels"]])
    out += section("parents-closed", [titled(i) for i in tracker.closed_parents(scope)])
    out += section("drift", [f"#{i['number']} body says blocked by #{n}, tracker does not"
                             for i, n in tracker.drift(issues) if i["number"] in in_scope])
    return out


def fix_drift(issues, scope, root) -> None:
    """Add the native edge for each drift in `scope` and record it in the issue dict. Each `added` line prints as its
    edge lands, so a later failure still says what was changed."""
    in_scope = {i["number"] for i in scope}
    for issue, n in tracker.drift(issues):
        if issue["number"] in in_scope:
            github.add_blocked_by(issue["number"], n, cwd=root)
            issue["blockers"] = sorted(issue["blockers"] + [n])
            print(f"added #{issue['number']} blocked by #{n}", flush=True)


def run(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0], allow_abbrev=False)
    which = ap.add_mutually_exclusive_group()
    which.add_argument("--parent", type=int, help="only this parent's sub-issues")
    which.add_argument("--ticket", type=int, help="only this ticket")
    ap.add_argument("--all", action="store_true",
                    help="add the not-takeable, ready-for-human, parents-closed and drift sections")
    ap.add_argument("--fix-drift", action="store_true",
                    help="add the native blocked_by edge for each drift line (prints each edge added)")
    ap.add_argument("--touch-map", help="with --ticket: the scout's touch map; the line's model then follows it (a small, "
                    "risk-free map lets an unlabelled ticket take the small model)")
    ap.add_argument("--snapshot", help="read the tracker from this file (scripts/snapshot) instead of fetching")
    ap.add_argument("--repo", default=".", help="a directory of the repository (default: the current one)")
    args = ap.parse_args(argv)
    root = Path(args.repo).resolve()
    touch_map = None
    if args.touch_map is not None:
        if args.ticket is None:
            common.die("frontier: cannot run: --touch-map needs --ticket")
        try:
            touch_map = touchmap.parse(args.touch_map)
        except touchmap.TouchMapError as e:
            common.die(f"frontier: cannot run: {e}")
    if not root.is_dir() or common.run("git", "rev-parse", "--git-dir", cwd=root).code != 0:
        common.die(f"frontier: cannot run: {args.repo} is not in a git repository")
    try:
        labels = tracker.label_strings(root)
    except ValueError as e:
        common.die(f"frontier: cannot run: {e}")
    try:
        issues = tracker.Snapshot.open(args.snapshot, root).issues
    except github.GhError as e:
        common.die(f"frontier: cannot run: gh failed: {e.message}")
    except (KeyError, TypeError, ValueError, AttributeError) as e:
        common.die(f"frontier: cannot run: malformed reply from gh ({e!r})")
    try:
        scope = tracker.scoped(issues, args.parent, args.ticket)
        if args.fix_drift:
            fix_drift(issues, scope, root)
    except github.GhError as e:
        common.die(f"frontier: cannot run: gh failed: {e.message}")
    lines = render(issues, scope, labels, args.all, config.Config.load(root), touch_map)
    if args.ticket is not None and not scope:
        lines.insert(0, f"#{args.ticket} not open")
    if args.ticket is not None and not args.all and scope and not lines:
        # A named ticket always answers: its line, or the reason it is not takeable.
        reason = tracker.why_not(scope[0], labels, issues) if labels["ready"] in scope[0]["labels"] else None
        lines = [f"#{args.ticket} {reason or 'not ' + labels['ready']}"]
    for line in lines:
        print(line)
    try:
        runlog.append_event(root, "frontier", "ran", takeable=len(tracker.takeable(issues, labels)))
    except runlog.NoSession as e:
        print(e, file=sys.stderr)  # the answer is already printed; the missing log is not a failure
    return 0


def main(argv=None) -> int:
    """Run, then end with the one `next:` line (see the module docstring)."""
    return common.finish(run, argv, {0: ("done",)})


if __name__ == "__main__":
    sys.exit(main())
