#!/usr/bin/env python3
"""rescue <ticket | branch> [--title T] [--pr N] [--repo DIR] : save a stalled or stopped ticket's worktree, then retire it.

The one place the rescue recipe lives (commit the work, push, unlock a dead lock, remove the worktree plainly, never
force). Given a branch it finds the worktree checked out on it with `git worktree list`. Given a ticket number it
finds the ticket's worktree the way `claims` does (claims.find_worktree: the worker's state-file record, then the
ticket branch), so a worker stopped before it made the ticket branch, whose worktree sits on the harness's
`worktree-agent-*` branch, is still found. It never calls `gh` itself: its only tracker contact is the `holds` library
(scripts/holds.py), run in process on one Snapshot. Each step prints one line, in this order:

1. liveness: a lock naming one of this process's ancestors is this session's own, a dead lock is stale; both are
   unlocked. Another process's live pid, or a reason that does not parse, stops here (exit 3), nothing touched.
   If the worktree is not on a branch of the ticket, a branch line follows: `branch: created <n>-<slug>` (`--title`
   gives the slug) cut from the worktree's HEAD, with the changes committed on it as `chore(wip): rescue #<n>`; the
   `worktree-agent-*` branch is left to the harness.
2. changed paths: every path the worktree changed against the default branch (committed, staged, unstaged, untracked).
3. commit: `chore(wip): <T>` (or `chore(wip): #<n> work in progress` without --title) when the tree is dirty.
4. push: `git push -u origin <branch>` when commits are unpushed or the branch has no remote ref..
5. remove: the worktree, plainly (the local branch is kept).
6. scratch: with `--pr <n>`, the PR's reviewer scratch worktrees (`pr-<n>`, detached) with HEAD in the rescued branch are removed plainly
   (`scratch worktree <path> removed`); a dirty one, a live foreign lock or a HEAD outside the branch is kept with one
   `scratch worktree <path> NOT removed: <why>` line, the same checks `merge` makes. Without `--pr` none is touched.
7. overlap: the holds library on the changed paths against everything else that is held: `overlap: none`, its `overlap:` lines,
   or `overlap: could not check (...)`. A rate-limited check waits within the shared backoff (`github.call`); if it still can't
   run, `overlap: unchecked (rate limited; re-run holds before dispatching into these files)` and exit 0.

No worktree on the branch (or for the ticket): `nothing to rescue: no worktree on <branch | #n>`, exit 0 (the remote branch is the whole state).
Exit codes: 0 saved (or nothing to do); 1 saved, but the paths overlap something held or that could not be checked
(dispatch no worker; the user decides); 2 could not run, or a step failed (one line on stderr, a lock step 1 lifted put back, or said to be not put back; the worktree stays unless step 5 already removed it, and an exit 2 after that leaves it removed);
3 a live lock that is not this session's (`live <pid | ?> <worktree>`).
Last line, always (ADR-0014): `next: done` (0) | `ask-user overlap` (1) | `elsewhere` (3) | `retry-after <time>` (2, a rate limit)
| `could-not-run [<Class>: <message>]` (2). Stdlib only, Python 3.9+.
"""

from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path

import claims
import common
import github
import holds
import repo
import tracker


def say(msg):
    print(msg, flush=True)


# (root, path, reason) of a lock step 1 lifted: a later failure puts it back, so the worktree is left as found.
LIFTED: list = []
# (path, harness branch, new branch, the HEAD it was cut at) of a branch step 1 created with `git switch -c`: a later
# failure switches back and deletes it while it still points at that HEAD (nothing committed on it yet).
CREATED: list = []


def undo_branch() -> str:
    """Put the worktree back on the branch it was found on, when the new branch holds nothing of its own. Returns a
    note for the failure message; "" when there was nothing to undo."""
    note = ""
    for path, old, new, sha in CREATED:
        if git(path, "rev-parse", new).stdout.strip() != sha:
            note += f"; branch {new} kept: it holds the work committed on it"
            continue
        back = git(path, "switch", old)
        gone = git(path, "branch", "-d", new) if back.code == 0 else back
        if gone.code != 0:
            note += f"; could not undo the switch to {new}: {common.one_line(gone.stderr)}"
    CREATED.clear()
    return note


def fail(msg) -> int:
    if CREATED:
        msg += undo_branch()
    for lroot, path, reason in LIFTED:
        r = common.run("git", "worktree", "lock", "--reason", reason, path, cwd=lroot)
        if r.code != 0:
            msg = f"{msg}; could not put the lock back on {path}: {common.one_line(r.stderr)}"
    LIFTED.clear()
    print(f"rescue: {msg}", file=sys.stderr)
    return 2


def git(path, *args):
    return common.run("git", *args, cwd=path)


def default_base(root):
    """The default branch's name from git alone (no `gh`): origin/HEAD, else main or master; None when none exists."""
    r = git(root, "symbolic-ref", "--short", "refs/remotes/origin/HEAD")
    if r.code == 0 and r.stdout.strip().startswith("origin/"):
        return r.stdout.strip()[len("origin/"):]
    for name in ("main", "master"):
        if any(git(root, "rev-parse", "--verify", "-q", ref).code == 0 for ref in (f"origin/{name}", name)):
            return name
    return None


def unpushed(path, branch) -> int | None:
    """Commits no remote has: those past origin/<branch>, or every commit no remote ref has when the branch was never
    pushed. None when git can't say."""
    if git(path, "rev-parse", "--verify", "-q", f"origin/{branch}").code == 0:
        r = git(path, "log", "--format=%H", f"origin/{branch}..")
    else:
        r = git(path, "rev-list", "HEAD", "--not", "--remotes")
    return len(r.stdout.split()) if r.code == 0 else None


def liveness(root, branch, wt):
    """(exit code or None, line). Unlocks this session's own lock and a dead one; refuses any other."""
    reason = wt["locked"]
    if reason is None:
        return None, "lock: none"
    state, pid = common.worker_liveness(reason)
    if state == "foreign-live" and pid is None:
        return 3, f"live ? {wt['path']} (lock: {common.one_line(reason) or 'no reason given'})"
    if state == "foreign-live":
        return 3, f"live {pid} {wt['path']}"
    u = git(root, "worktree", "unlock", wt["path"])
    if u.code != 0:
        return 2, f"could not unlock {wt['path']}: {common.one_line(u.stderr)}"
    LIFTED.append((root, wt["path"], reason))
    return None, f"lock: {'this session' if state == 'ours' else 'dead'} pid {pid}, unlocked"


def has_local(root, name) -> bool:
    return git(root, "rev-parse", "--verify", "-q", f"refs/heads/{name}").code == 0


def ticket_branches(root, ticket) -> list:
    """Every branch named `<ticket>-*`, local or on origin, as short names without duplicates."""
    names = []
    for prefix, strip in (("refs/heads", "refs/heads/"), ("refs/remotes/origin", "refs/remotes/origin/")):
        r = git(root, "for-each-ref", "--format=%(refname)", f"{prefix}/{ticket}-*")
        for ref in r.stdout.split():
            name = ref[len(strip):]
            if name not in names:
                names.append(name)
    return names


def overlap(root, changed, ticket) -> int:
    """The holds library on the changed paths, in process on one Snapshot (the PR file lists come from the main
    checkout's snapshot file when the head SHAs match, #446). `github.call` already waits out a shared rate-limit reset
    within its budget, so a `ratelimited` error here is one it gave up on."""
    if not changed:
        say("overlap: none")
        return 0
    try:
        snap = tracker.Snapshot.open(None, root)
        snap.use_cache(root / tracker.SNAPSHOT_FILE)
        result = holds.find(snap, root, root / repo.STATE, candidates=changed, ticket=ticket)
    except github.GhError as e:
        if e.kind == github.RATELIMITED:
            # The rescue itself is done; only the lookup was limited. Not a failure: the orchestrator checks holds later.
            github.rate_limited_until = None  # swallowed: a later exit 2 is a failure, not a rate limit
            say("overlap: unchecked (rate limited; re-run holds before dispatching into these files)")
            return 0
        say(f"overlap: could not check ({common.one_line(e.message) or 'no reason given'})")
        return 1  # an unknown overlap is an overlap
    except (KeyError, TypeError, ValueError, OSError) as e:
        say(f"overlap: could not check ({common.one_line(str(e)) or type(e).__name__})")
        return 1
    except Exception as e:  # any other crash is an overlap that could not be checked, never a traceback (#618)
        say(f"overlap: could not check ({type(e).__name__}: {common.one_line(str(e))})")
        return 1
    if not result.counted:
        say("overlap: none")
        return 0
    for o in result.counted:
        say(o.render())
    return 1


def main(argv=None) -> int:
    """Run, then end with the one `next:` line (see the module docstring)."""
    def crashed(e):  # unexpected (an OSError from a subprocess, say): put the lifted locks back like any exit 2
        return fail(f"unexpected {type(e).__name__}: {common.one_line(e)}")
    return common.finish(run, argv, {0: ("done",), 1: ("ask-user", "overlap"), 3: ("elsewhere",)}, on_error=crashed)


def run(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0], allow_abbrev=False)  # the guard approves it by flag name
    ap.add_argument("branch", metavar="ticket|branch", help="the ticket number, or its branch `<number>-<slug>`")
    ap.add_argument("--title", help="the ticket title, for the wip commit message")
    ap.add_argument("--pr", type=int, help="the ticket's open PR: its reviewer scratch worktrees are removed too")
    ap.add_argument("--repo", default=".", help="the repo root (default: the current directory)")
    args = ap.parse_args(argv)
    root, branch = Path(args.repo).resolve(), args.branch
    if not root.is_dir() or common.run("git", "rev-parse", "--git-dir", cwd=root).code != 0:
        return fail(f"cannot run: {args.repo} is not in a git repository")
    by_number = branch.isdigit()
    ticket = int(branch) if by_number else repo.ticket_of_branch(branch)
    if ticket is None:
        return fail(f"{branch} is not named <number>-<slug>, so there is no ticket to check the overlap for")

    if by_number:
        try:
            record = claims.read_state(root / repo.STATE).get(str(ticket))
        except ValueError as e:
            return fail(common.one_line(e))
        wts = [w for w in common.worktrees(root) if Path(w["path"]).is_dir()]
        wt = claims.find_worktree(ticket, wts, record)
    else:
        wt = next((w for w in common.worktrees(root) if w["branch"] == branch), None)
    if wt is None:
        say(f"nothing to rescue: no worktree on {branch if not by_number else '#' + branch}")
        return 0
    branch = wt["branch"] if not by_number else wt["branch"] or ""
    path = wt["path"]
    if Path(path).resolve() == repo.main_checkout(root).resolve():
        return fail(f"{branch} is checked out in the main checkout {path}, not a linked worktree")

    # A worktree not on a branch of the ticket must be on the harness's branch, and the ticket may already have a
    # branch (an earlier rescue, or a worker elsewhere): reuse that one, never cut a second. All checked before
    # anything is touched.
    target = None
    if repo.ticket_of_branch(branch) != ticket:
        if not claims.is_harness_branch(branch):
            return fail(f"{path} is on {branch or 'a detached HEAD'}, not a branch of #{ticket} or a worktree-agent-* branch")
        git(root, "fetch", "--quiet", "origin")  # best effort: a stale remote ref only hides a branch a worker pushed
        found = ticket_branches(root, ticket)
        if len(found) > 1:
            return fail(f"#{ticket} has more than one branch, cannot choose: {', '.join(found)}")
        target = found[0] if found else None
        other = next((w["path"] for w in common.worktrees(root) if target and w["branch"] == target
                      and Path(w["path"]).resolve() != Path(path).resolve()), None)
        if other:
            return fail(f"{target} is checked out in another worktree {other}, so {path} can't switch to it")
        if target and git(path, "merge-base", "--is-ancestor", "HEAD", target if has_local(root, target) else f"origin/{target}").code != 0:
            return fail(f"{path} has commits that are not on {target}, so it can't be rescued onto it")
        if target is None:
            slug = re.sub(r"[^a-z0-9]+", "-", (args.title or "").lower()).strip("-")[:40].strip("-") or "rescue"
            target = f"{ticket}-{slug}"
        existing = bool(found)

    code, line = liveness(root, branch, wt)
    if code == 2:
        return fail(line)
    say(line)
    if code == 3:
        return 3

    created = target is not None
    if created:
        # The worker stopped before Orient's branch step: move the worktree's HEAD and changes onto the ticket branch.
        if not existing:
            head = git(path, "rev-parse", "HEAD").stdout.strip()
            sw = git(path, "switch", "-c", target)
            if sw.code == 0:
                CREATED.append((path, branch, target, head))
        elif has_local(root, target):
            sw = git(path, "switch", target)
        else:
            sw = git(path, "switch", "-c", target, "--track", f"origin/{target}")
        if sw.code != 0:
            return fail(f"cannot switch {path} to {target}: {common.one_line(sw.stderr)}")
        say(f"branch: {'reused' if existing else 'created'} {target}")
        branch = target

    base = default_base(root)
    if base is None:
        return fail("cannot find the default branch (no origin/HEAD, main or master)")
    try:
        changed = repo.worktree_changes(path, base)
    except ValueError as e:
        return fail(common.one_line(e))
    say(f"changed {len(changed)} paths")

    # Nothing under .claude/ belongs in a PR (#413): a leaked pr-body.md or agent file is left behind, not staged.
    # A worker's `pr-body.md` at the worktree root (#582) is the same kind of leftover: it is not staged either (#624).
    status = git(path, "status", "--porcelain", "--", ".", ":!.claude", ":(top,exclude)pr-body.md")
    if status.code != 0:
        return fail(f"git status failed in {path}: {common.one_line(status.stderr)}")
    if status.stdout.strip():
        add = git(path, "add", "-A", "--", ".", ":!.claude", ":(top,exclude)pr-body.md")
        msg = f"chore(wip): rescue #{ticket}" if created else f"chore(wip): {args.title}" if args.title else f"chore(wip): #{ticket} work in progress" if ticket is not None \
            else "chore(wip): work in progress"
        c = git(path, "commit", "--no-verify", "-m", msg) if add.code == 0 else add
        if c.code != 0:
            return fail(f"commit failed in {path}: {common.one_line(c.stderr or c.stdout)}")
        k = len(git(path, "show", "--name-only", "--format=", "HEAD").stdout.split())
        say(f"committed {k} paths {git(path, 'rev-parse', '--short', 'HEAD').stdout.strip()}")
    left = git(path, "status", "--porcelain", "--untracked-files=all", "--", ".claude").stdout.splitlines()
    if not status.stdout.strip():
        say("nothing to commit outside .claude/" if left else "committed 0 paths: tree clean")
    if left:
        say(f"left behind (not committed): {len(left)} paths under .claude/: " + ", ".join(x[3:] for x in left))

    n = unpushed(path, branch)
    if n is None:
        return fail(f"cannot list the unpushed commits in {path}")
    has_remote = git(path, "rev-parse", "--verify", "-q", f"origin/{branch}").code == 0
    if n or not has_remote:
        p = git(path, "push", "-u", "origin", branch)
        if p.code != 0:
            return fail(f"push of {branch} failed, worktree kept at {path}: {common.one_line(p.stderr)}")
        say(f"pushed {n} commits")
    else:
        say("pushed 0 commits: up to date")

    tip = git(path, "rev-parse", "HEAD").stdout.strip()
    removed = repo.remove_worktree(path, root)
    if "NOT removed" in removed:
        say(removed)
        return fail(removed)
    say(f"removed {path}")
    LIFTED.clear()  # the worktree is gone: a later failure has no lock to put back
    CREATED.clear()  # ...and no branch to switch back
    if args.pr is not None:
        for line in repo.remove_scratch(args.pr, tip, root):
            say(f"scratch {line}")

    return overlap(root, changed, ticket)


if __name__ == "__main__":
    sys.exit(main())
