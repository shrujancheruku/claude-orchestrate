#!/usr/bin/env python3
"""launch [--greedy[=N] | <ticket>] [--profile] [--bg] [--resume <sessionId> | --resume-latest] [--lead] [--permission-mode MODE] [--print] [--repo PATH] : start the orchestrator.

The one place that knows the orchestrator's launch line; the lead, `/orchestrate:start` and the docs quote this
script (ADR-0006). The flags cannot live in settings: the session-only auto-mode switch exists only as inline
`--settings` JSON, a project `defaultMode` or `model` would leak into the developer's own sessions, and
`--plugin-dir` is needed when the plugin runs from a checkout. The line is built from, in order:
    --resume <sessionId>        only when resuming; --bg follows when given (see the background resume below)
    --name orchestrator --permission-mode <mode> (default acceptEdits)
    --settings '{"disableAutoMode":"disable"[,"crossSessionInbound":"accept"]}'
                                crossSessionInbound is added with --bg or bypassPermissions: without it a
                                background orchestrator holds every message from the lead behind a dialog
    --model <m>                 only when the config's Models table names one in its Orchestrator row
    --plugin-dir <snapshot>     only when the plugin is a checkout (${CLAUDE_PLUGIN_ROOT}, else this script's parent;
                                a root under <claude dir>/plugins/ is a marketplace install and gets no flag). The
                                flag names a snapshot of the plugin at origin/<default> under
                                $XDG_CACHE_HOME (else ~/.cache)/orchestrate/plugin/<sha>/, never the checkout: Claude
                                Code makes every file under an inline plugin's root sensitive, worktrees included
                                (#581). The newest 3 snapshots are kept; one stderr line names the sha. A plugin
                                change reaches a run only through a relaunch or resume via launch.
    "/orchestrate:run --greedy" the prompt: `--greedy=N` or a ticket number is passed through, and `--profile`
                                is appended; none with --resume
Resuming a row whose `kind` is `background` is different (#555): Claude Code keeps a background session's saved options
(plugin dir, model, mode, settings), and any flag passed alongside the resume forks an idle copy instead of continuing it.
So the line is only `claude --resume <id> --bg [<prompt>]`, and --bg is added whether or not it was given. The prompt is
the session's original start prompt: the first user message beginning `/orchestrate:run` in its saved transcript
(<claude dir>/projects/*/<id>.jsonl, read only), else built from the `<ticket>` or `--greedy[=N]` (and `--profile`) given
here; with neither, no prompt is passed and one stderr line names `claude attach <id>` and the `/orchestrate:run` line to type
(a resumed session cannot start that skill itself: it has `disable-model-invocation`). An explicit `--permission-mode` that
is not the row's saved mode (its `permissionMode`, else the transcript's), or whose saved mode cannot be read, exits 2.
An interactive or unknown-kind row keeps the flags above, and takes no prompt.
--resume-latest resumes for the caller: with no live `orchestrator` row, the stopped row of this repo (its `cwd`)
with the newest `startedAt`; a tie or a missing `startedAt` falls back to the row `claude agents --json --all`
lists last. One line on stderr says which sessionId was chosen and why.
--no-model drops --model whatever the config says. --lead builds the lead's line instead: `--name lead`, crossSessionInbound accepted (a lead in a prompting mode
holds every pass table from a bypass orchestrator otherwise), `--model` from the config's Lead row (none when the
row is missing or blank), the plugin flag, prompt "/orchestrate:lead" followed by the same `--greedy[=N]` or ticket
and `--profile`, which the lead passes on to the orchestrator it launches. --lead refuses the rest.
Default runs it in the foreground (the terminal becomes the session); --bg runs `claude --bg` and passes its
output through; --print only prints the command. Exit codes: 0 launched or printed; 2 could not run: a live
session already named `orchestrator` (`lead` for --lead) or, with --resume, one live under that id; `claude agents`
failing or not printing a list; or a bad argument, one line on stderr. Stdlib only, Python 3.9+.
"""

import argparse
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import common  # noqa: E402
import config  # noqa: E402

NAME = "orchestrator"
MODES = ("acceptEdits", "auto", "bypassPermissions", "default", "dontAsk", "plan")
TOKEN = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:-]*")  # a session id or model name: never starts with `-`, so never a flag
DIGITS = re.compile(r"[0-9]+")  # ASCII only: str.isdigit() accepts other scripts
RUN_PROMPT = re.compile(r"/orchestrate:(?:run|lead)(?: [A-Za-z0-9=#._-]+)*")  # a prompt safe inside double quotes
SETTINGS = {"disableAutoMode": "disable"}
INBOUND = {"crossSessionInbound": "accept"}
SNAPSHOT_DIRS = (".claude-plugin", "hooks", "agents", "skills", "scripts")  # what the plugin loads
KEEP = 3  # snapshots kept after a launch, the one in use included
MIN_AGE = 24 * 3600  # a snapshot younger than this is never pruned: a live session may still load it


def plugin_root() -> Path:
    env = os.environ.get("CLAUDE_PLUGIN_ROOT")
    return Path(env) if env else Path(__file__).resolve().parent.parent


def is_marketplace(root: Path) -> bool:
    """A plugin installed from a marketplace lives under <claude dir>/plugins/; anything else is a checkout."""
    plugins = (common.claude_dir() / "plugins").resolve()
    resolved = root.resolve()
    return resolved == plugins or plugins in resolved.parents


def cache_base() -> Path:
    """Where snapshots live: $XDG_CACHE_HOME/orchestrate/plugin, else ~/.cache/orchestrate/plugin."""
    xdg = os.environ.get("XDG_CACHE_HOME")
    return (Path(xdg) if xdg else Path.home() / ".cache") / "orchestrate" / "plugin"


def snapshot(root: Path, fetch: bool = True):
    """(path, sha): the plugin tree at origin/<default>, exported once per sha under the cache and reused after.

    Why not `--plugin-dir <checkout>`: Claude Code treats every file under an inline plugin's root as sensitive,
    and the worktrees sit inside the checkout, so each worker edit prompted (#581). The export lives outside the
    repo (never under ~/.claude either). At most KEEP snapshots stay; older ones are removed.
    """
    git = ["git", "-C", str(root)]
    code, top, _ = common.run(*git, "rev-parse", "--show-toplevel")
    if code != 0:
        common.die(f"launch: cannot run: the plugin root {root} is not a git checkout, so it cannot be snapshotted "
                   "(a marketplace install needs no snapshot)")
    code, head, _ = common.run(*git, "symbolic-ref", "--short", "refs/remotes/origin/HEAD")
    ref = head.strip() if code == 0 and head.strip().startswith("origin/") else "origin/main"
    if fetch:
        common.run(*git, "fetch", "--quiet", "origin", ref[len("origin/"):])  # best effort: offline keeps the last fetch
    code, sha, err = common.run(*git, "rev-parse", "--verify", "--quiet", ref + "^{commit}")
    sha = sha.strip()
    if code != 0 or not re.fullmatch(r"[0-9a-f]{40}", sha):
        common.die(f"launch: cannot run: {ref} does not exist in {top.strip()}; fetch origin first")
    base = cache_base()
    dest = base / sha
    inside = [Path(top.strip()).resolve(), common.claude_dir().resolve()]
    if any(p == base.resolve() or p in base.resolve().parents for p in inside):
        common.die(f"launch: cannot run: the snapshot cache {base} is inside the repo or the claude dir; set XDG_CACHE_HOME")
    if dest.is_dir():
        os.utime(dest)  # newest use wins the pruning
    else:
        base.mkdir(parents=True, exist_ok=True)
        tmp = Path(tempfile.mkdtemp(prefix=".tmp-", dir=base))
        try:
            proc = subprocess.Popen([*git, "archive", sha, *SNAPSHOT_DIRS], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            with tarfile.open(fileobj=proc.stdout, mode="r|") as tar:
                tar.extractall(tmp, **({"filter": "data"} if hasattr(tarfile, "data_filter") else {}))
            if proc.wait() != 0:
                common.die(f"launch: cannot run: git archive of {sha} failed: {proc.stderr.read().decode(errors='replace').strip()}")
            try:
                tmp.rename(dest)
            except OSError:
                if not dest.is_dir():  # a concurrent launch winning the rename is fine
                    raise
        finally:
            shutil.rmtree(tmp, ignore_errors=True)
    if not fetch:  # --print launches nothing, so it prunes nothing
        return dest, sha
    # A snapshot used within MIN_AGE seconds may belong to a running orchestrator or lead: never prune it.
    old = sorted((p for p in base.iterdir() if p.is_dir() and re.fullmatch(r"[0-9a-f]{40}", p.name) and p != dest),
                 key=lambda p: p.stat().st_mtime, reverse=True)
    for p in old[KEEP - 1:]:
        if time.time() - p.stat().st_mtime > MIN_AGE:
            shutil.rmtree(p, ignore_errors=True)
    return dest, sha


def build(args, plugin_dir, model, start=None) -> list:
    """The argv of the launch, `claude` first, from parsed arguments, the plugin snapshot (None: none) and the Orchestrator model.

    `start` is set only for a background resume (args.bg_resume): the line is then the resume alone, plus the start prompt if any.
    """
    argv = ["claude"]
    if getattr(args, "bg_resume", False):
        return argv + ["--resume", args.resume, "--bg"] + ([start] if start else [])
    if args.lead:
        argv += ["--name", "lead", "--settings", json.dumps(INBOUND, separators=(",", ":"))]
        if args.permission_mode:
            argv += ["--permission-mode", args.permission_mode]
        if model:
            argv += ["--model", model]
        if plugin_dir:
            argv += ["--plugin-dir", str(plugin_dir)]
        return argv + [prompt(args, "/orchestrate:lead")]
    if args.resume:
        argv += ["--resume", args.resume]
    if args.bg:
        argv.append("--bg")
    settings = dict(SETTINGS)
    mode = args.permission_mode or "acceptEdits"
    if args.bg or mode == "bypassPermissions":
        settings.update(INBOUND)
    argv += ["--name", NAME, "--permission-mode", mode,
             "--settings", json.dumps(settings, separators=(",", ":"))]
    if model:
        argv += ["--model", model]
    if plugin_dir:
        argv += ["--plugin-dir", str(plugin_dir)]
    if not args.resume:
        argv.append(prompt(args))
    return argv


def prompt(args, command="/orchestrate:run") -> str:
    """The skill call: a ticket or `--greedy[=N]` (the lead's line takes both only as a pass-through), then `--profile`."""
    if args.ticket:
        text = f"{command} {args.ticket}"
    elif command == "/orchestrate:lead" and args.greedy is None:
        text = command  # the lead alone: no flags to pass on
    else:
        text = f"{command} --greedy" + (f"={args.greedy}" if args.greedy else "")
    return text + (" --profile" if args.profile else "")


def render(argv: list) -> str:
    """The command as a shell line: the settings JSON in single quotes, the prompt in double quotes."""
    parts = []
    for i, a in enumerate(argv):
        if i == len(argv) - 1 and RUN_PROMPT.fullmatch(a):
            parts.append(f'"{a}"')
        else:
            parts.append(shlex.quote(a))
    return " ".join(parts)


def live_sessions() -> list:
    """The rows of `claude agents --json` that are live (a pid), as dicts; [] when `claude` is not installed.

    Fails closed: a nonzero exit, output that is not JSON or JSON that is not a list means we cannot tell whether
    an orchestrator is already live, which is exit 2 with one line.
    """
    if not shutil.which("claude"):
        return []  # the launch itself then fails with its own line
    code, out, _ = common.run("claude", "agents", "--json")
    if code != 0:
        common.die(f"launch: cannot run: `claude agents --json` failed (exit {code}); cannot tell whether a session is live")
    try:
        rows = json.loads(out)
    except ValueError:
        rows = None
    if not isinstance(rows, list):
        common.die("launch: cannot run: `claude agents --json` did not print a list; cannot tell whether a session is live")
    return [r for r in rows if isinstance(r, dict) and r.get("pid") is not None]


def agent_rows(everything=False) -> list:
    """The rows of `claude agents --json [--all]` as dicts, failing closed as live_sessions does."""
    if not shutil.which("claude"):
        return []
    code, out, _ = common.run("claude", "agents", "--json", *(["--all"] if everything else []))
    if code != 0:
        common.die(f"launch: cannot run: `claude agents --json` failed (exit {code}); cannot tell which session to resume")
    try:
        rows = json.loads(out)
    except ValueError:
        rows = None
    if not isinstance(rows, list):
        common.die("launch: cannot run: `claude agents --json` did not print a list; cannot tell which session to resume")
    return [r for r in rows if isinstance(r, dict)]


def started_at(row):
    """A row's `startedAt` as epoch seconds (a number, or an ISO-8601 string), or None when missing or unreadable."""
    value = row.get("startedAt")
    if isinstance(value, bool):
        return None
    if isinstance(value, (int, float)):
        return float(value) / 1000 if value > 1e11 else float(value)  # milliseconds or seconds
    if isinstance(value, str):
        try:
            when = datetime.fromisoformat(value.strip().replace("Z", "+00:00"))
        except ValueError:
            return None
        return (when if when.tzinfo else when.replace(tzinfo=timezone.utc)).timestamp()
    return None


def latest_stopped(rows: list, repo: Path):
    """(row, why) for the stopped `orchestrator` row of `repo` to resume, or (None, why not).

    Rows from other repos (a different `cwd`) are ignored. Among the rest the newest `startedAt` wins; a tie, or any
    row without a readable `startedAt`, falls back to the one listed last. A live orchestrator row means nothing is resumed.
    """
    named = [r for r in rows if r.get("name") == NAME]
    live = [r for r in named if r.get("pid") is not None]
    if live:
        return None, f"a live session named {NAME} already exists ({live[0].get('sessionId')}); message it instead of resuming another"
    here = repo.resolve()
    mine = [r for r in named if isinstance(r.get("cwd"), str) and Path(r["cwd"]).resolve() == here]
    if not mine:
        return None, f"no stopped {NAME} session of this repo to resume"
    dated = [r for r in mine if started_at(r) is not None]
    if len(dated) < len(mine):  # a missing startedAt makes the order unknowable: the row listed last
        return mine[-1], f"a stopped {NAME} row of this repo has no startedAt, so the one listed last of {len(mine)}"
    newest = max(started_at(r) for r in dated)
    tied = [r for r in dated if started_at(r) == newest]
    why = "newest startedAt" if len(tied) == 1 else "tied on startedAt, so the one listed last"
    return tied[-1], f"{why} of {len(mine)} stopped {NAME} rows of this repo"


def row_of(session_id):
    """The `claude agents --json --all` row of a session id, or None: best effort, any failure means an unknown kind."""
    if not shutil.which("claude"):
        return None
    code, out, _ = common.run("claude", "agents", "--json", "--all")
    try:
        rows = json.loads(out) if code == 0 else None
    except ValueError:
        rows = None
    for r in rows if isinstance(rows, list) else []:
        if isinstance(r, dict) and r.get("sessionId") == session_id:
            return r
    return None


def user_text(rec) -> str:
    """The text a user record carries: a string or its text blocks joined; a slash command's `<command-name>` form rebuilt."""
    msg = rec.get("message")
    content = msg.get("content") if isinstance(msg, dict) else None
    if isinstance(content, list):
        content = "\n".join(b.get("text", "") for b in content if isinstance(b, dict) and isinstance(b.get("text"), str))
    if not isinstance(content, str):
        return ""
    name = re.search(r"<command-name>\s*(/?[^<\s]+)\s*</command-name>", content)
    if name:
        args = re.search(r"<command-args>(.*?)</command-args>", content, re.S)
        cmd = name.group(1) if name.group(1).startswith("/") else "/" + name.group(1)
        return (cmd + " " + args.group(1).strip()).strip() if args else cmd
    return content.strip()


def saved_transcript(session_id):
    """(start prompt, permission mode) from a session's saved transcript; each None when absent or unreadable.

    The prompt is the first user message that is an `/orchestrate:run` call on one line (anything else is not trusted
    into an argv); the mode is the last `permissionMode` the transcript records. The file is only read.
    """
    prompt_, mode = None, None
    try:
        path = common.find_transcript(session_id)
        for rec in common.read_jsonl(path) if path else ():
            if isinstance(rec.get("permissionMode"), str):
                mode = rec["permissionMode"]
            if prompt_ is None and rec.get("type") == "user":
                text = user_text(rec)
                if text.startswith("/orchestrate:run") and RUN_PROMPT.fullmatch(text):
                    prompt_ = text
    except OSError:
        pass
    return prompt_, mode


def parse(argv):
    ap = argparse.ArgumentParser(prog="launch", description=__doc__.split("\n")[0])
    ap.add_argument("ticket", nargs="?", help="a ticket number: run narrows to it")
    ap.add_argument("--greedy", nargs="?", const="", default=None, metavar="N", help="greedy mode, as --greedy=N")
    ap.add_argument("--profile", action="store_true", help="the run also records itself and saves a profile")
    ap.add_argument("--bg", action="store_true", help="run as a background session")
    ap.add_argument("--resume", metavar="SESSION_ID",
                    help="resume that session: a background one with only --bg and its start prompt, any other with the same flags and no prompt")
    ap.add_argument("--resume-latest", action="store_true",
                    help="--resume the stopped orchestrator row of this repo with the newest startedAt")
    ap.add_argument("--lead", action="store_true", help="the lead's line instead of the orchestrator's")
    ap.add_argument("--permission-mode", choices=MODES, help="the session's mode (orchestrator default acceptEdits)")
    ap.add_argument("--no-model", action="store_true", help="omit --model (the lead's one relaunch after model_not_found)")
    ap.add_argument("--print", action="store_true", help="print the command, run nothing")
    ap.add_argument("--repo", default=".", help="the repo whose config names the model (default .)")
    args = ap.parse_args(argv)
    if args.ticket is not None:
        args.ticket = args.ticket.lstrip("#")
        if not DIGITS.fullmatch(args.ticket):
            common.die(f"launch: cannot run: {args.ticket!r} is not a ticket number")
    if args.greedy and not DIGITS.fullmatch(args.greedy):
        common.die(f"launch: cannot run: --greedy={args.greedy} is not a number")
    if args.ticket and args.greedy is not None:
        common.die("launch: cannot run: give --greedy or a ticket, not both")
    if args.resume is not None and not TOKEN.fullmatch(args.resume):
        common.die(f"launch: cannot run: {args.resume!r} is not a session id")
    if args.resume and args.resume_latest:
        common.die("launch: cannot run: give --resume <sessionId> or --resume-latest, not both")
    if args.lead and (args.bg or args.resume or args.resume_latest or args.no_model):
        common.die("launch: cannot run: --lead takes only --greedy[=N] or a ticket, --profile, --permission-mode and --print")
    return args


def main(argv=None) -> int:
    args = parse(argv)
    model = None
    if not args.no_model:
        cfg = config.Config.load(args.repo)
        model, role = (cfg.lead_model, "Lead") if args.lead else (cfg.orchestrator_model, "Orchestrator")
        if model is not None and not TOKEN.fullmatch(model):
            common.die(f"launch: cannot run: the config's {role} model {model!r} is not a model name")
    row = None
    if args.resume_latest:
        row, why = latest_stopped(agent_rows(everything=True), Path(args.repo))
        if row is None:
            common.die(f"launch: cannot run: {why}")
        args.resume = row.get("sessionId")
        if not isinstance(args.resume, str) or not TOKEN.fullmatch(args.resume):
            common.die(f"launch: cannot run: the chosen {NAME} row has no usable sessionId")
        print(f"launch: resuming {args.resume}: {why}", file=sys.stderr)
    start = None
    if args.resume and not args.lead:
        row = row or row_of(args.resume)
        tokens = args.ticket or args.greedy is not None
        if row is not None and row.get("kind") == "background":
            args.bg_resume, args.bg = True, True
            saved_prompt, saved_mode = saved_transcript(args.resume)
            saved_mode = row.get("permissionMode") if isinstance(row.get("permissionMode"), str) else saved_mode
            if args.permission_mode and args.permission_mode != saved_mode:
                common.die(f"launch: cannot run: a background session keeps its saved options (mode "
                           f"{saved_mode or 'unreadable'}), so --permission-mode {args.permission_mode} cannot apply; "
                           f"start a fresh orchestrator without --resume to change it")
            start = saved_prompt or (prompt(args) if tokens else None)
            if start is None:
                print(f"launch: {args.resume} has no saved start prompt and none was given; once it is resumed run "
                      f"`claude attach {args.resume}` and type: /orchestrate:run --greedy{' --profile' if args.profile else ''}", file=sys.stderr)
        elif tokens or args.profile:
            common.die("launch: cannot run: --resume takes no prompt for a session that is not a background one")
    root = plugin_root()
    if not args.print:  # refuse before exporting a snapshot a refused launch would not use
        live = live_sessions()
        name = "lead" if args.lead else NAME
        clash = [r for r in live if r.get("name") == name or (args.resume and r.get("sessionId") == args.resume)]
        if clash:
            common.die(f"launch: cannot run: a live session named {clash[0].get('name')} already exists "
                       f"({clash[0].get('sessionId')}); message it instead of starting another")
        if not shutil.which("claude"):
            common.die("launch: cannot run: `claude` is not on PATH")
    plugin_dir = None
    if not is_marketplace(root) and not getattr(args, "bg_resume", False):  # a background resume names no plugin dir
        plugin_dir, sha = snapshot(root, fetch=not args.print)
        print(f"launch: plugin snapshot {sha[:12]} at {plugin_dir}", file=sys.stderr)
    cmd = build(args, plugin_dir, model, start)
    if args.print:
        print(render(cmd))
        return 0
    if args.bg:
        code, out, err = common.run(*cmd)
        sys.stdout.write(out)
        sys.stderr.write(err)
        return code
    os.execvp(cmd[0], cmd)


if __name__ == "__main__":
    sys.exit(main())
