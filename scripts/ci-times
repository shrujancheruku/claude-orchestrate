#!/usr/bin/env python3
"""ci-times [--since <time or PR>] : is CI wait over the limit, and is it too few runners or a slow job?

Reads merged PRs only (`gh`). Each PR's commits that have check runs are its heads; a head's push-to-green
runs from the commit's committed time (the closest push time `gh` gives per commit) to its last check
completing, and only when every check passed. Heads that never went green are left out, and a fix push
counts as its own head. Output, one item per line:
    heads: <n> green over <m> PRs (<k> never green)
    median: <t>
    p90: <t>
    slowest checks (queued / running):  then up to 3 lines, by median total
    limit: <minutes>m (default|config)
    ci done -> merged: median <t> over <n> PRs     the gap from a PR's last green head to its merge
    wait: over|ok                                   over when that median exceeds 2 minutes (a trend to watch: includes review and gate time)
    cause: <runners|slow job> (<check>)     only when over
    over: yes|no
Default window: the last 10 merged PRs; --since <ISO time | PR number> takes every merged PR since instead.
Default limit: p90 over 10 minutes; the config's optional `- **CI wait limit:** <minutes>` overrides it.
Exit codes: 0 reported (also when no head went green: `over: no`); 2 could not run (no `gh`, no repository,
an unreadable --since), one line on stderr.
Stdlib only, Python 3.9+.
"""

import argparse
import math
from datetime import timedelta
import statistics
import sys

import common
import config
import github
from repo import main_checkout, parse_ts

DEFAULT_PR_COUNT = 10
DEFAULT_LIMIT_MINUTES = 10
SLOWEST = 3
WAIT_LIMIT_MINUTES = 2  # a median gap from CI done to merged above this is flagged `wait: over`: a trend to watch, since the gap also holds review, approval and merge-gate time
LIST_LIMIT = 100  # merged PRs fetched; --since beyond the newest 100 is cut off
# Not paginated: `check-runs?per_page=100` stops at 100, so a head with more check runs than that could read as
# green from a partial list. (The PR's commits are paged by github.pr_commits.)
GOOD = {"SUCCESS", "NEUTRAL", "SKIPPED"}


def p90(values):
    """Nearest-rank 90th percentile."""
    v = sorted(values)
    return v[math.ceil(0.9 * len(v)) - 1]


def fmt(seconds):
    m, s = divmod(int(round(seconds)), 60)
    return f"{m}m{s:02d}s"


def head_times(pushed, runs):
    """(push-to-green seconds, [(name, queued, running)]) for one head, or None when it never went green."""
    checks, last = [], pushed
    for r in runs:
        start, end = parse_ts(r.get("started_at")), parse_ts(r.get("completed_at"))
        if r.get("status") != "completed" or str(r.get("conclusion", "")).upper() not in GOOD or not (start and end):
            return None
        checks.append((r.get("name", "?"), max((start - pushed).total_seconds(), 0), (end - start).total_seconds()))
        last = max(last, end)
    return (last - pushed).total_seconds(), checks


def merged_prs(since_arg, root):
    prs = github.merged_prs(None, cwd=root, limit=LIST_LIMIT)
    prs = [p for p in prs if parse_ts(p.get("mergedAt"))]
    prs.sort(key=lambda p: parse_ts(p["mergedAt"]), reverse=True)
    if since_arg is None:
        return prs[:DEFAULT_PR_COUNT]
    if str(since_arg).lstrip("#").isdigit():
        n = common.pr_ref(since_arg)[1]
        # The listing already holds the PR's merge time; look the PR up only when it is older than the listing.
        listed = next((p for p in prs if str(p["number"]) == str(n)), None)
        cut = parse_ts(listed["mergedAt"]) if listed else parse_ts(github.pr_view(n, "mergedAt", cwd=root).get("mergedAt"))
        if cut is None:
            common.die(f"ci-times: PR #{n} is not merged")
        return [p for p in prs if parse_ts(p["mergedAt"]) > cut]
    cut = parse_ts(since_arg)
    if cut is None:
        common.die(f"ci-times: --since is not a time or a PR number: {since_arg}")
    return [p for p in prs if parse_ts(p["mergedAt"]) >= cut]


def measure(prs, root):
    """(push-to-green list, per-check {name: [(queued, running)]}, heads never green, ci-done-to-merged list) over the PRs.

    The last list has one entry per PR with a green head: seconds from that head's checks finishing to the merge."""
    greens, per_check, never, waits = [], {}, 0, []
    fetched = {}  # oid -> check runs: a commit shared by stacked PRs is fetched once, and still counts per PR
    for pr in prs:
        commits = github.pr_commits(pr["number"], cwd=root)
        done = None  # when the PR's last green head finished its checks
        for c in commits:
            pushed = parse_ts(c.get("committedDate"))
            if pushed is None:
                continue  # no push time: not a pushed head, and no call needed to know it
            if c["oid"] not in fetched:
                data = github.call_json("api", f"repos/{{owner}}/{{repo}}/commits/{c['oid']}/check-runs?per_page=100",
                                        cwd=root)
                fetched[c["oid"]] = data.get("check_runs") or []
            runs = fetched[c["oid"]]
            if not runs:
                continue  # not a pushed head: nothing ran on it
            got = head_times(pushed, runs)
            if got is None:
                never += 1
                continue
            greens.append(got[0])
            finished = pushed + timedelta(seconds=got[0])
            done = finished if done is None else max(done, finished)
            for name, queued, running in got[1]:
                per_check.setdefault(name, []).append((queued, running))
        merged = parse_ts(pr.get("mergedAt"))
        if done is not None and merged is not None:
            waits.append(max((merged - done).total_seconds(), 0))
    return greens, per_check, never, waits


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0], allow_abbrev=False)
    ap.add_argument("--since", help="an ISO time, or a PR number (merged after that PR)")
    args = ap.parse_args(argv)
    code, _, _ = common.run("git", "rev-parse", "--show-toplevel")
    if code != 0:
        common.die("ci-times: cannot run: not inside a git repository")
    root = main_checkout(".").resolve()
    cfg = config.for_checkout(root)
    limit, source = (cfg.ci_wait_limit, "config") if cfg.ci_wait_limit else (DEFAULT_LIMIT_MINUTES, "default")
    try:
        prs = merged_prs(args.since, root)
        greens, per_check, never, waits = measure(prs, root)
    except github.GhError as e:
        common.die(f"ci-times: cannot run: gh failed: {e.message}")
    print(f"heads: {len(greens)} green over {len(prs)} PRs ({never} never green)")
    if not greens:
        print(f"limit: {limit}m ({source})")
        print("over: no")
        return 0
    stats = []
    for name, rows in per_check.items():
        q = statistics.median(r[0] for r in rows)
        run = statistics.median(r[1] for r in rows)
        stats.append((q + run, name, q, run))
    stats.sort(reverse=True)
    top90 = p90(greens)
    over = top90 > limit * 60
    print(f"median: {fmt(statistics.median(greens))}")
    print(f"p90: {fmt(top90)}")
    print("slowest checks (queued / running):")
    for _, name, q, run in stats[:SLOWEST]:
        print(f"  {name}: {fmt(q)} / {fmt(run)}")
    print(f"limit: {limit}m ({source})")
    # The gap from CI done to merged includes review, approval and merge-gate time, so a median over WAIT_LIMIT_MINUTES
    # is a trend to watch, not proof of a sleep or hand-polled wait instead of a `watch-ci` Monitor (#542); the
    # push-to-green times above never show it.
    wait = statistics.median(waits)
    print(f"ci done -> merged: median {fmt(wait)} over {len(waits)} PRs")
    print(f"wait: {'over' if wait > WAIT_LIMIT_MINUTES * 60 else 'ok'}")
    if over:
        _, name, q, run = stats[0]
        print(f"cause: {'runners' if q > run else 'slow job'} ({name})")
    print(f"over: {'yes' if over else 'no'}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
