#!/usr/bin/env python3
"""rebuild-state [<session id | transcript.jsonl>] [--repo PATH] : rebuild .claude/orchestrate-state.json.

The orchestrator never writes the state file; this does, from the session's transcripts, so it
can't drift from what actually ran. A worker is joined to its ticket by its dispatch
description, whose first `#<n>` must be its ticket (the run skill recommends `Build #<ticket>`); a
dispatch of any other agent type, or without a `#<n>`, is ignored. Per ticket
it records the worker's agent ID, the worktree, the worker model (from the agent's own transcript,
else the dispatch, else its metadata), the time of its last record (the last report) and the touch
map its brief names. The worktree is the first of these that exists: the path the harness reported
in the worker's completion, the harness's `.claude/worktrees/agent-<id>`, the worktree `git worktree
list` shows for the brief's branch; else null. When a ticket was dispatched more than once, the latest wins.

The file is a cache and the tracker wins. Exit codes: 0 rebuilt; 2 could not run (no session id,
no transcript). Stdlib only, Python 3.9+.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

import common
import session
import touchmap
from repo import STATE, main_checkout


def find_transcript(arg: str) -> Path:
    found = common.find_transcript(arg)
    if not found:
        common.die(f"rebuild-state: no transcript for session {arg} under {common.claude_dir() / 'projects'}")
    return found


def model_of(records, dispatch_model, meta_model):
    for r in records:
        msg = r.get("message")
        if isinstance(msg, dict) and msg.get("model"):
            return msg["model"]
    return dispatch_model or meta_model


def worktree_of(agent_id: str, branch, repo: Path, completions: dict) -> str | None:
    """Where the worker's worktree is, or None once it is gone. Each source must exist to count.

    The harness's completion names the path it used; the `.claude/worktrees/agent-<id>` path is where the
    harness puts it; the ticket's branch covers a worktree the worker was resumed in under another name.
    """
    for path in (completions.get(agent_id), repo / ".claude" / "worktrees" / f"agent-{agent_id}"):
        if path and Path(path).is_dir():
            return str(Path(path))
    found = next((w["path"] for w in common.worktrees(repo) if w["branch"] == branch), None) if branch else None
    return found if found and Path(found).is_dir() else None


def touch_map_of(agent: dict) -> str:
    """The brief's touch map in canonical form (touchmap.format). One that doesn't parse is reported on one line and
    stored as `unparsed:<raw line>`, never `none`: `holds` reads it as holding every path until the state is fixed."""
    try:
        return touchmap.format(session.touch_map(agent["prompt"]))
    except touchmap.TouchMapError as e:
        print(common.one_line(f"#{agent['ticket']} touch map not read, held as every path: {e}"))
        return touchmap.UNPARSED + " ".join(session.touch_map_text(agent["prompt"]).split())


def rebuild(main_path: Path, repo: Path) -> dict:
    main = session.Transcript(main_path)
    sid = next((r["sessionId"] for r in main.records if r.get("sessionId")), main_path.stem)
    completions = main.completions()
    tickets = {}
    for a in session.agents(main):
        if a["role"] != "worker" or a["ticket"] is None or not a["id"]:
            continue  # not a worker, no #<n> in the description, or no agent to join it to
        records = a["transcript"].records if a["transcript"] else []
        # A later dispatch for the same ticket replaces the earlier.
        tickets[a["ticket"]] = {
            "agent_id": a["id"],
            "worktree": worktree_of(a["id"], session.branch_of(a["prompt"]), repo, completions),
            "model": model_of(records, a["dispatch_model"], a["meta_model"]),
            "last_report": session.iso(a["last_record"]),
            "touch_map": touch_map_of(a),
        }
    return {"session": sid, "tickets": {str(n): tickets[n] for n in sorted(tickets)}}


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("session", nargs="?", default=os.environ.get("CLAUDE_SESSION_ID"),
                    help="session id or transcript path (default: $CLAUDE_SESSION_ID)")
    ap.add_argument("--repo", default=".", help="repo root; the state file goes in its main checkout")
    args = ap.parse_args(argv)
    if not args.session:
        common.die("rebuild-state: no session id (pass one or set CLAUDE_SESSION_ID)")
    repo = Path(args.repo).resolve()
    state = rebuild(find_transcript(args.session), repo)
    out = main_checkout(repo) / STATE  # the main checkout's: runlog reads the session from there (#341)
    out.parent.mkdir(parents=True, exist_ok=True)
    tmp = out.with_name(out.name + ".tmp")
    tmp.write_text(json.dumps(state, indent=2) + "\n")
    os.replace(tmp, out)  # whole file or nothing, never a half-written cache
    for n, t in state["tickets"].items():
        print(common.one_line(f"#{n} {t['agent_id']} {t['model']} {t['worktree']} last report {t['last_report']}"))
    print(f"rebuilt {STATE} ({len(state['tickets'])} tickets)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
