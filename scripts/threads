#!/usr/bin/env python3
"""threads [<pr>] [--all] | resolve <thread>... (--fixed <sha> | --left <why> (--followup <issue> | --no-followup)) | reopen <thread>... --why <why> [--verbose] [--repo DIR]

The one place a review thread is read, closed or reopened (ADR-0006; the rule "a review thread is closed with a reply by
whoever acts on it" lives here, not in the prompts).

    threads <pr> [--all]    one line per unresolved review thread:
                              <thread id> <author> <path>:<line | file> [outdated] <first line of the first comment>
                            --all adds resolved threads (marked `resolved`), each followed by its closing reply
                            (the `fixed in` / `left:` / `reopened:` comment, indented). Nothing printed when none.
    threads <pr> resolve <thread>... --fixed <sha>   replies `fixed in <sha>`, then resolves; <sha> must be a commit
                                                     on the PR's branch at the remote
    threads <pr> resolve <thread>... --left <why> --followup <issue>
                                                     replies `left: <why> (follow-up #<issue>)`, then resolves
    threads <pr> resolve <thread>... --left <why> --no-followup
                                                     replies `left: <why> (no follow-up)`, then resolves
                            A left thread names the ticket that carries it, or says outright that none does (#442):
                            `--left` refuses with neither flag, so a minor left behind is never lost unrecorded.
    threads <pr> reopen <thread>... --why <why>      replies `reopened: <why>`, then unresolves

A thread whose first comment is from an untrusted author (ADR-0015: not OWNER, MEMBER or COLLABORATOR, and not on the
config's `Trusted authors:` line) is listed as `<id> <author> <path>:<line> untrusted (text withheld)`, and `resolve` and
`reopen` refuse it: a worker never reads or acts on it, and the developer resolves it. `merge` still counts it.

Leave <pr> out and the PR is the one of the checked-out branch (one pulls lookup by head branch): `threads`,
`threads resolve <thread>... --fixed <sha>`. That is the worker's form, so the guard can allow it without knowing which
PR it names; the orchestrator, the reviewer and the lead give the number.

Several thread ids go in one call: every id is checked first (one bad id changes nothing), then the replies go in one
GraphQL request (one aliased reply mutation per thread) and the resolves or unresolves in a second (one aliased
mutation per thread), however many threads. A thread whose last comment already is the reply is not replied to again.
`--verbose` prints `writes: <n>` on stderr: the mutation requests sent.
Each resolve and reopen appends a `threads` event per thread to the run log (outcome resolved | reopened, plus thread
and author).
Exit codes: 0 done; 1 nothing changed (a thread id the PR doesn't have, a resolve of a resolved thread, a reopen of an
open one, a --fixed sha not on the branch: one line on stderr); 2 could not run (`gh` failed, or a bad command line;
run it again). Stdlib only, Python 3.9+.
"""

from __future__ import annotations

import argparse
import sys

import common
import github
import runlog

# Each mutation is one field; a single thread wraps it in a mutation, several get an alias each (see batched).
REPLY_FIELD = ("addPullRequestReviewThreadReply(input: {pullRequestReviewThreadId: $id, body: $body}) "
               "{ comment { id } }")
RESOLVE_FIELD = "resolveReviewThread(input: {threadId: $id}) { thread { id } }"
UNRESOLVE_FIELD = "unresolveReviewThread(input: {threadId: $id}) { thread { id } }"
REPLY = "mutation($id: ID!, $body: String!) { " + REPLY_FIELD + " }"
RESOLVE_THREAD = "mutation($id: ID!) { " + RESOLVE_FIELD + " }"
UNRESOLVE_THREAD = "mutation($id: ID!) { " + UNRESOLVE_FIELD + " }"
REPLIES = ("fixed in ", "left:", "reopened:")
MIN_SHA = 7


def first_line(text: str) -> str:
    return next((l.strip() for l in text.splitlines() if l.strip()), "")


def listing(threads, show_all) -> list:
    lines = []
    for t in threads:
        if t["resolved"] and not show_all:
            continue
        first = t["comments"][0] if t["comments"] else {"author": "ghost", "body": ""}
        if not t.get("trusted", True):
            # ADR-0015: an untrusted author's text never reaches a worker; the developer resolves the thread.
            lines.append(f"{t['id']} {first['author']} {t['path']}:{t['line'] if t['line'] else 'file'} untrusted"
                         + (" resolved" if t["resolved"] else "") + " (text withheld)")
            continue
        where = f"{t['path']}:{t['line'] if t['line'] else 'file'}"
        head = [t["id"], first["author"], where] + (["outdated"] if t["outdated"] else []) + (["resolved"] if t["resolved"] else [])
        lines.append(" ".join(head + [first_line(first["body"])]).rstrip())
        # A resolved thread shows its closing reply; an open one shows a trailing `reopened:` (what is still wrong).
        last = t["comments"][-1] if len(t["comments"]) > 1 else None
        if last and first_line(last["body"]).startswith(REPLIES if t["resolved"] else ("reopened:",)):
            lines.append("  " + first_line(last["body"]))
    return lines


def refuse(msg) -> int:
    print(f"threads: {msg}", file=sys.stderr)
    return 1


def graphql(query, cwd, **variables):
    args = ["api", "graphql", "-f", f"query={query}"]
    for k, v in variables.items():
        args += ["-f", f"{k}={v}"]
    github.call(*args, cwd=cwd)


def batched(field, ids, cwd, bodies=None) -> None:
    """One GraphQL request applying the mutation `field` to every id: an alias (`m0`, `m1`, ...) per thread, so the
    rate limit sees one write however many threads. bodies: the reply text per id (the reply mutation); None for
    resolve and unresolve. One id sends the plain single-mutation text."""
    if len(ids) == 1:
        graphql("mutation($id: ID!" + (", $body: String!" if bodies else "") + ") { " + field + " }", cwd,
                id=ids[0], **({"body": bodies[0]} if bodies else {}))
        return
    decls, calls, variables = [], [], {}
    for i, tid in enumerate(ids):
        decls.append(f"$id{i}: ID!" + (f", $body{i}: String!" if bodies else ""))
        calls.append(f"m{i}: " + field.replace("$id", f"$id{i}").replace("$body", f"$body{i}"))
        variables[f"id{i}"] = tid
        if bodies:
            variables[f"body{i}"] = bodies[i]
    graphql("mutation(" + ", ".join(decls) + ") { " + " ".join(calls) + " }", cwd, **variables)


def on_branch(sha, shas) -> bool:
    return len(sha) >= MIN_SHA and any(s.startswith(sha.lower()) for s in shas)


def main(argv=None) -> int:
    # No abbreviations: the guard approves a worker's call by the flags' full names, so `--rep` must not mean `--repo`.
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0], allow_abbrev=False)
    ap.add_argument("words", nargs="*", metavar="[pr] [resolve|reopen] [thread]...",
                    help="the PR number (left out: the PR of the checked-out branch), then resolve or reopen and the thread ids")
    ap.add_argument("--all", action="store_true", help="list resolved threads too, with their closing reply")
    ap.add_argument("--fixed", metavar="SHA", help="resolve: the pushed commit that fixed it")
    ap.add_argument("--left", metavar="WHY", help="resolve: why a minor was left")
    ap.add_argument("--followup", metavar="ISSUE", help="resolve --left: the follow-up ticket that carries the left thread")
    ap.add_argument("--no-followup", action="store_true", help="resolve --left: no ticket carries it (recorded in the reply)")
    ap.add_argument("--why", metavar="WHY", help="reopen: what is still wrong")
    ap.add_argument("--verbose", action="store_true", help="print `writes: <n>` (mutation requests sent) on stderr")
    ap.add_argument("--repo", default=".", help="a directory of the repository (default: the current one)")
    args = ap.parse_args(argv)
    words = list(args.words)
    pr = words.pop(0).lstrip("#") if words and words[0].lstrip("#").isdigit() else None
    args.action = words.pop(0) if words and words[0] in ("resolve", "reopen") else None
    args.thread = words if args.action else []
    if words and not args.action:
        ap.error("the first word must be a PR number, `resolve` or `reopen`")
    if args.action:
        if not args.thread:
            ap.error(f"{args.action} needs a thread id")
        if args.all:
            ap.error("--all lists; it takes no action")
        if args.action == "resolve" and (args.fixed is None) == (args.left is None):
            ap.error("resolve needs exactly one of --fixed <sha> and --left <why>")
        if args.action == "resolve" and args.left is not None:
            if (args.followup is None) == (not args.no_followup):
                ap.error("--left needs exactly one of --followup <issue> and --no-followup")
            if args.followup is not None and not (args.followup.lstrip("#").isascii() and args.followup.lstrip("#").isdigit()):
                ap.error("--followup needs an issue number")
        elif args.followup is not None or args.no_followup:
            ap.error("--followup and --no-followup go with resolve --left")
        if args.action == "reopen" and not args.why:
            ap.error("reopen needs --why <why>")
        if args.action == "resolve" and not (args.fixed or args.left):
            ap.error("--fixed and --left need a value")
    elif args.thread or args.fixed or args.left or args.why or args.followup is not None or args.no_followup:
        ap.error("--fixed, --left, --followup, --no-followup, --why and a thread id go with resolve or reopen")

    cwd = args.repo
    sent = 0
    try:
        if pr is None:
            # The current-branch form (a worker's): the PR for the checked-out branch (the open one, else the newest
            # closed or merged one, else a fork's PR with this head commit).
            pr = github.current_pr_number(cwd)
            if not pr.isdigit():
                common.die("threads: could not read the current branch's PR number from gh")
        pr, ref = common.pr_ref(pr)
        threads = github.review_threads(pr, cwd=cwd)
        if not args.action:
            for line in listing(threads, args.all):
                print(line)
            return 0
        by_id = {t["id"]: t for t in threads}
        chosen = []
        for tid in dict.fromkeys(args.thread):  # a repeated id is one thread
            thread = by_id.get(tid)
            if thread is None:
                return refuse(f"PR #{pr} has no review thread {tid}")
            if not thread.get("trusted", True):
                return refuse(f"thread {tid} is from an untrusted author; the developer resolves it (ADR-0015)")
            if args.action == "resolve" and thread["resolved"]:
                return refuse(f"thread {tid} is already resolved")
            if args.action == "reopen" and not thread["resolved"]:
                return refuse(f"thread {tid} is not resolved")
            chosen.append(thread)
        if args.fixed and not on_branch(args.fixed, github.pr_commit_shas(pr, cwd=cwd)):
            return refuse(f"{args.fixed} is not a commit on PR #{pr}'s branch at the remote (push first)")
        if args.action == "resolve":
            if args.fixed:
                reply = f"fixed in {args.fixed}"
            else:
                reply = f"left: {args.left} (follow-up #{args.followup.lstrip('#')})" if args.followup else f"left: {args.left} (no follow-up)"
            outcome, field = "resolved", RESOLVE_FIELD
        else:
            reply, outcome, field = f"reopened: {args.why}", "reopened", UNRESOLVE_FIELD
        # A retry after a failed mutation must not post the same reply twice.
        todo = [t for t in chosen if not (t["comments"] and t["comments"][-1]["body"].strip() == reply)]
        if todo:
            sent += 1
            batched(REPLY_FIELD, [t["id"] for t in todo], cwd, [reply] * len(todo))
        sent += 1
        batched(field, [t["id"] for t in chosen], cwd)
    except github.GhError as e:
        common.die(f"threads: gh failed: {e.message}")
    finally:
        if args.verbose and args.action:
            print(f"writes: {sent}", file=sys.stderr)
    for thread in chosen:
        author = thread["comments"][0]["author"] if thread["comments"] else "ghost"
        try:
            runlog.append_event(cwd, runlog.THREADS, outcome, ref=ref, thread=thread["id"], author=author)
        except OSError as e:
            common.die(f"threads: the thread is {outcome}, but the run log is unwritable: {e.strerror or e}")
        print(f"{outcome} {thread['id']}: {reply}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
