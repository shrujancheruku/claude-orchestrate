#!/usr/bin/env python3
"""lead-brief [--repo PATH] [--now ISO] [--checkpoint <pr>] [--velocity] [--watch [--interval SECONDS]] : the lead's whole start-up index, in one call.

With no arguments it prints these sections, in this fixed order, each under a `== <name> ==` line:
    config       the repo's `.claude/orchestration.md`, whole
    tracker      `docs/agents/issue-tracker.md`, whole
    glossary     `GLOSSARY.md`, whole
    adrs         one line per `docs/adr/NNNN-*.md`: number, title, status
    tickets      open `needs-lead` tickets, then open `lead` tickets: title, link, age
    roadmap      open `wayfinder:map` issues and open parent issues, with sub-issues open/closed
    merges       the PRs merged since the watermark, one line each: title, ticket, tier, `discovered:` count
Each L-tier merge line is followed by its risk notes word for word (PR title and link, ticket, review link, then
each `path:line-range — what to look at`), from the posted review, else from the fallback comment `run` posts
(first line `> *Risk notes (review not posted).*`). A section it cannot read prints `unavailable: <why>` and the
rest still prints. The watermark is `.claude/orchestrate-lead.json`, written only by `--checkpoint <pr>` (last
absorbed PR, merged-at time, merge count). A missing or unreadable watermark falls back to the last 7 days of
merges, at most 20, and says so in one line. Reads only: the tracker is never written.

`--watch` is the lead's background wake-up. It records the newest issue number and the open `needs-lead` set, then
reads the open-issues snapshot no more than once per `--interval` (default 300 seconds) and exits 0 on the first
poll with a hit, one line per hit:
    new: #<n> <title> [<labels>]            an open issue numbered above the newest at start
    needs-lead: #<n> <title>                an open `needs-lead` ticket that was not in the set at start
    stale: #<n> <title> blocked-by #<m>...  a takeable ticket whose body `Blocked by:` line names only closed issues
    idle-slot: <b>/<cap> building; dispatchable: #<n> ... (<m>m)
                                            building claims (parked ones not counted, `claims.slot_use`) stayed under the
                                            config's Slots count for longer than the Velocity section's idle window (default 10m)
                                            while `frontier` listed a ticket no `holds` check blocks (read from the ticket's
                                            `Lands in:` paths; one with none counts as free). It reads `claims` and `frontier`
                                            rules only; `velocity watch: off` or no Slots line skips it. Each wake restarts the clock.
Then `next: settled` (ADR-0014): the lead triages or grooms what it named and starts the watch again. A rate limit
ends it as exit 2 with `next: retry-after <time>`; any other failure is `next: could-not-run`.

`--velocity` is the pass digest's slot read: `slots: <building>/<cap> building, <k> parked`, then one
`expensive-hold: PR #<n> holds #<a> #<b> ...` line per open PR that holds at least the Velocity section's
`Expensive hold` count (default 3) of takeable tickets (through `holds`, by each ticket's `Lands in:` paths), then
`next: done` (ADR-0014; a rate limit is `retry-after <time>`, any other failure `could-not-run`).
"""

import argparse
import json
import os
import re
import sys
import tempfile
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path

import claims
import common
import config
import github
import holds
import tracker
from repo import STATE, first_line, parse_ts

from tracker import RISK_MARKER  # the first line of the fallback comment (tracker.py, #661)
WATERMARK = Path(".claude") / "orchestrate-lead.json"
FALLBACK_DAYS = 7
FALLBACK_CAP = 20
WATCH_INTERVAL = 300  # seconds: the least time between two snapshot reads of --watch
MERGED_LIMIT = 100  # the newest merged PRs by update, one `gh api graphql`
RISK_LINE = re.compile(r"^\s*[-*]?\s*(\S+:\d+(?:-\d+)?\s+—\s+\S.*)$")
TIER = re.compile(r"\btier:\s*([SML])\b")
CLOSES = re.compile(r"\b(?:close[sd]?|fix(?:e[sd])?|resolve[sd]?)\s+#(\d+)", re.I)

MERGED_QUERY = """query($owner: String!, $name: String!, $limit: Int!) {
  repository(owner: $owner, name: $name) {
    pullRequests(states: MERGED, last: $limit, orderBy: {field: UPDATED_AT, direction: ASC}) {
      totalCount
      nodes { number title url body mergedAt
        labels(first: 20) { nodes { name } }
        closingIssuesReferences(first: 1) { nodes { number } }
        reviews(last: 30) { nodes { url body authorAssociation author { __typename login } } }
        comments(last: 50) { nodes { url body authorAssociation author { __typename login } } } } } } }"""


class Unavailable(Exception):
    pass


def read_text(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8", errors="replace").rstrip("\n")
    except OSError as e:
        raise Unavailable(f"cannot read {path}: {e.strerror or e}")


def gh_json(root, *args, shape=dict):
    try:
        return github.call_json(*args, shape=shape, cwd=root)
    except github.GhError as e:
        raise Unavailable(f"gh failed: {e.message}")


def repo_info(root) -> dict:
    try:
        return github.repo_info(root)
    except github.GhError as e:
        raise Unavailable(f"gh failed: {e.message}")


def repo_vars(repo) -> list:
    try:
        return ["-F", f"owner={repo['owner']['login']}", "-F", f"name={repo['name']}"]
    except (KeyError, TypeError):
        raise Unavailable("gh returned an unexpected reply (repo)")


def open_issues(root, repo) -> list:
    """The open-issues snapshot, the read `claims` and `frontier` take too, so the lead's view cannot disagree."""
    try:
        return github.open_issues(repo, cwd=root)
    except github.GhError as e:
        raise Unavailable(f"gh failed: {e.message}")


def graphql(root, query, limit, repo):
    """One `gh api graphql` call; every `-F`/`-f` variable is one the query declares."""
    return gh_json(root, "api", "graphql", "-f", f"query={query}", "-F", f"limit={limit}", *repo)


def labels_of(issue) -> set:
    return {x["name"] for x in (issue.get("labels") or {}).get("nodes") or []}


def nodes_of(data, key, *path):
    try:
        node = data["data"]["repository"][key]
        for p in path:
            node = node[p]
        return node
    except (KeyError, TypeError):
        raise Unavailable("gh returned an unexpected reply")


def age(created, now) -> str:
    t = parse_ts(created)
    if t is None:
        return "age unknown"
    secs = max(0, int((now - t).total_seconds()))
    for unit, size in (("d", 86400), ("h", 3600), ("m", 60)):
        if secs >= size:
            return f"{secs // size}{unit}"
    return "0m"


def section_adrs(root) -> list:
    files = sorted((root / "docs" / "adr").glob("[0-9][0-9][0-9][0-9]-*.md"))
    if not files:
        raise Unavailable("no ADRs under docs/adr")
    lines = []
    for f in files:
        text = read_text(f)
        title = next((m.group(1) for m in re.finditer(r"^#\s+(.+?)\s*$", text, re.M)), f.stem)
        m = re.search(r"^\**Status:?\**:?\s*(.+?)\s*$", text, re.M | re.I)
        if m is None:
            m = re.search(r"^##\s+Status\s*\n+\s*(.+?)\s*$", text, re.M | re.I)
        lines.append(f"{f.name[:4]} {title} [{m.group(1) if m else 'status not stated'}]")
    return lines


def section_tickets(issues, now) -> list:
    lines = []
    for label in ("needs-lead", "lead"):
        for i in sorted((i for i in issues if label in labels_of(i)), key=lambda i: i["number"]):
            lines.append(f"[{label}] #{i['number']} {i['title']} {i['url']} ({age(i.get('createdAt'), now)})")
    return lines or ["none"]


def section_roadmap(issues) -> list:
    lines = []
    for i in sorted(issues, key=lambda i: i["number"]):
        labels = labels_of(i)
        summary = i.get("subIssuesSummary") or {}
        total, done = int(summary.get("total") or 0), int(summary.get("completed") or 0)
        if "wayfinder:map" in labels or total:
            kind = "map" if "wayfinder:map" in labels else "parent"
            lines.append(f"[{kind}] #{i['number']} {i['title']} {i['url']} — {total - done} open, {done} closed")
    return lines or ["none"]


def trusted_only(nodes, trusted) -> list:
    """The reviews or comments a trusted author wrote (ADR-0015): `tier:`, risk notes and discovered work are read from
    these alone, so a stranger's review or comment cannot set a tier or plant a finding."""
    return [n for n in nodes or [] if github.is_trusted(n.get("authorAssociation"), github.actor_login(n.get("author")), trusted)]


def pr_of(node, trusted=()) -> dict:
    """One merged PR as a plain dict; its reviews and comments are the trusted authors' only."""
    refs = ((node.get("closingIssuesReferences") or {}).get("nodes")) or []
    body = node.get("body") or ""
    ticket = refs[0]["number"] if refs else (int(CLOSES.search(body).group(1)) if CLOSES.search(body) else None)
    return {"number": int(node["number"]), "title": node.get("title") or "", "url": node.get("url") or "",
            "body": body, "merged": parse_ts(node.get("mergedAt")), "ticket": ticket,
            "labels": {x["name"] for x in (node.get("labels") or {}).get("nodes") or []},
            "reviews": [r for r in trusted_only((node.get("reviews") or {}).get("nodes"), trusted) if r.get("body")],
            "comments": trusted_only((node.get("comments") or {}).get("nodes"), trusted)}


def load_merged(root, repo):
    data = graphql(root, MERGED_QUERY, MERGED_LIMIT, repo)
    trusted = github.trusted_logins(root)
    prs = [pr_of(n, trusted) for n in nodes_of(data, "pullRequests", "nodes")]
    prs = sorted((p for p in prs if p["merged"]), key=lambda p: (p["merged"], p["number"]))
    return prs, int(nodes_of(data, "pullRequests", "totalCount"))


def section_lines(body, heading="## Discovered work") -> list:
    """Non-blank lines under the heading, up to the next `## ` heading."""
    out, inside = [], False
    for line in (body or "").splitlines():
        if line.startswith("## "):
            inside = line.strip().lower() == heading.lower()
        elif inside and line.strip():
            out.append(line)
    return out


def risk_lines(text) -> list:
    return [m.group(1).strip() for m in map(RISK_LINE.match, (text or "").splitlines()) if m]


def tier_and_notes(pr):
    """(tier, risk-note lines, link of the review or comment they came from). A posted review states the tier;
    with an L review that holds no notes, or none posted, the fallback comment is the L-tier record."""
    is_l = False
    for r in reversed(pr["reviews"]):
        m = TIER.search(first_line(r["body"]))
        if m:
            if m.group(1) != "L" and not is_l:
                return m.group(1), [], None
            is_l = True
            notes = risk_lines(r["body"])
            if notes:
                return "L", notes, r.get("url") or "no link"
    fallbacks = [c for c in pr["comments"] if first_line(c.get("body")) == RISK_MARKER]
    if fallbacks:
        c = fallbacks[-1]
        return "L", risk_lines(c["body"].split("\n", 1)[-1]), c.get("url") or "no link"
    if is_l:
        return "L", [], None
    label = next((x[5:] for x in pr["labels"] if re.fullmatch(r"size:[SML]", x)), None)
    return label or "?", [], None


def discovered_count(pr) -> int:
    """Items under `## Discovered work` in the PR body, plus those in the newest review that has the section."""
    def items(text):  # risk notes may follow the section without a heading of their own
        return [l for l in section_lines(text) if not RISK_LINE.match(l)]
    n = len(items(pr["body"]))
    for r in reversed(pr["reviews"]):
        found = items(r["body"])
        if found:
            return n + len(found)
    return n


def read_watermark(root):
    """The watermark as a dict, or None when missing or unreadable."""
    try:
        data = json.loads((root / WATERMARK).read_text())
        merged = parse_ts(data["merged_at"])
        return {"pr": int(data["pr"]), "merged": merged, "merges": int(data["merges"])} if merged else None
    except (OSError, ValueError, KeyError, TypeError):
        return None


def section_merges(root, repo, now) -> list:
    prs, _ = load_merged(root, repo)
    mark = read_watermark(root)
    lines = []
    if mark:
        shown = [p for p in prs if p["merged"] > mark["merged"]]
        lines.append(f"since PR #{mark['pr']} ({mark['merges']} merges absorbed)")
    else:
        since = now - timedelta(days=FALLBACK_DAYS)
        shown = [p for p in prs if p["merged"] >= since][-FALLBACK_CAP:]
        lines.append(f"no readable watermark: showing merges from the last {FALLBACK_DAYS} days, at most {FALLBACK_CAP}")
    for p in shown:
        tier, notes, link = tier_and_notes(p)
        ticket = f"#{p['ticket']}" if p["ticket"] else "no ticket"
        lines.append(f"{p['title']} {p['url']} · {ticket} · tier {tier} · discovered: {discovered_count(p)}")
        if tier == "L":
            lines.append(f"  risk notes: {p['title']} {p['url']} · ticket {ticket} · review {link or 'none'}")
            lines.extend(f"    {n}" for n in notes or ["none found in the review or the fallback comment"])
    if not shown:
        lines.append("none")
    return lines


def checkpoint(root, number) -> int:
    try:
        prs, total = load_merged(root, repo_vars(repo_info(root)))
    except Unavailable as e:
        common.die(f"lead-brief: cannot checkpoint: {e}")
    pr = next((p for p in prs if p["number"] == number), None)
    if pr is None:
        common.die(f"lead-brief: cannot checkpoint: PR #{number} is not among the newest {MERGED_LIMIT} merged PRs")
    merges = total - sum(1 for p in prs if p["merged"] > pr["merged"])
    path = root / WATERMARK
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=".orchestrate-lead-")
    with os.fdopen(fd, "w") as f:
        json.dump({"pr": number, "merged_at": pr["merged"].strftime("%Y-%m-%dT%H:%M:%SZ"), "merges": merges}, f)
    os.replace(tmp, path)
    print(f"checkpoint: PR #{number}, {merges} merges")
    return 0


def watch_state(nodes, ready):
    """(the open `needs-lead` numbers, {stale ticket number: hit line}) of one snapshot read."""
    issues = tracker.from_nodes(nodes)
    open_numbers = {i["number"] for i in issues}
    stale = {}
    for i in issues:
        if ready not in i["labels"] or i["claimed"] or i["blockers"]:
            continue
        blockers = tracker.body_blockers(i)
        if blockers and not any(n in open_numbers for n in blockers):
            stale[i["number"]] = f"stale: #{i['number']} {i['title']} blocked-by " + " ".join(f"#{n}" for n in blockers)
    return {i["number"] for i in issues if "needs-lead" in i["labels"]}, stale


def watch_hits(nodes, ready, newest, lead_set) -> list:
    """The hit lines of one read against what the watch recorded at start."""
    now_lead, stale = watch_state(nodes, ready)
    hits = []
    for n in sorted(nodes, key=lambda n: n["number"]):
        num, title = n["number"], n.get("title") or ""
        if num > newest:
            labels = sorted(x["name"] for x in (n.get("labels") or {}).get("nodes") or [])
            hits.append(f"new: #{num} {title} [{', '.join(labels)}]")
        if num in now_lead - lead_set:
            hits.append(f"needs-lead: #{num} {title}")
        if num in stale:
            hits.append(stale[num])
    return hits


def velocity(root, cfg=None, lazy=False):
    """(building, cap, parked, dispatchable, holders) of the tracker now, from `claims` and `frontier`'s rules only (#716).
    `dispatchable` are the takeable tickets with no hold: the ticket's `Lands in:` paths (holds.ticket_paths) run through
    `holds`, so one with no declared paths counts as free. `holders` is {PR: [takeable tickets it holds]}. The cap is the
    config's Slots count, or None."""
    cfg = cfg or config.for_checkout(root)
    snap = tracker.Snapshot.open(None, root)
    found = claims.claims(root, root / STATE, snap.issues, snap.prs, snap.merged, changes=lambda path, branch: None)
    building, parked = claims.slot_use(found)
    if lazy and (cfg.slots is None or building >= cfg.slots):  # the watch needs no hold check when every slot is full
        return building, cfg.slots, parked, [], {}
    snap.use_cache(root / tracker.SNAPSHOT_FILE)  # the PR file lists are cached by head SHA (#446)
    take = tracker.takeable(snap.issues, tracker.label_strings(root))
    declared = {i["number"]: holds.ticket_paths(i.get("body")) for i in take}
    held, holders = holds.held_tickets(snap, root, {n: p for n, p in declared.items() if p}, cfg=cfg)
    return building, cfg.slots, parked, [i["number"] for i in take if i["number"] not in held], holders


def idle_slot_line(building, cap, dispatchable, idle_minutes) -> str:
    shown = " ".join(f"#{n}" for n in dispatchable[:5]) + (" …" if len(dispatchable) > 5 else "")
    return f"idle-slot: {building}/{cap} building; dispatchable: {shown} ({idle_minutes}m)"


def section_velocity(root, cfg=None) -> list:
    """The pass digest's two lines (`lead-brief --velocity`): `slots: <building>/<cap> building, <k> parked`, then one
    `expensive-hold: PR #<n> holds #<a> #<b> ...` per open PR that holds at least the config's threshold of takeable tickets."""
    cfg = cfg or config.for_checkout(root)
    building, cap, parked, _, holders = velocity(root, cfg)
    out = [f"slots: {building}/{cap if cap is not None else '?'} building, {parked} parked"]
    for pr, tickets in sorted(holders.items()):
        if len(tickets) >= cfg.hold_threshold:
            out.append(f"expensive-hold: PR #{pr} holds " + " ".join(f"#{n}" for n in sorted(tickets)))
    return out


def run_watch(root, interval, read=None, clock=time.monotonic, sleep=time.sleep, slots=None) -> int:
    """Record the baseline, then poll until a hit. `read` returns the raw issue nodes (default: the open-issues read);
    `clock` and `sleep` are the seams a test fakes. `slots` returns (building, cap, dispatchable tickets) and defaults to
    `velocity` when the config has a Slots count; the watch adds an `idle-slot:` hit once building is under the cap with a
    dispatchable ticket for longer than the config's idle window (`velocity watch: off` skips it). Never writes to the tracker."""
    github.rate_limited_until = None
    cfg = config.for_checkout(root)
    if not cfg.velocity_watch:
        slots = None
    elif slots is None and cfg.slots is not None:
        def slots():  # noqa: E306
            building, cap, _, free, _ = velocity(root, cfg, lazy=True)
            return building, cap, free
    idle_since = None
    try:
        ready = tracker.label_strings(root)["ready"]
    except (ValueError, OSError, KeyError):
        ready = tracker.DEFAULTS["ready"]
    try:
        if read is None:
            repo = repo_info(root)
            read = lambda: github.open_issues(repo, cwd=root)  # noqa: E731
        base = read()
        newest = max((n["number"] for n in base), default=0)
        lead_set, _ = watch_state(base, ready)
        last = clock()
        while True:
            sleep(max(0.0, last + interval - clock()))
            last = clock()
            hits = watch_hits(read(), ready, newest, lead_set)
            if slots is not None:
                building, cap, free = slots()
                if cap is not None and building < cap and free:
                    idle_since = last if idle_since is None else idle_since
                    if last - idle_since > cfg.idle_window * 60:
                        hits.append(idle_slot_line(building, cap, free, int((last - idle_since) // 60)))
                else:
                    idle_since = None
            if hits:
                print("\n".join(hits))
                return common.verdict("settled", exit_code=0)
    except (Unavailable, github.GhError) as e:
        message = getattr(e, "message", None) or str(e)
        until = common.rate_limit_time(message) or github.rate_limited_until
        print(f"lead-brief: cannot watch: {message}", file=sys.stderr)
        if until:
            return common.verdict("retry-after", until, exit_code=2)
        return common.verdict("could-not-run", exit_code=2)
    except (KeyError, TypeError, ValueError, OSError) as e:  # OSError: an unreadable state file (claims, holds)
        print(f"lead-brief: cannot watch: unexpected reply ({e.__class__.__name__})", file=sys.stderr)
        return common.verdict("could-not-run", exit_code=2)


def run_velocity(root) -> int:
    """Print `section_velocity`'s lines and end `next: done`; a failed read ends as the watch's does."""
    github.rate_limited_until = None
    try:
        lines = section_velocity(root)
    except (Unavailable, github.GhError, KeyError, TypeError, ValueError, OSError) as e:
        message = getattr(e, "message", None) or str(e)
        until = common.rate_limit_time(message) or github.rate_limited_until
        print(f"lead-brief: cannot read the velocity: {message}", file=sys.stderr)
        if until:
            return common.verdict("retry-after", until, exit_code=2)
        return common.verdict("could-not-run", exit_code=2)
    print("\n".join(lines))
    return common.verdict("done", exit_code=0)


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0], allow_abbrev=False)
    ap.add_argument("--repo", default=".", help="repo root; gh runs there and the files are read under it")
    ap.add_argument("--now", default=None, help="the time now, as ISO 8601 (tests; default: the current time)")
    ap.add_argument("--checkpoint", type=int, metavar="PR", help="write the watermark: PR is the last one absorbed")
    ap.add_argument("--watch", action="store_true", help="wait for a new issue, a new needs-lead ticket or a stale blocker line")
    ap.add_argument("--interval", type=float, default=WATCH_INTERVAL, help="--watch: least seconds between reads (default 300)")
    ap.add_argument("--velocity", action="store_true",
                    help="print the digest's slot use and expensive holds (`slots:`, `expensive-hold:`), then `next: done`")
    args = ap.parse_args(argv)
    if sum(bool(x) for x in (args.watch, args.velocity, args.checkpoint is not None)) > 1:
        common.die("lead-brief: cannot run: --watch, --velocity and --checkpoint do not go together")
    if args.velocity:
        return run_velocity(Path(args.repo).resolve())
    if args.watch:
        return run_watch(Path(args.repo).resolve(), args.interval)
    now = datetime.now(timezone.utc) if args.now is None else parse_ts(args.now)
    if now is None:
        common.die(f"lead-brief: cannot run: --now is not an ISO time: {args.now}")
    root = Path(args.repo).resolve()
    if args.checkpoint is not None:
        return checkpoint(root, args.checkpoint)
    memo = {}  # each gh read runs once per brief, however many sections use it

    def once(key, build):
        if key not in memo:
            memo[key] = build()
        return memo[key]

    def repo():
        return once("repo", lambda: repo_info(root))

    def snapshot():  # one open-issues read, shared by the tickets and roadmap sections
        return once("issues", lambda: open_issues(root, repo()))

    sections = [
        ("config", lambda: read_text(root / common.CONFIG).splitlines()),
        ("tracker", lambda: read_text(root / "docs" / "agents" / "issue-tracker.md").splitlines()),
        ("glossary", lambda: read_text(root / "GLOSSARY.md").splitlines()),
        ("adrs", lambda: section_adrs(root)),
        ("tickets", lambda: section_tickets(snapshot(), now)),
        ("roadmap", lambda: section_roadmap(snapshot())),
        ("merges", lambda: section_merges(root, repo_vars(repo()), now)),
    ]
    for name, build in sections:
        print(f"== {name} ==")
        try:
            lines = build()
        except Unavailable as e:
            lines = [f"unavailable: {e}"]
        except (KeyError, TypeError, ValueError) as e:
            lines = [f"unavailable: unexpected reply ({e.__class__.__name__})"]
        for line in lines:
            print(line)
    return 0


if __name__ == "__main__":
    sys.exit(main())
