#!/usr/bin/env python3
"""claims [<ticket>] [--repo DIR] [--state FILE] [--session ID] : what state is each claimed ticket in?

One line per claimed ticket in ascending ticket order, or the one named (the rules are in scripts/claims.py):
    #<n> <state word> <branch | none-yet | no-branch> pr <num | none> worker <agent-id> <model> | unknown | none worktree <path | gone> lock <lock> [<changes>]
branch `none-yet`: the worktree is on the harness's `worktree-agent-*` branch, so the worker stopped before it created the ticket branch (`rescue <n>` saves it).
worker `unknown`: a building claim with no state record, this session's own live worker that the state file couldn't join.
state: with-lead | in-review | done | building | idle | paused | waiting | elsewhere | stalled | parked.
       `waiting <permission-denied | exhausted> since <ts>`: the newest worker-report needs the developer; it never expires.
       `waiting <gate | round-3> since <ts>` (a ready PR): the PR's newest `merge` event is `gate-hold`, or its newest `review` event asked
       for changes in round 2 or later so the next review is a third round; the user decides, and a newer event ends it.
       `waiting <question | adr-conflict | info> since <ts>`: the ticket's newest `transition` event (stop-for-lead, adr-hold, to-info) while its
       label (`needs-lead`, `needs-info`) is still on; the lead or author answers, then removes the label.
       `paused <limit | error> since <ts>`: the newest worker-report is a usage-limit or API error; a pass resumes it.
       `idle since <ts> [nudged <ts>]`: a building claim whose worker ended its turn with an `interim` report after its dispatch and has reported nothing since;
       `nudged` is the pass log's `record --nudged` time. Both timestamps are UTC, `YYYY-MM-DDTHH:MM:SSZ`.
lock:  `ours <pid>` (this session's own worker); `foreign-live <pid>`; `foreign-live ?` (the line then ends ` (lock: <reason>)`: the reason doesn't parse, which counts as live;
       unlock the worktree if it is stale); `dead <pid>` (unlock it, then rescue it); `none` (no lock or no worktree).
changes (only with a worktree and no PR): `clean`, `dirty <k>`, `unpushed <k>` or `dirty <k> unpushed <j>`.
repeat / incomplete: a line may end `repeat not-a-stop` and `repeat missing-report-none` (the worker has reported that twice since its dispatch) and
`incomplete <k>` (the PR's last k reviewer reports in a row were `incomplete`), in that order after `escalate`: the run skill applies the word, it counts nothing.
With `--slots` under greedy (the newest `greedy` run-log event, written by `launch`, is `set`) the cap is the greedy cap and the line ends ` greedy`.
escalate: a line ends `escalate <model>` when the ticket's haiku worker met a mechanical trigger on its PR (a second `ci fail`, or a `review`
event of round 2 or later that requested changes): hand the ticket to a new worker on that model. An unanswerable `stopped` report is the orchestrator's judgement, not this word's.
`claims <n> --resume` (#788): for a paused ticket not yet resumed, writes the `pause-resume` run-log event (ticket, `since` of the pause it ends)
and prints `#<n> resume send`; any other ticket prints `#<n> resume skip <why>` (`not paused (<state>)` or `already resumed <ts>`) and writes nothing.
A paused line carries ` resumed <ts>` once the event exists. The run skill sends its resume message only on `send`.
`claims <n>` for an unclaimed ticket prints `#<n> not claimed`. No summary line, unless `--slots` ends the listing with
`slots: <building>/<cap> building, <k> parked` (#716): the claims that occupy a slot against the config's Slots count, and the parked
ones apart. A `parked` claim is listed but never counted against the cap; `done` and `with-lead` claims are not counted either.
Reads the run log and the pass log (a missing one is no events), the tracker as one Snapshot (scripts/tracker.py; `--snapshot FILE` reads a file `snapshot` wrote instead of fetching), the state file (a missing one means no workers) and
`git worktree list`. Exit codes: 0 printed; 2 could not run (no `gh`, a failed `gh` or `git` call, not a repository, an
unreadable state file), one line on stderr. Every run ends with exactly one `next:` line (ADR-0014): `done` (0), `retry-after <time>`
(a rate limit it would not sleep through) or `could-not-run [<Class>: <message>]` (2).
Stdlib only, Python 3.9+.
"""

import argparse
import os
import sys
from pathlib import Path

import claims
import common
import config
import github
import runlog
import tracker
from repo import STATE


def line(c) -> str:
    worker = ("unknown" if c.state in ("building", "idle") else "none") if not c.worker else f"{c.worker.get('agent_id') or '?'} {c.worker.get('model') or '?'}"
    lock = "none" if c.lock is None else f"{c.lock[0]} {c.lock[1] if c.lock[1] is not None else '?'}"
    state = c.state
    if c.state in ("waiting", "paused"):
        state += f" {c.reason} since {c.since or '?'}" + (f" resumed {c.resumed}" if c.resumed else "")
    elif c.state == "idle":
        state += f" since {c.since or '?'}" + (f" nudged {c.nudged}" if c.nudged else "")
    out = (f"#{c.ticket} {state} {c.branch or ('none-yet' if c.pending_branch else 'no-branch')} pr {c.pr if c.pr is not None else 'none'}{' draft' if c.draft else ''} "
           f"worker {worker} worktree {c.worktree or 'gone'} lock {lock}")
    if c.changes is not None:
        dirty, unpushed = c.changes
        parts = ([f"dirty {dirty}"] if dirty else []) + ([f"unpushed {unpushed}"] if unpushed else [])
        out += " " + " ".join(parts or ["clean"])
    if c.lock and len(c.lock) == 3:
        out += f" (lock: {c.lock[2]})"
    if c.escalate:
        out += f" escalate {c.escalate}"
    out += "".join(f" repeat {word}" for word in c.repeat)
    if c.incomplete:
        out += f" incomplete {c.incomplete}"
    return out


def main(argv=None) -> int:
    """Run, then end with the one `next:` line (ADR-0014): `done`, `retry-after <time>` or `could-not-run`."""
    return common.finish(run, argv, {0: ("done",)})


def run(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0], allow_abbrev=False)
    ap.add_argument("ticket", nargs="?", type=int, help="print only this ticket")
    ap.add_argument("--repo", default=".", help="a directory of the repository (default: the current one)")
    ap.add_argument("--state", default=None, help="state file (default: <repo>/.claude/orchestrate-state.json)")
    ap.add_argument("--session", default=None,
                    help="this session's id: its state-file entry is the current one, not the last rebuilder's (#532)")
    ap.add_argument("--snapshot", default=None, help="read the tracker from this file (scripts/snapshot) instead of fetching")
    ap.add_argument("--resume", action="store_true",
                    help="with <ticket>: write the pause-resume event for a paused, not yet resumed claim; print send or skip (#788)")
    ap.add_argument("--slots", action="store_true", help="end the listing with `slots: <building>/<cap> building, <k> parked`")
    args = ap.parse_args(argv)
    if args.session:
        os.environ[runlog.SESSION_ENV] = args.session  # github's gh_call events are written under it too
    root = Path(args.repo).resolve()
    if not root.is_dir() or common.run("git", "rev-parse", "--git-dir", cwd=root).code != 0:
        common.die(f"claims: cannot run: {args.repo} is not in a git repository")
    state_file = Path(args.state) if args.state else root / STATE
    try:
        snap = tracker.Snapshot.open(args.snapshot, root)
        found = claims.claims(root, state_file, snap.issues, snap.prs, snap.merged, session=args.session)
    except github.GhError as e:
        common.die(f"claims: cannot run: gh failed: {e.message}")
    except (KeyError, TypeError, ValueError) as e:
        common.die(f"claims: cannot run: {e}")
    all_found = found  # the slot count is over every claim, whatever `<ticket>` narrows the listing to
    if args.ticket is not None:
        found = {args.ticket: found[args.ticket]} if args.ticket in found else {}
        if not found:
            print(f"#{args.ticket} not claimed")
    if args.resume:
        if args.ticket is None:
            common.die("claims: cannot run: --resume needs a <ticket>")
        if args.ticket in found:
            try:
                sent, why = claims.resume(root, found[args.ticket], session=args.session)
            except runlog.NoSession as e:
                common.die(f"claims: cannot run: {e}")
            print(f"#{args.ticket} resume " + ("send" if sent else f"skip {why}"))
        return 0
    for n in sorted(found):
        print(line(found[n]))
    if args.slots:
        print(claims.slots_line(all_found, config.for_checkout(root).slots, claims.greedy_cap(root)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
