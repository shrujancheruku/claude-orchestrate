#!/usr/bin/env python3
"""holds (--touch-map PATH... --ticket N | --pr N) [--repo DIR] [--state FILE] : what is held, and does this overlap it.

The one place the overlap rule lives. A path is held by an open PR (its diff, through `gh`), by a
building ticket (its touch map in the state file), by an Elsewhere ticket (a live worker in another session:
the changes in its worktree, ADR 0009) or by an exclusive hold (the config). Paths are compared
as files: any `:line` or line range is stripped, so a different section of one file still overlaps.
The ticket's own PR and touch map are left out: --ticket N leaves out the PR whose branch starts `N-`;
--pr N leaves out PR N and the ticket its branch names.

Output: one line per held path, `path (held by open PR #9, building #12, elsewhere #13, an exclusive hold)` (the form
of the brief's `Held paths:` line), or `none`. Then `overlap: <path> (held by ...)` per counted overlap, `shared (not
counted): ...` per overlap on a config shared file, or `overlap: none`. A missing state file means no building
tickets. Exit codes: 0 nothing overlaps; 1 an overlap; 2 could not run (no `gh`, a failed `gh` or `git` call, an
unreadable state file). Stdlib only, Python 3.9+.
"""

from __future__ import annotations

import argparse
import fnmatch
import json
import re
import sys
from pathlib import Path

import common
import config
import github

STATE = Path(".claude") / "orchestrate-state.json"
LINE_SUFFIX = re.compile(r":\d+(?:[-–,]\d+)*$")


def plain(entry: str) -> str:
    """A touch-map entry as a file path: no `:line` or line range, no leading `./`."""
    path = LINE_SUFFIX.sub("", entry.strip().strip("`"))
    return path[2:] if path.startswith("./") else path


def ticket_of_branch(branch) -> int | None:
    m = re.match(r"(\d+)-", branch or "")
    return int(m.group(1)) if m else None


def building(state_file: Path, own) -> dict:
    """{ticket: [paths]} for every ticket in the state file but `own`; {} when the file is missing."""
    try:
        data = json.loads(state_file.read_text())
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as e:
        raise ValueError(f"unreadable state file {state_file}: {e}") from None
    tickets = data.get("tickets") if isinstance(data, dict) else None
    if not isinstance(tickets, dict):
        raise ValueError(f"state file {state_file} has no tickets object")
    out = {}
    for n, t in tickets.items():
        entries = t.get("touch_map") if isinstance(t, dict) else None
        if str(n) != str(own) and isinstance(entries, list):
            out[n] = [plain(e) for e in entries if isinstance(e, str) and plain(e)]
    return out


def still_building(tickets: dict, with_open_pr: set, base: str, repo: Path) -> dict:
    """Keep the state-file tickets that are Building: issue open and no PR yet.

    The state file is a cache and the tracker wins (rebuild-state keeps every worker the session
    dispatched, merged ones too). A ticket with an open PR is already held through that PR's diff.
    """
    out, merged = {}, None
    for n, paths in tickets.items():
        # rebuild-state keys tickets by number; a key that is not one cannot be checked against the tracker.
        if not str(n).isdigit() or int(n) in with_open_pr:
            continue
        if github.issue_state(n, cwd=repo).upper() != "OPEN":
            continue
        if merged is None:  # one lookup, only when an open issue remains
            merged = {ticket_of_branch(p.get("headRefName")) for p in github.merged_prs(base, cwd=repo) if isinstance(p, dict)}
        if int(n) not in merged:
            out[n] = paths
    return out


def worktree_changes(path, base: str) -> list:
    """Every path the worktree at `path` has changed against its merge-base with the default branch: committed (pushed
    or not), staged, unstaged and untracked. A diff against the merge-base covers the tracked ones; `ls-files --others`
    adds the untracked. A failed git call raises ValueError (could not run): an empty answer would hold nothing."""
    ref = f"origin/{base}"
    if common.run("git", "rev-parse", "--verify", "-q", ref, cwd=path).code != 0:
        ref = base  # no remote-tracking ref (a clone that never fetched it): the local default branch
    mb = common.run("git", "merge-base", "HEAD", ref, cwd=path)
    if mb.code != 0 or not mb.stdout.strip():
        raise ValueError(f"cannot find the merge-base of {path} with {ref}")
    changed = common.run("git", "diff", "--name-only", "-z", mb.stdout.strip(), cwd=path)
    untracked = common.run("git", "ls-files", "--others", "--exclude-standard", "-z", cwd=path)
    if changed.code != 0 or untracked.code != 0:
        raise ValueError(f"cannot list the changes in {path}")
    return sorted({p for out in (changed.stdout, untracked.stdout) for p in out.split("\0") if p})


def elsewhere(root: Path, base: str, skip: set) -> dict:
    """{ticket: [paths]} for each Elsewhere ticket (ADR 0009): a claimed, open ticket with no PR this session is building,
    whose worktree the liveness helper says a live session's worker holds. Its changes are held. A dead, missing or
    unlocked worker holds nothing, and so does a live one that has changed nothing yet. `skip` holds the tickets
    already held through a PR or the state file, and this ticket's own. Worktrees come from `git worktree list`,
    never the state file."""
    out = {}
    for wt in common.worktrees(root):
        n = ticket_of_branch(wt["branch"])
        if n is None or n in skip or wt["locked"] is None:
            continue
        if common.worker_liveness(root, wt["branch"])[0] != "live":
            continue
        # The tracker decides: a closed or unclaimed ticket whose worktree lingers holds nothing.
        issue_state, claimed = github.issue_claim(n, cwd=root)
        if issue_state.upper() != "OPEN" or not claimed:
            continue
        paths = worktree_changes(wt["path"], base)
        if paths:
            out[n] = paths
    return out


def covers(held: str, path: str) -> bool:
    """A held entry covers a path when it is that file, or a directory (`db/`) containing it."""
    return path == held or (held.endswith("/") and path.startswith(held))


def held_paths(cfg, prs: dict, tickets: dict, others: dict) -> dict:
    """{path: [holder, ...]} in a stable order. `others` is {ticket: [paths]} for the Elsewhere tickets."""
    held: dict = {}
    for n, paths in sorted(prs.items()):
        for p in paths:
            held.setdefault(p, []).append(f"open PR #{n}")
    for n, paths in sorted(tickets.items(), key=lambda kv: int(kv[0]) if str(kv[0]).isdigit() else 0):
        for p in paths:
            held.setdefault(p, []).append(f"building #{n}")
    for n, paths in sorted(others.items()):
        for p in paths:
            held.setdefault(p, []).append(f"elsewhere #{n}")
    for p in cfg.exclusive_holds:
        held.setdefault(plain(p), []).append("an exclusive hold")
    return held


def is_shared(cfg, path: str) -> bool:
    return any(fnmatch.fnmatch(path, g) or path == g for g in cfg.shared_files)


def report(held: dict, candidates: list, cfg) -> int:
    for p, who in held.items():
        print(f"{p} (held by {', '.join(who)})")
    if not held:
        print("none")
    counted = 0
    for c in candidates:
        for p, who in held.items():
            if covers(p, c):
                shown = f"{c} (held by {', '.join(who)})"
                if is_shared(cfg, c):
                    print(f"shared (not counted): {shown}")
                else:
                    print(f"overlap: {shown}")
                    counted += 1
    if not counted:
        print("overlap: none")
    return 1 if counted else 0


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--touch-map", nargs="+", metavar="PATH", help="the ticket's touch-map entries (`path:line` is fine)")
    ap.add_argument("--ticket", type=int, help="the ticket number, to leave out its own PR and touch map")
    ap.add_argument("--pr", help="check this PR's diff against the others (the pre-merge check)")
    ap.add_argument("--repo", default=".", help="the repo root (default: the current directory)")
    ap.add_argument("--state", help=f"the state file (default: <repo>/{STATE})")
    args = ap.parse_args(argv)
    if bool(args.pr) == bool(args.touch_map is not None):
        ap.error("give --touch-map (with --ticket) or --pr, not both or neither")
    if args.touch_map is not None and args.ticket is None:
        ap.error("--touch-map needs --ticket")
    repo = Path(args.repo)
    cfg = config.Config.load(repo)
    try:
        base = github.default_branch(cwd=repo)
        own_pr, own_ticket = None, args.ticket
        if args.pr:
            own_pr = common.pr_ref(args.pr)[0]
            view = github.pr_view(own_pr, "headRefName", cwd=repo)
            own_ticket = ticket_of_branch(view.get("headRefName"))
            candidates = github.pr_files(own_pr, cwd=repo)
        else:
            candidates = [plain(e) for e in args.touch_map if plain(e) and plain(e).lower() != "none"]
        prs, open_heads = {}, []
        for pr in github.open_prs(base, cwd=repo):
            if not isinstance(pr, dict) or not isinstance(pr.get("number"), int):
                raise github.GhError(github.MALFORMED, "gh returned a PR list entry without a number")
            open_heads.append(pr.get("headRefName"))
            if str(pr["number"]) == str(own_pr) or (own_ticket is not None and ticket_of_branch(pr.get("headRefName")) == own_ticket):
                continue
            prs[pr["number"]] = github.pr_files(pr["number"], cwd=repo)
        tickets = still_building(building(Path(args.state) if args.state else repo / STATE, own_ticket),
                                 {ticket_of_branch(h) for h in open_heads}, base, repo)
        # Tickets already held through a PR or the state file, and this ticket's own: a live worker on one of
        # those is not a second hold.
        skip = {ticket_of_branch(h) for h in open_heads} | {own_ticket} | {int(n) for n in tickets if str(n).isdigit()}
        others = elsewhere(repo, base, skip)
    except github.GhError as e:
        print(f"holds: gh: {e.message}", file=sys.stderr)
        return 2
    except ValueError as e:
        print(f"holds: {e}", file=sys.stderr)
        return 2
    return report(held_paths(cfg, prs, tickets, others), candidates, cfg)


if __name__ == "__main__":
    sys.exit(main())
