#!/usr/bin/env python3
"""merge <pr> [--method squash|merge|rebase] [--approved-head SHA] [--ticket N]... [--worktree DIR] : merge a PR, then clean up.

With --approved-head (the PR head the reviewer approved; the orchestrator always passes it) the script
first decides readiness and merges nothing unless the PR is ready: CI not green on the head (a check
pending, failed, cancelled or missing, or no checks at all while the head has workflow files; no checks and no workflow files is green, `ci: none configured`) or an open blocker on the PR's ticket (the
branch's `<number>-` prefix, else the PR's closing reference), or an unresolved review thread (outdated or not, any author; the count line, then one
`  <author> <url>` line each), is a refusal (exit 1, the clause named); a PR behind the default branch is
updated through the host's update-branch (exit 5); the PR's own change since the approved head (what it adds to the
default branch at each head, compared, so merges of the default branch count for nothing) that touches a config risk path or exceeds the S thresholds
needs re-review (exit 6). Without the flag it merges as before.

`gh pr merge`'s exit is unreliable (a 502 can hide a merge that landed; a retry can answer "merge
already in progress"; the branch can survive), so the PR's state is the only truth. The script runs
the merge, then re-checks the PR until it is MERGED or --timeout runs out. Only once MERGED does it:
delete the remote branch (over `gh api`, so it works where origin is SSH) and the local one, unless it
is the default branch, main/master or a fork's branch; close the PR's linked tickets that the host
left open (a --ticket the PR does not link is only reported); remove --worktree only when it is a linked worktree of this repo (not the main checkout, no live foreign lock) on the PR's branch, or on `worktree-agent-<id>` or detached with HEAD at the PR head (else one `NOT removed` line; a "not a working tree" answer is fine: the harness may
have removed it; a harness-locked tree is unlocked first, then removed plainly, never forced), and append one `merge` event (ref = the PR number, outcome merged|timeout|closed,
plus branch, branch_deleted, tickets). The reviewer's scratch worktrees (detached, named `pr-<n>`, `pr-<n>b`, `pr-<n>-<suffix>`) are removed after a merge and also when the PR is found
closed unmerged (so `merge <pr>` after an `ABANDON`'s `gh pr close` cleans them), each through the same checks as --worktree (a worktree of this repo, no live foreign lock, HEAD at the PR head or an ancestor of it) and
plainly, never forced: one `scratch worktree <path> removed` line each, or `scratch worktree <path> NOT removed: <why>` when it is dirty, locked by another live session or not in the PR (the tree is kept for a human). The merge passes the approved head as `sha`, so a push after
review is a refusal (a 409; exit 1). Prints one line per step.
After the cleanup it sweeps (see replay.py): each other open PR whose branch now conflicts with the
default branch is updated and pushed, shared-file conflicts resolved by replay, one `replay` event per
file and outcome (line-replay|word-merge|handed-back). The method decides how: squash and merge
merge main into the branch (a plain push); rebase rebases it and pushes with --force-with-lease.
A conflict the script can't resolve (a file that isn't shared, or overlapping words) aborts that
branch's update and prints `HANDBACK PR #n <branch>: <path> (<why>)` per file.
After the sweep, each --also-approved PR=SHA (a PR the reviewer approved at that head, still waiting to merge)
that is open, at that head (or with only merges of the default branch since) and behind the default branch is brought up to date with `gh pr update-branch`
too, so their CI runs at the same time instead of one merge after another: one `PR #<n> updated (behind by <k>);
wait for CI` line each. A PR that is behind and DIRTY is not updated: its line says to hand it back. An
unapproved PR, or one pushed to since its approval, is left alone. None of this changes the exit code.
Exit codes: 0 merged and cleaned up; 4 the same, but a swept branch was handed back (resume its worker
with the printed conflict list); 5 behind the default branch, branch updated: wait for CI, then run
again; 6 the change since --approved-head needs re-review (nothing merged); 1 the merge was refused (or the branch update for exit 5 failed; the output says why);
2 the script could not run (`gh` is missing or cannot read the PR, or with --approved-head readiness could not be decided, e.g. a failed compare call or review-threads read: run it again; the error goes to stderr); 3 still not MERGED at the timeout (run it
again later; nothing was closed or deleted). A PR found closed unmerged is cleaned up (scratch trees) and ends
`next: cleaned <pr>`, exit 0. A merge failure that looks transient (5xx, timeout,
"already in progress") only means wait and re-check; the merge command is run again on a 5xx.
Every run ends with exactly one `next:` line, the verdict the orchestrator applies word for word: `merged` |
`wait-ci <pr> <head>` | `re-review <pr>` | `send-back <pr>` (the lines above it are what the PR's owner gets) |
`ask-user <why>` | `retry` | `retry-after <time>` (a rate limit, exit 2) | `could-not-run [<Class>: <message>]` (exit 2;
an exception is this, with the traceback on stderr, never `ask-user`). Before it, one `also: <verdict> <pr> ...` line per other PR the run
touched (--also-approved, the sweep): `wait-ci <pr> <head>`, `send-back <pr>` or `left <pr> <why>`. The exit codes
are unchanged: 0 and 4 end `merged`, 5 `wait-ci`, 6 `re-review`, 3 `retry`, 2 `could-not-run`, and 1 (a refusal)
`wait-ci`, `send-back` or `ask-user` by its clause.
After the cleanup it also fast-forwards the main checkout (the first `git worktree list` entry) to origin/<default>, so the
scripts the orchestrator runs and the files a lead reads are the merged code: one line, `main checkout fast-forwarded to <sha>`
or `main checkout not updated (<reason>)`. It skips, never stashes, resets or fails the merge, when the checkout is dirty, on
another branch, mid merge/rebase, or the update is not a fast-forward.
`merge --fast-forward-only` does only that fast-forward (no PR, no session) and prints the same one line: exit 0 when the
checkout moved, was current or is ahead of origin, exit 1 when a guard refused. The run's first pass calls it before it reads the config.
Stdlib only, Python 3.9+.
"""

import argparse
import difflib
import json
import os
from pathlib import Path
import re
import sys
import time
import traceback

import common
import config
import github
import replay
import repo
import runlog
import tracker
from repo import remove_scratch, remove_worktree, worktree_gone, worktree_refusal

# "already merged" after a 5xx: the first attempt landed and the retry found it so; wait and re-check.
IN_PROGRESS = re.compile(r"already in progress|already merged", re.I)
PROTECTED = ("main", "master")
# A 5xx is the status gh prints ("HTTP 502", "(HTTP 502)"), never a bare number: a PR or ticket number is not one.
TRANSIENT = re.compile(r"\bHTTP 5\d\d\b|bad gateway|service unavailable|gateway time-?out|timed? ?out|"
                       r"connection (?:reset|refused)|try again|base branch was modified", re.I)


run = common.run  # (code, stdout, stderr); a missing gh or git is code 127, not a traceback


def view(pr, cwd):
    """(view, "") or (None, why); a failed or unusable `gh pr view` is never a traceback."""
    try:
        return github.pr_view(pr, "state,headRefName,headRefOid,isCrossRepository,closingIssuesReferences,statusCheckRollup", cwd), ""
    except github.GhError as e:
        return None, e.message


def default_branch(cwd):
    """The repo's default branch name, or None when gh can't say (callers then delete nothing)."""
    try:
        return github.default_branch(cwd)
    except github.GhError:
        return None


def delete_remote_branch(branch, cwd):
    """Delete the remote branch. Returns (deleted, note); "already gone" counts as deleted."""
    try:
        return True, github.delete_branch(branch, cwd)
    except github.GhError as e:
        return False, f"NOT deleted: {e.message}"


def delete_local_branch(branch, cwd):
    """`git branch -D` unless the branch is absent or checked out in some worktree."""
    if run("git", "rev-parse", "--verify", "--quiet", f"refs/heads/{branch}", cwd=cwd).returncode != 0:
        return "local branch already gone"
    if any(wt["branch"] == branch for wt in common.worktrees(cwd)):
        return f"local branch {branch} kept: checked out in a worktree"
    d = run("git", "branch", "-D", branch, cwd=cwd)
    return f"local branch {branch} " + ("deleted" if d.returncode == 0 else f"NOT deleted: {common.one_line(d.stderr)}")


def say(msg):
    print(msg, flush=True)


def log_event(cwd, kind, outcome, **fields):
    """Append a run-log event; with no session say so on stderr and carry on (the merge verdict stands)."""
    try:
        runlog.append_event(cwd, kind, outcome, **fields)
    except runlog.NoSession as e:
        print(e, file=sys.stderr, flush=True)


# The run's verdict, printed by main() as the `also:` lines and then the one `next:` line.
VERDICT = {"next": None, "also": [], "pr": "?"}


def verdict(text):
    VERDICT["next"] = text


def also(text):
    VERDICT["also"].append(text)


def why_of(text):
    """One line for an `ask-user <why>` verdict."""
    return common.one_line(text) or "see the output above"


def own_changes(cwd, approved, head, default):
    """(files, lines) the PR changed from `approved` to `head`, or None when git can't say.

    Compares what the PR adds to the default branch at each head (see pr_patch), so a merge of the
    default branch (the sweep's, or update-branch) contributes nothing, even in a file the PR also
    changes far from the PR's hunks; a rebase that kept the same change counts nothing either. Every
    file whose patch differs between the two heads counts as a file (so it meets the risk-path check),
    even when only its mode changed or it is an empty file added or removed; its lines are the patch
    +/- lines that differ (context fixes where each sits, so a moved line counts), at least one. (set(), 0) means the PR's
    own change is the same at both heads. An unknown SHA or a failed git call gives None, which callers
    treat as needing re-review.
    """
    run("git", "fetch", "--quiet", "origin", cwd=cwd)
    old, new = pr_patch(cwd, approved, default), pr_patch(cwd, head, default)
    if old is None or new is None:
        return None
    files, lines = set(), 0
    for path in set(old) | set(new):
        a, b = old.get(path, ()), new.get(path, ())
        if a == b:
            continue
        files.add(path)
        # Changed lines only (not context, mode or file-name rows); a file that differs counts at least one,
        # so a moved block (same +/- rows, other context) is one line with its file counted.
        n = sum(1 for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, a, b, autojunk=False).get_opcodes()
                if tag != "equal" for row in a[i1:i2] + b[j1:j2]
                if row[:1] in ("+", "-") and not row.startswith(("+++ ", "--- ")))
        lines += max(n, 1)
    return files, lines


def pr_patch(cwd, sha, default):
    """{file: tuple of patch lines} the PR adds on top of `origin/<default>` at `sha`, or None.

    The diff from the merge base of `sha` and the default branch to `sha`, so what the default branch
    brought in is not in it. Each file's tuple is its patch with the context lines, the mode lines and
    a bare `@@` for each hunk header: the line numbers (which shift when the default branch edits the
    file elsewhere) and blob hashes are dropped, the position of every change is kept by its context.
    """
    base = run("git", "merge-base", f"origin/{default}", sha, cwd=cwd)
    if base.returncode != 0 or not base.stdout.strip():
        return None
    diff = run("git", "diff", "--no-renames", "--no-color", "--no-ext-diff", "-U3", "--src-prefix=a/", "--dst-prefix=b/", base.stdout.strip(), sha, cwd=cwd)
    if diff.returncode != 0:
        return None
    files, cur, index = {}, None, ""
    for row in diff.stdout.splitlines():
        if row.startswith("diff --git "):
            cur = files.setdefault(row.rpartition(" b/")[2], [])
        elif cur is None:
            continue
        elif row.startswith("index "):
            index = row  # a blob hash: kept only for a binary file, whose change shows nowhere else
        elif row.startswith("Binary files"):
            cur += [index, row]
        elif row.startswith("@@"):
            cur.append("@@")
        else:
            cur.append(row)
    return {path: tuple(rows) for path, rows in files.items()}


def merge_rule(cwd, pr, v, head):
    """Exit code 1 (or 2: could not read) when CI is not green on the head or the PR's ticket has an open blocker, else None."""
    rollup = v.get("statusCheckRollup")
    ci, names = github.ci_verdict(rollup)
    if not rollup:
        # An empty rollup is green only when the head has no workflow files (ADR-0012): a repo that cannot
        # report checks passes, one that can but has not reported yet stays pending. One contents call, only here.
        try:
            configured = github.has_workflows(head, cwd=cwd)
        except github.GhError as e:
            say(f"merge: could not read the workflow files of {head[:12]} for PR #{pr}: {e.message}")
            return 2
        if not configured:
            say(f"PR #{pr}: ci: none configured (no workflow files on {head[:12]})")
        else:
            say(f"PR #{pr} is not ready: ci: pending on {head[:12]}: workflows exist but no checks reported yet")
            verdict(f"wait-ci {pr} {head}")
            return 1
    elif ci != "pass":
        say(f"PR #{pr} is not ready: CI {ci} on {head[:12]}: {', '.join(names) or 'no checks'}")
        verdict(f"wait-ci {pr} {head}" if ci == "pending" else f"send-back {pr}")
        return 1
    ticket = repo.ticket_of_branch(v.get("headRefName"))
    if ticket is None:
        refs = [r.get("number") for r in v.get("closingIssuesReferences") or [] if isinstance(r.get("number"), int)]
        ticket = refs[0] if refs else None
    if ticket is None:
        return None  # no ticket, no dependency to wait for
    try:
        blockers = tracker.Snapshot(cwd).blockers(ticket)
    except (github.GhError, KeyError, TypeError, ValueError) as e:
        say(f"merge: could not read the blockers of #{ticket} for PR #{pr}: {getattr(e, 'message', e)}")
        return 2
    if blockers:
        say(f"PR #{pr} is not ready: ticket #{ticket} has {len(blockers)} open blocker(s): "
            + " ".join(f"#{n} (body)" if from_body else f"#{n}" for n, from_body in blockers))
        verdict(f"ask-user ticket #{ticket} has {len(blockers)} open blocker(s)")
        return 1
    return None


def threads_rule(cwd, pr):
    """Exit code 1 (or 2: could not read) when the PR has an unresolved review thread, else None.
    Outdated threads and any author count; top-level PR comments are not threads."""
    try:
        threads = github.review_threads(pr, cwd=cwd)
    except github.GhError as e:
        say(f"merge: could not read the review threads of PR #{pr}: {e.message}")
        return 2
    unresolved = [t for t in threads if not t["resolved"]]
    if not unresolved:
        return None
    say(f"PR #{pr} is not ready: {len(unresolved)} unresolved review thread(s)")
    for t in unresolved:
        first = t["comments"][0] if t["comments"] else {}
        # ADR-0015: an untrusted thread blocks too (an outsider can only stall a merge); named so the developer resolves it.
        mark = "" if t.get("trusted", True) else " (untrusted author: the developer resolves or dismisses it)"
        say(f"  {first.get('author') or 'ghost'} {first.get('url') or '?'}{mark}")
    if not any(t.get("trusted", True) for t in unresolved):
        # A worker never addresses an untrusted thread, so sending it back would loop: the developer decides.
        verdict(f"ask-user PR #{pr} has only untrusted unresolved review threads; resolve or dismiss them")
        return 1
    verdict(f"send-back {pr}")
    return 1


HEAD_POLLS = 3  # reads of the PR head after an update-branch before giving up on seeing it move
HEAD_GAP = 2.0  # seconds between those reads
UPDATE_WINDOW = 120  # seconds in which a second update-branch of the same PR is refused while the first may be in flight
UPDATES_FILE = ".claude/orchestrate-update-branch.json"  # {pr: {"from": head, "at": epoch seconds}}, beside the state file


def new_head(cwd, pr, old, gap=HEAD_GAP):
    """The PR's head after a branch update (what the CI to wait for runs on): read up to HEAD_POLLS times, `gap`
    seconds apart, until it differs from `old`. `?` when gh can't say or the head never moved: the host may apply the
    update after the call returns, and the old head's green CI must not be waited on (`watch-ci <pr> ?` pins no head,
    and a rerun then refuses a second update-branch, see `update_in_flight`)."""
    for i in range(HEAD_POLLS):
        if i:
            time.sleep(gap)
        try:
            head = github.pr_view(pr, "headRefOid", cwd).get("headRefOid")
        except github.GhError:
            continue
        if head and head != old:
            return head
    return "?"


def _updates_path(cwd):
    return repo.main_checkout(cwd) / UPDATES_FILE


def _read_updates(cwd):
    try:
        data = json.loads(_updates_path(cwd).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


UPDATE_KEEP = 1800  # seconds an entry of the in-flight file lives; an older one is ignored and dropped


def _write_updates(cwd, data):
    try:
        path = _updates_path(cwd)
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(data), encoding="utf-8")
    except OSError:
        pass


def clear_update(cwd, pr):
    """Forget the update-branch record of `pr`: it merged or closed, so nothing of it is in flight any more."""
    data = _read_updates(cwd)
    if data.pop(str(pr), None) is not None:
        _write_updates(cwd, data)


def record_update(cwd, pr, head):
    """Remember that update-branch ran on `pr` at `head`, so a rerun does not issue a second one while it is in flight.
    Best effort: an unwritable file only loses the guard."""
    now = time.time()
    data = {k: r for k, r in _read_updates(cwd).items()
            if isinstance(r, dict) and isinstance(r.get("at"), (int, float)) and 0 <= now - r["at"] < UPDATE_KEEP}
    data[str(pr)] = {"from": head, "at": now}
    _write_updates(cwd, data)


def update_in_flight(cwd, pr, head):
    """Seconds since the last update-branch of `pr` when it ran within UPDATE_WINDOW and the head is still the one it
    started from (the host has not applied it yet), else None."""
    rec = _read_updates(cwd).get(str(pr))
    if not isinstance(rec, dict) or rec.get("from") != head or not isinstance(rec.get("at"), (int, float)):
        return None
    age = time.time() - rec["at"]
    return age if 0 <= age < UPDATE_WINDOW else None


def readiness(cwd, pr, v, approved, gap=HEAD_GAP):
    """Exit code 1, 2, 5 or 6 when the PR is not ready to merge against `approved`, else None (ready)."""
    default = default_branch(cwd)
    head = v.get("headRefOid") or ""
    if default is None or not head:
        say(f"merge: cannot decide readiness for PR #{pr}: the default branch or head is unknown")
        return 2
    refusal = merge_rule(cwd, pr, v, head)
    if refusal is not None:
        return refusal
    refusal = threads_rule(cwd, pr)
    if refusal is not None:
        return refusal
    try:
        behind = github.behind_by(default, v.get("headRefName") or head, cwd)
    except github.GhError as e:
        say(f"merge: could not read behind_by for PR #{pr}: {e.message}")
        return 2
    if behind:
        age = update_in_flight(cwd, pr, head)
        if age is not None:
            say(f"PR #{pr} is behind {default} by {behind}, but update-branch ran {age:.0f}s ago and the head has not moved; "
                f"not asking again within {UPDATE_WINDOW}s; wait for CI, then run merge again")
            verdict(f"wait-ci {pr} ?")
            return 5
        try:
            github.update_branch(pr, cwd)
        except github.GhError as e:
            say(f"PR #{pr} is behind {default} by {behind} and update-branch failed: {e.message}")
            # A fork's branch can't be updated by the host or pushed to by the worker: sending it back would loop.
            verdict(f"ask-user PR #{pr} is a fork; its branch can't be updated" if v.get("isCrossRepository")
                    else f"send-back {pr}")
            return 1
        record_update(cwd, pr, head)
        say(f"PR #{pr} was behind {default} by {behind}; branch updated; wait for CI, then run merge again")
        verdict(f"wait-ci {pr} {new_head(cwd, pr, head, gap)}")
        return 5
    changes = own_changes(cwd, approved, head, default)
    if changes is None:
        say(f"PR #{pr} needs re-review: the approved head {approved[:12]} or the head is unknown to git")
        verdict(f"re-review {pr}")
        return 6
    files, lines = changes
    cfg = config.Config.load(cwd)
    risky = sorted(f for f in files if replay.is_shared(f, cfg.risk_paths))
    over = cfg.tier_s_lines is not None and cfg.tier_s_files is not None \
        and (lines > cfg.tier_s_lines or len(files) > cfg.tier_s_files)
    if risky or over:
        why = f"touches risk path(s) {', '.join(risky)}" if risky else \
            f"changed {lines} line(s) in {len(files)} file(s), over the S thresholds"
        say(f"PR #{pr} needs re-review: its change since the approved head {approved[:12]} {why}")
        verdict(f"re-review {pr}")
        return 6
    say(f"PR #{pr} is up to date, and its change since the approved head is within the S thresholds")
    return None


def main(argv=None) -> int:
    """Run the merge, then print the `also:` lines and the one `next:` line (see the module docstring)."""
    if "--fast-forward-only" in (sys.argv[1:] if argv is None else argv):
        return run_fast_forward_only(argv)
    VERDICT["next"], VERDICT["also"], VERDICT["pr"] = None, [], "?"
    github.rate_limited_until = None
    try:
        code = run_merge(argv)
    except Exception as e:  # a verdict line must always exist, even when the merge had landed (the traceback is on stderr)
        # A program error is not a merge refusal: `ask-user` is only ever a real decision.
        traceback.print_exc()
        verdict(f"could-not-run {type(e).__name__}: {why_of(str(e))}")
        code = 2
    except SystemExit as e:  # common.die (2) or an argparse usage error (2); --help (0) prints no verdict
        if e.code in (0, None):
            raise
        code = e.code if isinstance(e.code, int) else 2
    for line in VERDICT["also"]:
        word, _, rest = line.partition(" ")
        common.also(word, rest)
    # A path that set no verdict falls back on its exit code: 3 timed out, 0 merged, a rate limit retries after its
    # time, anything else could not run.
    until = github.rate_limit_verdict(code)
    fallback = {0: "merged", 3: "retry"}.get(code) or ("retry-after " + until if until else "could-not-run")
    word, _, rest = (VERDICT["next"] or fallback).partition(" ")
    return common.verdict(word, rest, exit_code=code)


def run_fast_forward_only(argv=None) -> int:
    """`merge --fast-forward-only`: the run's first pass brings a stale main checkout up to date before it reads the
    config (the skill runs no git itself, ADR-0006). One line, no verdict; exit 0 when the checkout moved, was
    current or is ahead, 1 when a guard refused (the run goes on with the stale tree and says so)."""
    ap = argparse.ArgumentParser(description="fast-forward the main checkout to origin/<default branch>", allow_abbrev=False)
    ap.add_argument("--fast-forward-only", action="store_true", required=True)
    ap.add_argument("--cwd", default=".", help="the repo (default: current directory)")
    args = ap.parse_args(argv)
    ok, line = fast_forward_result(args.cwd, default_branch(args.cwd))
    say(line)
    return 0 if ok else 1


def run_merge(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0], allow_abbrev=False)
    ap.add_argument("pr", help="PR number")
    ap.add_argument("--method", default="squash", choices=["squash", "merge", "rebase"])
    ap.add_argument("--approved-head", help="the PR head the reviewer approved: decide readiness first (exit 5 behind and updated, 6 needs re-review)")
    ap.add_argument("--ticket", action="append", default=[], help="a ticket the PR must link; one it does not link is reported, not closed (repeatable)")
    ap.add_argument("--also-approved", action="append", default=[], metavar="PR=SHA",
                    help="another approved PR and the head approved; after this merge it is updated if behind (repeatable)")
    ap.add_argument("--worktree", help="the worker's worktree to remove after the merge")
    ap.add_argument("--fast-forward-only", action="store_true",
                    help="no PR: only fast-forward the main checkout to origin/<default branch> (handled before this parser; exit 1 when a guard refuses)")
    ap.add_argument("--cwd", default=".", help="the repo (default: current directory)")
    ap.add_argument("--timeout", type=float, default=300, help="seconds to wait for MERGED")
    ap.add_argument("--interval", type=float, default=5, help="seconds between state checks")
    args = ap.parse_args(argv)
    pr, ref = common.pr_ref(args.pr)
    VERDICT["pr"] = pr
    cwd = args.cwd
    # Before the irreversible step: the merged event is written after the merge, and a missing session
    # would otherwise exit 2 on a merge that happened, before the sweep ran (#341).
    if not runlog.current_session(cwd):
        common.die(f"merge: no session in {runlog.STATE} under {runlog.main_checkout(cwd)}; "
                          "run rebuild-state first")

    v, why = view(pr, cwd)
    if v is None:
        print(f"merge: could not read PR #{pr} with gh: {why}", file=sys.stderr)
        return 2
    branch = v.get("headRefName") or ""
    state = v.get("state")
    head_oid = v.get("headRefOid") or ""
    if args.approved_head and state == "OPEN":
        code = readiness(cwd, pr, v, args.approved_head, min(HEAD_GAP, args.interval))
        if code is not None:
            return code
    deadline = time.monotonic() + args.timeout
    attempt = state == "OPEN"  # run the merge command only while the PR is open
    refused = None
    while True:
        github.reset_wait_budget()  # a poll of a loop that can run for hours gets its own wait budget
        if attempt:
            try:
                github.merge_pr(pr, args.method, head_oid, cwd)
                err = None
            except github.GhError as e:
                if e.kind == github.MISSING:  # gh vanished mid-run: not a refusal
                    print(f"merge: could not run gh: {e.message}", file=sys.stderr)
                    return 2
                err = e.message
            if err is None:
                say(f"merge command accepted for PR #{pr}")
                attempt = False
            elif IN_PROGRESS.search(err):
                say(f"merge already in progress for PR #{pr}; waiting")
                attempt = False
            elif TRANSIENT.search(err):
                say(f"merge command failed transiently ({err}); re-checking")
            else:
                refused, attempt = err, False  # a real refusal, unless the state says it landed anyway
        nv, _ = view(pr, cwd)
        if nv:
            v, state = nv, nv.get("state")
        if state in ("MERGED", "CLOSED"):
            clear_update(cwd, pr)
        if state == "MERGED":
            break
        if state == "CLOSED":
            say(f"PR #{pr} closed without merging")
            # A reviewer's scratch trees would otherwise pile up: nothing else removes them for a PR that never merges.
            for line in remove_scratch(pr, head_oid, cwd):
                say(f"scratch {line}")
            log_event(cwd, "merge", "closed", ref=ref, branch=branch)
            verdict(f"cleaned {pr}")  # a clean end, not an error: the skill's ABANDON reads the verdict
            return 0
        if refused:
            say(f"merge refused for PR #{pr}: {refused}")
            verdict(f"ask-user {why_of(f'merge refused for PR #{pr}: {refused}')}")
            return 1
        if time.monotonic() >= deadline:
            say(f"PR #{pr} not MERGED after {args.timeout:g}s (state {state}); run merge again later")
            log_event(cwd, "merge", "timeout", ref=ref, branch=branch)
            return 3
        time.sleep(args.interval)

    say(f"PR #{pr} MERGED")

    # Never delete a branch name we can't vouch for: the default branch, main/master, a fork's branch.
    default = default_branch(cwd)
    safe = bool(branch) and default is not None and branch != default and branch not in PROTECTED \
        and not v.get("isCrossRepository")
    deleted = False
    if safe:
        deleted, note = delete_remote_branch(branch, cwd)
        say(f"remote branch {branch} {note}")
    else:
        say(f"remote branch {branch or '?'} left alone (default, protected name, fork, or default unknown)")

    tickets = []
    for r in v.get("closingIssuesReferences") or []:
        if str(r.get("number")) not in tickets:
            tickets.append(str(r.get("number")))
    for t in (x.lstrip("#") for x in args.ticket):
        if t not in tickets:
            say(f"ticket #{t} is not linked by PR #{pr}; not closed")
    for t in tickets:
        try:
            is_open = github.issue_state(t, cwd) == "OPEN"
        except github.GhError as e:
            say(f"ticket #{t}: could not read ({e.message})")
            continue
        if not is_open:
            say(f"ticket #{t} already closed")
            continue
        try:
            github.close_issue(t, cwd)
            say(f"ticket #{t} closed")
        except github.GhError as e:
            say(f"ticket #{t} NOT closed: {e.message}")

    if args.worktree:
        if worktree_gone(args.worktree, cwd):
            say(f"worktree {args.worktree} already gone")
        else:
            refusal = worktree_refusal(args.worktree, branch, head_oid, cwd)
            say(f"worktree {args.worktree} NOT removed: {refusal}" if refusal else remove_worktree(args.worktree, cwd))
    # The reviewer's pr-<n> scratch trees: the guard refuses it `git worktree remove`, so the merge does (ADR-0004).
    for line in remove_scratch(pr, head_oid, cwd):
        say(f"scratch {line}")

    # After the worktree is gone, so the branch it held is free to delete.
    if safe:
        say(delete_local_branch(branch, cwd))

    log_event(cwd, "merge", "merged", ref=ref, branch=branch, branch_deleted=deleted,
              tickets=[int(t) for t in tickets if t.isdigit()])
    say(fast_forward_main(cwd, default))
    handed = sweep(cwd, pr, branch, default, args.method)
    update_approved(cwd, pr, default, args.also_approved, min(HEAD_GAP, args.interval))
    verdict("merged")
    return 4 if handed else 0


def fast_forward_main(cwd, default):
    """One line: the main checkout fast-forwarded to origin/<default>, or why it was left alone. Never raises, never discards work."""
    return fast_forward_result(cwd, default)[1]


def fast_forward_result(cwd, default):
    """(ok, line). ok is False when a guard refused (the line starts `main checkout not updated`); True when the
    checkout moved, was already current, or is ahead of origin (nothing stale to fix)."""
    if not default:
        return False, "main checkout not updated (default branch unknown)"
    trees = common.worktrees(cwd)
    if not trees:
        return False, "main checkout not updated (cannot list worktrees)"
    main = trees[0]["path"]
    if trees[0]["branch"] != default:
        return False, f"main checkout not updated (on {trees[0]['branch'] or 'a detached HEAD'}, not {default})"
    for marker in ("MERGE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD", "rebase-merge", "rebase-apply"):
        r = run("git", "rev-parse", "--git-path", marker, cwd=main)
        if r.code == 0 and (Path(main) / r.stdout.strip()).exists():
            return False, "main checkout not updated (a merge or rebase is in progress)"
    # Tracked changes only: git itself refuses a fast-forward that would overwrite an untracked file.
    r = run("git", "status", "--porcelain", "--untracked-files=no", cwd=main)
    if r.code != 0:
        return False, "main checkout not updated (git status failed)"
    if r.stdout.strip():
        return False, "main checkout not updated (uncommitted changes)"
    r = run("git", "fetch", "-q", "origin", default, cwd=main)
    if r.code != 0:
        return False, "main checkout not updated (fetch failed)"
    before = run("git", "rev-parse", "HEAD", cwd=main).stdout.strip()
    if run("git", "merge-base", "--is-ancestor", f"origin/{default}", "HEAD", cwd=main).code == 0:
        # HEAD already holds origin's tip: equal, or local commits on top of it.
        if before == run("git", "rev-parse", f"origin/{default}", cwd=main).stdout.strip():
            return True, "main checkout already up to date"
        return True, "main checkout not updated (ahead of origin)"
    r = run("git", "merge", "--ff-only", "-q", f"origin/{default}", cwd=main)
    if r.code != 0:
        # git's own reason (a diverged history, an untracked file in the way), not a guess.
        lines = [l for l in (r.stderr.strip() or r.stdout.strip()).splitlines() if not l.startswith("hint:")]
        return False, f"main checkout not updated ({common.one_line(lines[0]) if lines else 'git refused the fast-forward'})"
    r = run("git", "rev-parse", "--short", "HEAD", cwd=main)
    return True, f"main checkout fast-forwarded to {r.stdout.strip()}"


def update_approved(cwd, merged_pr, default, specs, gap=HEAD_GAP):
    """Update each approved PR (`PR=SHA` in `specs`) that is behind `default`, so their CI runs together.

    Only a PR still open, in this repo and still at its approved head is touched: a push since the
    approval is not ours to carry. A DIRTY one is reported, never updated (update-branch would fail).
    Nothing here can fail the merge, which has already landed.
    """
    for spec in specs:
        n, _, sha = spec.partition("=")
        n = n.lstrip("#")
        if not n.isdigit() or not sha:
            say(f"also-approved {spec!r} skipped: expected PR=SHA")
            also(f"left {n or '?'} expected PR=SHA")
            continue
        if n == str(merged_pr) or default is None:
            continue  # the PR just landed, or the default branch is unknown: nothing to update
        try:
            v = github.pr_view(n, "state,headRefName,headRefOid,isCrossRepository,mergeStateStatus", cwd)
            if v.get("state") != "OPEN" or v.get("isCrossRepository"):
                say(f"PR #{n} left alone: not open or a fork")
                also(f"left {n} not open or a fork")
                continue
            if v.get("headRefOid") != sha and own_changes(cwd, sha, v.get("headRefOid") or "", default) != (set(), 0):
                # The re-review rule: merges of the default branch (update-branch) are not a push.
                say(f"PR #{n} left alone: its head is no longer the approved one (pushed to since the approval)")
                also(f"left {n} pushed to since the approval")
                continue
            behind = github.behind_by(default, v.get("headRefName") or sha, cwd)
            if not behind:
                continue
            if v.get("mergeStateStatus") == "DIRTY":
                say(f"PR #{n} is behind {default} by {behind} and DIRTY; not updated: hand it back to its worker")
                also(f"send-back {n}")
                continue
            github.update_branch(n, cwd)
            say(f"PR #{n} updated (behind by {behind}); wait for CI")
            record_update(cwd, n, v.get("headRefOid"))
            also(f"wait-ci {n} {new_head(cwd, n, v.get('headRefOid'), gap)}")
        except github.GhError as e:
            say(f"PR #{n} not updated: {e.message}")
            also(f"left {n} not updated: {why_of(e.message)}")


def sweep(cwd, merged_pr, merged_branch, default, method):
    """Update every other open PR on the default branch that now conflicts. True if any was handed back.

    A branch that is merely behind is left alone. Fork branches can't be pushed to and are skipped.
    """
    if default is None:
        say("sweep skipped: the default branch is unknown")
        return False
    rules = replay.Rules.from_config(config.Config.load(cwd))
    try:
        prs = github.open_prs(default, cwd)
    except github.GhError as e:
        say(f"sweep skipped: could not list open PRs ({e.message})")
        return False
    common.run("git", "fetch", "--prune", "origin", cwd=cwd)
    handed = False
    for r in prs:
        n, b = r.get("number"), r.get("headRefName") or ""
        if str(n) == str(merged_pr) or b == merged_branch or not b or b in PROTECTED or b == default \
                or r.get("isCrossRepository"):
            continue
        if r.get("isDraft"):
            continue  # a draft is still being built: its worker is pushing, and it enters review when marked ready
        result = replay.sweep_branch(cwd, default, b, method, rules)
        if result.status == "skipped":
            say(result.note)
            return False
        if result.status == "unchecked":
            say(f"sweep: PR #{n} {b}: could not check for conflicts; left alone")
            continue
        for path, outcome in result.events:
            log_event(cwd, "replay", outcome, ref=n, branch=b, file=path)
        if result.status == "updated":
            say(f"sweep: PR #{n} {b} updated" + (" (force-with-lease)" if method == "rebase" else ""))
        elif result.status == "handed-back":
            handed = True
            also(f"send-back {n}")
            say(f"sweep: PR #{n} {b} NOT updated")
            for line in result.handback_lines(f"PR #{n} {b}"):
                say(line)
    return handed


if __name__ == "__main__":
    sys.exit(main())
