#!/usr/bin/env python3
"""lead-route --lead live|none --cap <n> [--repo PATH] [--state FILE] [--now ISO] : route the lead's stops.

Decides, and prints one verdict per line; it writes nothing to the tracker or the state file. Run it once
per pass, after reconcile, and the orchestrator applies each line word for word. Reads the open issues
(newest 100 by update, one `gh api graphql`) and the state file; the stop comment is the newest comment
whose first line is the marker `> *Stopped for the lead.*`. Verdicts, in ticket order:
    RESUME #<n> <agent-id>   claimed, no needs-lead, a worker in the state file, stop comment newer than its last report
    ESCALATE #<n>            a RESUME on a haiku worker, where the body or an `## Agent Brief` comment changed after the stop
    REDISPATCH #<n>          a claimed ticket with a stop comment, no worker in the state file, no open PR, and no live worker elsewhere
    ELSEWHERE #<n> pid <p>   what would be a REDISPATCH, but the worktree on the ticket's branch is locked by a live session
                             (pid <p>; `?` when the lock reason doesn't parse): another session's worker is still building.
                             Do nothing; the ticket still counts against the cap (ADR 0009)
    FALLBACK #<n>            needs-lead with --lead none: the lead is gone; the ticket is handed back
    UNCAP #<n>               needs-lead, claimed, live lead, stop comment more than 30 minutes old
    HANDBACK #<n> blocked-by #<m>...  claimed, open blockers (the lead split it): hand it back, keep the branch
    ABANDON #<n>             closed `wontfix` while still claimed: stop the worker, close its PR unmerged, keep the branch
    HOLD-PR #<n> <pr>        needs-lead from an ADR conflict, an open PR, live lead: hold the PR before merge, no time limit
    ASK-DEV #<n> <pr>        the same with --lead none: the developer decides; the PR stays held
    LEAD-TICKET #<n>         claimed `lead` ticket with no open PR: the lead's work; no worker, never stalled
    LEAD-PR #<n> <pr>        claimed `lead` ticket with its open PR: the PR joins the pipeline (CI, gate, review, merge)
    RESEND #<n> <pr>         live lead, a lead PR whose newest `> *Waiting on lead (not delivered).*` names its current
                             head and no `> *Resent to lead.*` names that head yet: send the failure again, once per head
A narrowed or reworded ticket needs no verdict of its own: it is a RESUME. The ADR-conflict comment is the one
whose first line is `> *ADR conflict held for the lead.*`; a needs-lead ticket whose newest such comment is newer
than its newest stop comment is held by a conflict, and gets no FALLBACK or UNCAP.
Last line, always: `counted: <k> of <cap>`, where k is the claimed open tickets that still hold a slot
(not `lead` tickets, not UNCAP, not FALLBACK, not HANDBACK, not ABANDON). A `lead` ticket holds no slot: no worker
is dispatched for it. With --lead none and nothing to route, only that line prints.
--now (an ISO time) is for tests; the default is the current time.
Exit codes: 0 routed; 2 could not run (no `gh`, gh failed, no repository, an unreadable state file or
--now), one line on stderr; the orchestrator then treats lead mode as off for that pass.
Stdlib only, Python 3.9+.
"""

import argparse
import json
import re
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path

import common
import github
from repo import STATE, first_line, parse_ts, ticket_branch, ticket_of_branch

STOP_MARKER = "> *Stopped for the lead.*"  # the first line of every stop comment; run posts it verbatim
ADR_MARKER = "> *ADR conflict held for the lead.*"  # the first line of an ADR-conflict comment; run posts it verbatim
# A failure on a lead PR that run could not deliver to the lead, and the comment run posts after resending it. Both
# carry a line `head <sha>`, the head commit the failure was about: that line is what dedupes a resend.
UNDELIVERED_MARKER = "> *Waiting on lead (not delivered).*"
RESENT_MARKER = "> *Resent to lead.*"
HEAD_LINE = re.compile(r"^head ([0-9a-f]{40})$", re.MULTILINE)
BRIEF_HEADING = "## Agent Brief"
NEEDS_LEAD = "needs-lead"
LEAD_LABEL = "lead"  # a ticket the lead owns: its PR is the pipeline's, and no worker is dispatched for it
UNCAP_AFTER = timedelta(minutes=30)

# Closed `wontfix` tickets that still have an assignee: run unassigns on ABANDON, so each is routed once.
ABANDON_QUERY = """query($owner: String!, $name: String!) {
  repository(owner: $owner, name: $name) {
    issues(first: 30, states: CLOSED, labels: ["wontfix"], orderBy: {field: UPDATED_AT, direction: DESC}) {
      nodes { number assignees(first: 1) { totalCount } }
    }
  }
}"""


def edit_times(node) -> list:
    nodes = ((node or {}).get("userContentEdits") or {}).get("nodes") or []
    return [t for t in (parse_ts(n.get("editedAt")) for n in nodes) if t]


def malformed(what):
    common.die(f"lead-route: cannot run: gh returned an unexpected reply ({what})")


def load_repo(root):
    return github.repo_info(root)


def load_abandoned(root, repo):
    """Numbers of closed `wontfix` tickets that are still assigned."""
    data = github.call_json("api", "graphql", "-f", f"query={ABANDON_QUERY}",
                            "-F", f"owner={repo['owner']['login']}", "-F", f"name={repo['name']}", cwd=root)
    try:
        nodes = data["data"]["repository"]["issues"]["nodes"]
        return {int(n["number"]) for n in nodes if ((n.get("assignees") or {}).get("totalCount") or 0) > 0}
    except (KeyError, TypeError, ValueError):
        malformed("closed issues")


def load_issues(root, repo):
    """Open issues as plain dicts: number, claimed, labels, blockers, body_edits, comments (body, created, edits)."""
    nodes = github.open_issues(repo, cwd=root)
    try:
        issues = []
        for node in nodes:
            comments = [{"body": c.get("body") or "", "created": parse_ts(c.get("createdAt")),
                         "edits": edit_times(c)} for c in (node.get("comments") or {}).get("nodes") or []]
            issues.append({"number": int(node["number"]),
                           "claimed": ((node.get("assignees") or {}).get("totalCount") or 0) > 0,
                           "labels": {x["name"] for x in (node.get("labels") or {}).get("nodes") or []},
                           "blockers": sorted(int(b["number"]) for b in (node.get("blockedBy") or {}).get("nodes") or []
                                              if str(b.get("state") or "").upper() == "OPEN"),
                           "body_edits": edit_times(node), "comments": comments})
    except (KeyError, TypeError, ValueError):
        malformed("issues")
    return issues


def load_open_pr_tickets(root):
    """{ticket number: {"number": PR number, "head": head commit}} for each open PR whose branch names a ticket. A worker
    with a PR is not missing: its PR is the record."""
    prs = github.call_json("pr", "list", "--state", "open", "--limit", "200",
                           "--json", "headRefName,headRefOid,number", shape=list, cwd=root)
    found = {}
    for pr in prs:
        n = ticket_of_branch((pr or {}).get("headRefName"))
        if n is not None:
            found[n] = {"number": (pr or {}).get("number"), "head": str((pr or {}).get("headRefOid") or "")}
    return found


def load_state(path):
    """{ticket number as str: worker record}; a missing file is no workers, an unreadable one is could-not-run."""
    try:
        data = json.loads(path.read_text())
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as e:
        common.die(f"lead-route: cannot run: unreadable state file {path}: {e}")
    tickets = data.get("tickets") if isinstance(data, dict) else None
    if not isinstance(tickets, dict):
        common.die(f"lead-route: cannot run: state file {path} has no tickets object")
    return tickets


def stop_of(issue):
    stops = [c for c in issue["comments"] if c["created"] and first_line(c["body"]) == STOP_MARKER]
    return max(stops, key=lambda c: c["created"]) if stops else None


def changed_after(issue, since) -> bool:
    """The body, or an `## Agent Brief` comment, was added or edited after `since`."""
    if any(t > since for t in issue["body_edits"]):
        return True
    return any(c["created"] and first_line(c["body"]) == BRIEF_HEADING
               and (c["created"] > since or any(t > since for t in c["edits"])) for c in issue["comments"])


def adr_hold_of(issue):
    """The newest ADR-conflict comment, when it is newer than the newest stop comment (else the stop is the reason)."""
    holds = [c for c in issue["comments"] if c["created"] and first_line(c["body"]) == ADR_MARKER]
    if not holds:
        return None
    hold = max(holds, key=lambda c: c["created"])
    stop = stop_of(issue)
    return hold if stop is None or hold["created"] > stop["created"] else None


def head_of(comment) -> str:
    """The head commit a run comment names on its `head <sha>` line, or None."""
    m = HEAD_LINE.search(comment["body"] or "")
    return m.group(1) if m else None


def resend_due(issue, head) -> bool:
    """A lead PR's failure that run could not deliver is the newest such comment and names the current head, and no
    resend has named that head yet. Once per head: a push is a new head, and so a new failure to deliver."""
    undelivered = [c for c in issue["comments"] if c["created"] and first_line(c["body"]) == UNDELIVERED_MARKER]
    if not undelivered or not head:
        return False
    if head_of(max(undelivered, key=lambda c: c["created"])) != head:
        return False
    return not any(first_line(c["body"]) == RESENT_MARKER and head_of(c) == head for c in issue["comments"])


def route(issues, state, lead, cap, now, open_prs=None, abandoned=frozenset(), liveness=None):
    """The verdict lines, then the counted line. open_prs: {ticket: {"number", "head"}} for open PRs.
    liveness: ticket number -> (state, pid) with state live | dead | none, for the worktree on the ticket's branch."""
    open_prs = open_prs or {}
    lines, claimed, freed = [], set(), set()
    for n in sorted(abandoned):
        lines.append(f"ABANDON #{n}")
    for issue in sorted(issues, key=lambda i: i["number"]):
        n = issue["number"]
        if LEAD_LABEL in issue["labels"]:
            # The lead's own ticket: no worker is ever dispatched for it, so it never holds a slot and is never stalled.
            # Its PR, once open, is the pipeline's: CI, gate, review and merge run on it like any other PR.
            pr = open_prs.get(n)
            if issue["claimed"] and pr:
                lines.append(f"LEAD-PR #{n} {pr['number']}")
                if lead == "live" and resend_due(issue, pr["head"]):
                    lines.append(f"RESEND #{n} {pr['number']}")
            elif issue["claimed"]:
                lines.append(f"LEAD-TICKET #{n}")
            continue
        if issue["claimed"]:
            claimed.add(n)
        if issue["claimed"] and issue["blockers"] and NEEDS_LEAD not in issue["labels"]:
            lines.append(f"HANDBACK #{n} blocked-by " + " ".join(f"#{b}" for b in issue["blockers"]))
            freed.add(n)
            continue
        stop = stop_of(issue)
        since = stop["created"] if stop else None
        if NEEDS_LEAD in issue["labels"]:
            pr = open_prs.get(n)
            if pr and adr_hold_of(issue):
                # An ADR conflict waits on the lead for as long as it takes: no UNCAP, no FALLBACK.
                lines.append(f"{'HOLD-PR' if lead == 'live' else 'ASK-DEV'} #{n} {pr['number']}")
                continue
            if lead == "none":
                lines.append(f"FALLBACK #{n}")
                freed.add(n)
            elif issue["claimed"] and since and now - since > UNCAP_AFTER:
                lines.append(f"UNCAP #{n}")
                freed.add(n)
            continue
        if not issue["claimed"] or since is None:
            continue
        worker = state.get(str(n))
        if not isinstance(worker, dict) or not worker.get("agent_id"):
            # A state file is per session, so an earlier session's finished worker is missing from it. Its open
            # PR shows it did its work; redispatching would start a second worker on that branch.
            if n not in open_prs:
                alive, pid = (liveness or (lambda _n: ("none", None)))(n)
                if alive == "live":
                    # Another session's worker is still building (ADR 0009): a second worker would share its branch.
                    lines.append(f"ELSEWHERE #{n} pid {pid if pid is not None else '?'}")
                else:
                    lines.append(f"REDISPATCH #{n}")
            continue
        last = parse_ts(worker.get("last_report"))
        if last is None or since <= last:
            continue  # the worker has reported since the stop: nothing to answer
        if "haiku" in str(worker.get("model") or "") and changed_after(issue, since):
            lines.append(f"ESCALATE #{n}")
        else:
            lines.append(f"RESUME #{n} {worker['agent_id']}")
    lines.append(f"counted: {len(claimed - freed)} of {cap}")
    return lines


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--lead", required=True, choices=["live", "none"], help="whether a live lead session exists")
    ap.add_argument("--cap", required=True, type=int, help="the slot cap in force (config slots, or the greedy cap)")
    ap.add_argument("--repo", default=".", help="repo root; gh runs there and the state file is read under it")
    ap.add_argument("--state", default=None, help="state file (default: <repo>/.claude/orchestrate-state.json)")
    ap.add_argument("--now", default=None, help="the time now, as ISO 8601 (tests; default: the current time)")
    args = ap.parse_args(argv)
    if args.cap < 1:
        ap.error("--cap must be at least 1")
    now = datetime.now(timezone.utc) if args.now is None else parse_ts(args.now)
    if now is None:
        common.die(f"lead-route: cannot run: --now is not an ISO time: {args.now}")
    root = Path(args.repo).resolve()
    state_path = Path(args.state) if args.state else root / STATE
    state = load_state(state_path)
    try:
        repo = load_repo(root)
        issues = load_issues(root, repo)
        open_prs = load_open_pr_tickets(root)
        abandoned = load_abandoned(root, repo)
    except github.GhError as e:
        common.die(f"lead-route: cannot run: gh failed: {e.message}")
    def liveness(n):
        branch = ticket_branch(root, n)
        state, pid, _wt, _reason = common.worker_liveness(root, branch) if branch else ("none", None, None, None)
        return state, pid

    for line in route(issues, state, args.lead, args.cap, now, open_prs, abandoned, liveness):
        print(line)
    return 0


if __name__ == "__main__":
    sys.exit(main())
