#!/usr/bin/env python3
"""watch-ci <pr>... : wait for each ready (non-draft) PR's checks to settle; one line per PR as it settles.

Run it as a Monitor command so the orchestrator never sleeps or polls. Each line:
    PR #<n> <pass|fail> <merge state> <head commit>
Each settle also appends one `ci` event (ref = the PR number). A PR with no checks yet counts as
pending (checks may not be registered right after a push); the Monitor's timeout bounds the wait. A PR
that is merged or closed settles at once.
A run that stays `in_progress` is also read once per tick (`GET actions/runs/<id>/jobs`, only while a watched
PR has a check in progress): a job whose steps are all `completed` yet whose status has stayed `in_progress` for
5 minutes (`--stuck-after` overrides) prints once
    PR #<n>: job <name> stuck in_progress with all steps done; rerun with gh run rerun <run id> --job <job id>
and the watch carries on. Nothing is rerun; the orchestrator decides. A failed jobs read is skipped for that tick.
Each tick is one `gh pr list` request for every PR still watched, so the read load does not grow with the
number of PRs. The default interval is 30 seconds with one or two PRs and 60 with three or more
(`--interval` overrides it).
A `gh` failure is retried; when `gh` fails 5 ticks in a row (a success resets the count) every watched PR
ends with the line
    PR #<n> error <one-line reason>
and is no longer watched. A PR missing from the reply is retried on the next tick and ends the same way after
3 misses in a row; the other PRs carry on. A `gh` failure that cannot clear (no repository or
working directory) ends the watch at once as could-not-run.
The repository is resolved once at startup (the main checkout) and every `gh` call runs there, so a
later change to the shell's directory, such as a removed worktree, cannot break the watch.
Exit codes: 0 every PR settled; 2 could not run (no `gh`, no repository, a reply that is not a PR),
one line on stderr; 3 every PR ended but at least one with an `error` line.
Stdlib only, Python 3.9+.
"""

import argparse
import re
import sys
import time

import common
import github
import runlog
from repo import main_checkout

MAX_FAILURES = 5  # consecutive failed `gh` ticks before every watched PR ends in an error line
MAX_MISSES = 3  # consecutive replies without a PR before it ends in an error line
FEW, FEW_INTERVAL, MANY_INTERVAL = 2, 30.0, 60.0  # up to FEW PRs poll every FEW_INTERVAL seconds, more every MANY_INTERVAL
EXIT_ERROR = 3
STUCK_AFTER = 300.0  # seconds a job with every step completed may stay in_progress before it is reported as stuck
RUN_URL = re.compile(r"/actions/runs/(\d+)/")  # a check's detailsUrl names its workflow run
FIELDS = "number,statusCheckRollup,mergeStateStatus,headRefOid,state,isDraft"
BAD = {"FAILURE", "ERROR", "TIMED_OUT", "CANCELLED", "STARTUP_FAILURE", "ACTION_REQUIRED", "STALE"}
PENDING_STATES = {"PENDING", "EXPECTED", "QUEUED", "IN_PROGRESS", "WAITING", "REQUESTED"}


def judge(view: dict):
    """'pass' | 'fail' | None (still pending) from one `gh pr view --json` result."""
    if view.get("state") in ("MERGED", "CLOSED"):
        return "pass" if view["state"] == "MERGED" else "fail"
    if view.get("isDraft"):
        return None  # a draft is building, not in review: CI is read once it is marked ready
    checks = view.get("statusCheckRollup") or []
    if not checks:
        return None
    results = []
    for c in checks:
        # CheckRun has status+conclusion; a commit StatusContext has only state.
        if "status" in c and c.get("status") != "COMPLETED":
            return None
        r = (c.get("conclusion") or c.get("state") or "").upper()
        if r in PENDING_STATES or not r:
            return None
        results.append(r)
    return "fail" if any(r in BAD for r in results) else "pass"


def interval_for(count: int, given=None) -> float:
    """Seconds between ticks: the --interval value if given, else slower with more than FEW PRs watched."""
    if given is not None:
        return given
    return FEW_INTERVAL if count <= FEW else MANY_INTERVAL


def view_prs(root):
    """({number: view}, None) on success, (None, reason) after a `gh` failure to retry. One request covers every
    PR; merged and closed ones are listed too (--state all) so they settle at once. Raises GhError when
    retrying cannot help: `gh` missing, no repository, or a reply that is not a list."""
    # Trade-off: this reads statusCheckRollup for up to 200 PRs per tick, a heavier reply than one `pr view`, but
    # still one request instead of one per PR. Watched PRs are pending, so they are among the newest.
    try:
        rows = github.call_json("pr", "list", "--state", "all", "--limit", "200", "--json", FIELDS,
                                shape=list, cwd=root)
    except github.GhError as e:
        if github.could_not_run(e):
            raise
        print(f"watch-ci: gh failed: {e.message}", file=sys.stderr, flush=True)
        return None, e.message
    return {str(r["number"]): r for r in rows if isinstance(r, dict) and "number" in r}, None


def in_progress_runs(view: dict):
    """Ids of the workflow runs behind the PR's checks that are still in progress."""
    runs = []
    for c in view.get("statusCheckRollup") or []:
        m = RUN_URL.search(c.get("detailsUrl") or "")
        if m and c.get("status") == "IN_PROGRESS" and m.group(1) not in runs:
            runs.append(m.group(1))
    return runs


def finished_in_progress(job: dict) -> bool:
    """A job still `in_progress` although all of its steps have completed (GitHub Actions sometimes hangs here)."""
    steps = job.get("steps") or []
    return job.get("status") == "in_progress" and bool(steps) and all(s.get("status") == "completed" for s in steps)


def check_stuck(root, pr, run_id, first_seen, reported, stuck_after):
    """Print one line per job of the run that has been finished-but-in_progress for stuck_after seconds.
    first_seen {job id: monotonic time first seen so}; reported: job ids already printed. Best-effort: a failed
    read is skipped, the next tick tries again."""
    try:
        data = github.call_json("api", f"repos/{{owner}}/{{repo}}/actions/runs/{run_id}/jobs", cwd=root)
    except github.GhError as e:
        print(f"watch-ci: could not read jobs of run {run_id}: {e.message}", file=sys.stderr, flush=True)
        return
    now = time.monotonic()
    for job in data.get("jobs") or []:
        if not isinstance(job, dict):
            continue
        key = (run_id, job.get("id"))
        if not finished_in_progress(job):
            first_seen.pop(key, None)
            continue
        since = first_seen.setdefault(key, now)
        if now - since >= stuck_after and key not in reported:
            reported.add(key)
            print(f"PR #{pr}: job {job.get('name')} stuck in_progress with all steps done; "
                  f"rerun with gh run rerun {run_id} --job {job.get('id')}", flush=True)


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("prs", nargs="+", help="PR numbers")
    ap.add_argument("--interval", type=float, default=None,
                    help="seconds between checks (default 30 with one or two PRs, 60 with three or more)")
    ap.add_argument("--stuck-after", type=float, default=STUCK_AFTER,
                    help="seconds a job with every step done may stay in_progress before it is reported (default 300)")
    args = ap.parse_args(argv)
    pending = [common.pr_ref(p)[0] for p in args.prs]
    code, _, _ = common.run("git", "rev-parse", "--show-toplevel")
    if code != 0:
        print("watch-ci: cannot run: not inside a git repository", file=sys.stderr, flush=True)
        return 2
    root = main_checkout(".").resolve()
    interval = interval_for(len(pending), args.interval)
    misses = {pr: 0 for pr in pending}
    failures = 0
    errored = False
    first_seen, reported = {}, set()

    def give_up(pr, reason):
        nonlocal errored
        pending.remove(pr)
        errored = True
        print(f"PR #{pr} error {common.one_line(reason)}", flush=True)

    while pending:
        try:
            views, reason = view_prs(root)
        except github.GhError as e:
            print(f"watch-ci: cannot run gh: {e.message}", file=sys.stderr, flush=True)
            return 2
        if reason is not None:
            failures += 1
            if failures >= MAX_FAILURES:
                for pr in list(pending):
                    give_up(pr, reason)
        else:
            failures = 0
            for pr in list(pending):
                view = views.get(pr)
                if view is None:
                    misses[pr] += 1
                    if misses[pr] >= MAX_MISSES:
                        give_up(pr, "not in gh's pr list")
                    continue
                misses[pr] = 0
                result = judge(view)
                if result is None:
                    if not view.get("isDraft"):
                        for run_id in in_progress_runs(view):
                            check_stuck(root, pr, run_id, first_seen, reported, args.stuck_after)
                    continue
                pending.remove(pr)
                merge, head = view.get("mergeStateStatus", "UNKNOWN"), (view.get("headRefOid") or "")[:7]
                print(f"PR #{pr} {result} {merge} {head}", flush=True)
                try:
                    # root is the main checkout resolved at startup, where the run log lives.
                    runlog.append_event(root, "ci", result, ref=common.pr_ref(pr)[1], merge_state=merge, head=head)
                except OSError as e:
                    # The event log is best-effort; losing it must not drop the other PRs' settle lines.
                    print(f"watch-ci: could not write event for #{pr}: {common.one_line(str(e))}", file=sys.stderr, flush=True)
        if pending:
            time.sleep(interval)
    return EXIT_ERROR if errored else 0


if __name__ == "__main__":
    sys.exit(main())
