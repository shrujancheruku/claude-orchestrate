#!/usr/bin/env python3
"""watch-ci <pr> [<head>]... : wait for each ready (non-draft) PR's checks to settle; one line per PR as it settles.

Each PR may be followed by the head to wait for, exactly as `merge` prints its `next: wait-ci <pr> <head>` hint:
`watch-ci 7 5ba15c1 8 ?`. A head (7 to 40 hex digits, or `?` for none) pins the PR: its checks are read only once the PR's
head is that commit, so the old head's green CI after an update-branch is never taken for the new one. `?` pins nothing.
A merged or closed PR settles at once either way.

Run it as a Monitor command so the orchestrator never sleeps or polls (every CI wait is this script; no budget or
rate-limit rule suspends it). It is read-only: it names what to do and `ci-rerun` does it. Each PR that settles prints
one `also:` line with its FULL head, and the run ends with one `next:` line (the verdict grammar, `docs/guide.md`):
    also: ci-pass <pr> <head>            CI is green on that head
    also: ci-fail <pr> <head>            CI is red (a closed unmerged PR counts as failed)
    also: no-run <pr> <head>             no workflow run started on that head: close and reopen the PR once, then watch again
    also: stuck <pr> <run id> <job id>   a finished job hangs in_progress: rerun that job (the watch carries on)
    also: head-not-reached <pr> <sha>    the PR never reached the pinned head <sha>
    also: gave-up <pr> <why>             gh kept failing, the PR is missing from gh's list, or a pass was withheld
    next: settled | retry-after <time> | could-not-run
`settled` ends the run (exit 0, or 3 when an `also:` line is an error kind: no-run, head-not-reached or gave-up);
`retry-after <time>` is a rate limit, so run the watch again after that time; `could-not-run` is exit 2 with the reason
on stderr. A `stuck` line is not a settle: the watch continues until every PR has settled.
Each settle also appends one `ci` event (ref = the PR number). A PR with no checks yet counts as
pending (checks may not be registered right after a push); the Monitor's timeout bounds the wait. A PR
that is merged or closed settles at once.
A run that stays `in_progress` is also read each tick (`GET actions/runs/<id>/jobs`: one request per
in-progress run of a watched PR, so the count grows with those runs; a run is not read again once its stuck jobs
are reported, until its checks change): a job whose steps are all `completed` yet whose status has stayed `in_progress` for
5 minutes (`--stuck-after` overrides) prints its `stuck` line once and the watch carries on. Nothing is rerun. A failed
jobs read is skipped for that tick.
Each tick is one REST pulls read of the open PRs (`github.open_prs_with_heads`), plus one check-rollup query for all
the watched PRs that are open and ready (a draft is not asked, a merged or closed one costs one REST read), and the verdict is
`github.ci_verdict` (#546). The default interval is 30 seconds with one or two PRs and 60 with three or more
(`--interval` overrides it).
A ready PR whose head has no check at all for 5 minutes (`--no-run-after` overrides) while the head has workflow files
(`github.has_workflows`; with none, no run is expected and the watch just waits) did not get a workflow run (GitHub
sometimes starts none after an update-branch): it ends with its `no-run` line and is no longer watched.
A PR given a head it does not reach in that time (a later push, a lost update) ends with `head-not-reached`.
A run that ended any PR with an error kind never prints a `ci-pass` afterwards: a PR that would pass then ends
`gave-up <pr> pass withheld: an earlier error in this run`, so a verdict read after a failure is never trusted;
run watch-ci again.
A `gh` failure is retried; when `gh` fails 5 ticks in a row (a success resets the count) every watched PR
ends `gave-up` with the reason and is no longer watched. A PR missing from the reply is retried on the next tick and
ends the same way after 3 misses in a row; the other PRs carry on. A `gh` failure that cannot clear (no repository or
working directory) ends the watch at once as could-not-run; a rate limit ends it as `retry-after <time>`.
The repository is resolved once at startup (the main checkout) and every `gh` call runs there, so a
later change to the shell's directory, such as a removed worktree, cannot break the watch.
Exit codes: 0 every PR settled; 2 could not run (no `gh`, no repository, a reply that is not a PR, an argument that
is neither a PR number nor the head after one), one line on stderr; 3 every PR ended but at least one with an `error` line.
Stdlib only, Python 3.9+.
"""

import argparse
import re
import sys
import time

import common
import github
import runlog
from repo import main_checkout

MAX_FAILURES = 5  # consecutive failed `gh` ticks before every watched PR ends in an error line
MAX_MISSES = 3  # consecutive replies without a PR before it ends in an error line
FEW, FEW_INTERVAL, MANY_INTERVAL = 2, 30.0, 60.0  # up to FEW PRs poll every FEW_INTERVAL seconds, more every MANY_INTERVAL
EXIT_ERROR = 3
NO_RUN_AFTER = 300.0  # seconds a ready PR may show no check at all before it is reported as having no CI run
HEAD_ARG = re.compile(r"\?|[0-9a-fA-F]{7,40}")  # the head half of merge's `wait-ci <pr> <head>` hint
NOT_FOUND = re.compile(r"\bHTTP 404\b")  # the host's answer for a PR number it does not know
STUCK_AFTER = 300.0  # seconds a job with every step completed may stay in_progress before it is reported as stuck
RUN_URL = re.compile(r"/actions/runs/(\d+)/")  # a check's detailsUrl names its workflow run


def judge(view: dict):
    """'pass' | 'fail' | None (still pending) from one PR view (state, isDraft, statusCheckRollup).

    The CI classification is `github.ci_verdict`, the one the gate and merge use (#546), asked to wait while any check is
    pending. It keeps #669's rule: a rollup of only skipped checks is pending, never a pass (a push to a draft skips
    the `test` job, and until the ready_for_review run joins the rollup those skips are the head's only checks); the
    no-run clock below can end that wait. A mix with a real result stays a pass: path-filtered jobs skip legitimately."""
    if view.get("state") in ("MERGED", "CLOSED"):
        return "pass" if view["state"] == "MERGED" else "fail"
    if view.get("isDraft"):
        return None  # a draft is building, not in review: CI is read once it is marked ready
    checks = view.get("statusCheckRollup") or []
    if not checks:
        return None
    return {"pass": "pass", "failed": "fail"}.get(github.ci_verdict(checks, wait_for_all=True)[0])


def has_ran(checks) -> bool:
    """True when the rollup holds a check that ran or is on its way (anything but a skip): the no-run clock stops."""
    return any((c.get("conclusion") or c.get("state") or "").upper() not in github.CI_SKIPPED | {""} or c.get("status") not in (None, "COMPLETED")
               for c in checks or [])


def parse_targets(tokens):
    """([pr...], {pr: head}) from the positional arguments: PR numbers (`7`, `#7`), each optionally followed by its head
    (hex, or `?`), the shape of `merge`'s `wait-ci <pr> <head>` hint. ValueError names a token that is neither."""
    prs, heads = [], {}
    for tok in tokens:
        if HEAD_ARG.fullmatch(tok) and prs and common.pr_ref(prs[-1])[0] not in heads and (not tok.isdigit() or len(tok) >= 7):
            if tok != "?":
                heads[prs[-1]] = tok.lower()
            else:
                heads[prs[-1]] = None
        elif tok.lstrip("#").isdigit():
            prs.append(common.pr_ref(tok)[0])
        else:
            raise ValueError(f"{tok!r} is neither a PR number nor the head after one")
    if not prs:
        raise ValueError("no PR number given")
    return prs, {pr: h for pr, h in heads.items() if h}


_workflows = {}  # head -> whether its tree holds workflow files; only a successful read is kept


def has_workflows(root, head):
    """True when the head holds a workflow file (one contents call per head, cached). An unreadable
    listing counts as False, not cached: the caller keeps waiting and asks again next tick."""
    if head not in _workflows:
        try:
            _workflows[head] = github.has_workflows(head, cwd=root)
        except github.GhError as e:
            print(f"watch-ci: could not read the workflow files of {head[:7]}: {e.message}", file=sys.stderr, flush=True)
            return False
    return _workflows[head]


def interval_for(count: int, given=None) -> float:
    """Seconds between ticks: the --interval value if given, else slower with more than FEW PRs watched."""
    if given is not None:
        return given
    return FEW_INTERVAL if count <= FEW else MANY_INTERVAL


def view_prs(root, watched):
    """({number: view}, None) on success, (None, reason) after a `gh` failure to retry. The open PRs come from one REST
    pulls read (every watched PR that is open, with its draft flag); a watched PR not in it is read on its own to see
    whether it merged or closed (so it settles at once), and an open, ready one has its check rollup read through
    `github.pr_rollups` (one aliased GraphQL query for all of them, the rollup having no REST form). A draft is not asked for its checks. A PR the
    host does not know is left out of the result. Raises GhError when retrying cannot help: `gh` missing, no
    repository, or a malformed reply."""
    views = {}
    try:
        listed = {str(r["number"]): r for r in github.open_prs_with_heads(cwd=root)}
        ready = [pr for pr in watched if pr in listed and not listed[pr]["isDraft"]]
        rollups = github.pr_rollups(ready, cwd=root)  # one query for every ready PR, not one each (#770)
        for pr in watched:
            row = listed.get(pr)
            if row is not None and row["isDraft"]:
                views[pr] = {"state": "OPEN", "isDraft": True, "headRefOid": row["headRefOid"], "statusCheckRollup": []}
            elif row is not None:
                if pr not in rollups:  # a PR the batch did not return is a malformed reply, not a crash
                    raise github.GhError(github.MALFORMED, f"gh returned no rollup for PR {pr}")
                views[pr] = dict(rollups[pr], isDraft=False)
            else:
                try:
                    views[pr] = dict(github.pr_view(pr, "state,headRefOid", cwd=root), isDraft=False, statusCheckRollup=[])
                except github.GhError as e:
                    if e.kind != github.FAILED or not NOT_FOUND.search(e.message):
                        raise  # only a 404 means the host does not know the PR; the rest is a failed tick
    except github.GhError as e:
        # A 5xx that outlasted the retries is one more failed tick, counted against MAX_FAILURES like any other.
        if github.could_not_run(e) and e.kind != github.SERVER_ERROR:
            raise
        print(f"watch-ci: gh failed: {e.message}", file=sys.stderr, flush=True)
        return None, e.message
    return views, None


def merge_state(root, pr) -> str:
    """The PR's merge state for its `ci` event, read once when it settles; UNKNOWN when the read fails (best effort)."""
    try:
        return github.pr_view(pr, "mergeStateStatus", cwd=root)["mergeStateStatus"]
    except github.GhError:
        return "UNKNOWN"


def in_progress_runs(view: dict):
    """{run id: the detailsUrls of its in-progress checks}. A rerun gives a check a new URL, so a changed value
    means the run changed."""
    runs = {}
    for c in view.get("statusCheckRollup") or []:
        url = c.get("detailsUrl") or ""
        m = RUN_URL.search(url)
        if m and c.get("status") == "IN_PROGRESS":
            runs.setdefault(m.group(1), []).append(url)
    return {run: tuple(urls) for run, urls in runs.items()}


def finished_in_progress(job: dict) -> bool:
    """A job still `in_progress` although all of its steps have completed (GitHub Actions sometimes hangs here)."""
    steps = job.get("steps") or []
    return job.get("status") == "in_progress" and bool(steps) and all(s.get("status") == "completed" for s in steps)


def check_stuck(root, pr, run_id, first_seen, reported, stuck_after):
    """Print one line per job of the run that has been finished-but-in_progress for stuck_after seconds.
    first_seen {(run, job id): monotonic time first seen so}; reported: keys already printed. Best-effort: a
    failed read is skipped, the next tick tries again. True when every in_progress job of the run is stuck and reported."""
    try:
        data = github.call_json("api", f"repos/{{owner}}/{{repo}}/actions/runs/{run_id}/jobs?per_page=100", cwd=root)
    except github.GhError as e:
        print(f"watch-ci: could not read jobs of run {run_id}: {e.message}", file=sys.stderr, flush=True)
        return False
    now = time.monotonic()
    running = []  # keys of every job still in_progress, stuck or not
    for job in data.get("jobs") or []:
        if not isinstance(job, dict):
            continue
        key = (run_id, job.get("id"))
        if job.get("status") == "in_progress":
            running.append(key)
        if not finished_in_progress(job):
            first_seen.pop(key, None)
            continue
        since = first_seen.setdefault(key, now)
        if now - since >= stuck_after and key not in reported:
            reported.add(key)
            common.also("stuck", pr, run_id, job.get("id"))
    # A sibling still working normally may stick later under the same checks, so the run is done only when
    # every in_progress job of it is stuck and reported.
    return bool(running) and all(k in reported for k in running)


def main(argv=None) -> int:
    """Watch, then print the one `next:` line (see the module docstring)."""
    github.rate_limited_until = None
    try:
        code = watch(argv)
    except SystemExit as e:  # an argparse usage error (2); --help (0) prints no verdict
        if e.code in (0, None):
            raise
        code = e.code if isinstance(e.code, int) else 2
    if code in (0, EXIT_ERROR):
        return common.verdict("settled", exit_code=code)
    until = github.rate_limit_verdict(code)
    if until:
        return common.verdict("retry-after", until, exit_code=code)
    return common.verdict("could-not-run", exit_code=code)


def watch(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0], allow_abbrev=False)
    ap.add_argument("prs", nargs="+", help="PR numbers, each optionally followed by its head (merge's wait-ci hint)")
    ap.add_argument("--no-run-after", type=float, default=NO_RUN_AFTER,
                    help="seconds a ready PR may show no check before it ends as having no CI run (default 300)")
    ap.add_argument("--interval", type=float, default=None,
                    help="seconds between checks (default 30 with one or two PRs, 60 with three or more)")
    ap.add_argument("--stuck-after", type=float, default=STUCK_AFTER,
                    help="seconds a job with every step done may stay in_progress before it is reported (default 300)")
    args = ap.parse_args(argv)
    try:
        pending, pinned = parse_targets(args.prs)
    except ValueError as e:
        print(f"watch-ci: cannot run: {e}", file=sys.stderr, flush=True)
        return 2
    pending = list(dict.fromkeys(pending))
    empty_since = {}  # pr -> (head, monotonic time its head was first seen with no check)
    unreached = {}  # pr -> monotonic time it was first seen away from its pinned head
    code, _, _ = common.run("git", "rev-parse", "--show-toplevel")
    if code != 0:
        print("watch-ci: cannot run: not inside a git repository", file=sys.stderr, flush=True)
        return 2
    root = main_checkout(".").resolve()
    interval = interval_for(len(pending), args.interval)
    misses = {pr: 0 for pr in pending}
    failures = 0
    errored = False
    first_seen, reported, done = {}, set(), set()  # done: (run, its in-progress URLs) with every stuck job reported

    def give_up(pr, word, *args):
        """End the watch of a PR with an error-kind `also:` line (exit 3)."""
        nonlocal errored
        pending.remove(pr)
        errored = True
        common.also(word, pr, *(common.one_line(a) for a in args))

    while pending:
        github.reset_wait_budget()  # a tick of a loop that runs for hours gets its own wait budget
        github.rate_limited_until = None  # only a limit that ends the run counts for its verdict
        try:
            views, reason = view_prs(root, pending)
        except github.GhError as e:
            print(f"watch-ci: cannot run gh: {e.message}", file=sys.stderr, flush=True)
            return 2
        if reason is not None:
            failures += 1
            if failures >= MAX_FAILURES:
                for pr in list(pending):
                    give_up(pr, "gave-up", reason)
        else:
            failures = 0
            for pr in list(pending):
                view = views.get(pr)
                if view is None:
                    misses[pr] += 1
                    if misses[pr] >= MAX_MISSES:
                        give_up(pr, "gave-up", "not in gh's pr list")
                    continue
                misses[pr] = 0
                head_now = (view.get("headRefOid") or "")
                want = pinned.get(pr)
                if want and view.get("state") == "OPEN" and not head_now.lower().startswith(want):
                    # The update has not moved the PR to the head being waited for: its checks are the old head's.
                    # A head the PR never reaches (a later push, a lost update) ends the watch like a missing run.
                    since = unreached.setdefault(pr, time.monotonic())
                    if time.monotonic() - since >= args.no_run_after:
                        give_up(pr, "head-not-reached", want)
                    continue
                unreached.pop(pr, None)
                result = judge(view)
                if result is None and not view.get("isDraft") and not has_ran(view.get("statusCheckRollup")):
                    seen = empty_since.get(pr)
                    if seen is None or seen[0] != head_now:
                        seen = empty_since[pr] = (head_now, time.monotonic())
                    # No workflow files on the head means no run is expected (ADR-0012: green, as `merge` reads it):
                    # keep waiting rather than blame a missing run. An unreadable listing is asked again next tick.
                    if time.monotonic() - seen[1] >= args.no_run_after and has_workflows(root, head_now):
                        give_up(pr, "no-run", head_now)
                        continue
                else:
                    empty_since.pop(pr, None)
                if result == "pass" and errored:
                    give_up(pr, "gave-up", "pass withheld: an earlier error in this run")
                    continue
                if result is None:
                    if not view.get("isDraft"):
                        for run_id, urls in in_progress_runs(view).items():
                            if (run_id, urls) not in done and check_stuck(
                                    root, pr, run_id, first_seen, reported, args.stuck_after):
                                done.add((run_id, urls))
                    continue
                pending.remove(pr)
                merge, head = merge_state(root, pr), (view.get("headRefOid") or "")[:7]
                common.also("ci-" + result, pr, view.get("headRefOid") or "?")
                try:
                    # root is the main checkout resolved at startup, where the run log lives.
                    runlog.append_event(root, "ci", result, ref=common.pr_ref(pr)[1], merge_state=merge, head=head)
                except runlog.NoSession as e:
                    print(e, file=sys.stderr, flush=True)
                except OSError as e:
                    # The event log is best-effort; losing it must not drop the other PRs' settle lines.
                    print(f"watch-ci: could not write event for #{pr}: {common.one_line(str(e))}", file=sys.stderr, flush=True)
        if pending:
            time.sleep(interval)
    return EXIT_ERROR if errored else 0


if __name__ == "__main__":
    sys.exit(main())
