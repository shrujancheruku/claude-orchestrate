#!/usr/bin/env python3
r"""gate <pr> [--cwd DIR] [--base BRANCH] : the mechanical checks that run before any reviewer.

The one mechanical check before review. Prints `PR #<n> head <sha>` first (the join key with `watch-ci`'s
line), then one line per check, with the last ~40 lines of a failure's output, in the same format as `verify`:
the PR's title against Conventional Commits; its mergeability with its base (conflicts only: a branch that is
merely behind passes, and `merge` updates it, exit 5); no overlap with held paths (`holds --pr`, run as a
subprocess from --cwd: its exit 1 fails the check, its exit 2 is gate exit 2, and its exit 3 means two open PRs hold one
path and this is the younger: a `wait` line `waits for #<ticket> (PR #<n>) to merge: <paths>`, not a failure, gate exit 3); dependencies merged (the PR's
ticket has no open blocker, native or on its body's `Blocked by:` line, read from the tracker Snapshot and the PR is based on the default branch; no ticket passes); no secrets added
(env, key and credential paths, private-key and token lines in the diff); a changed lockfile has a changed
manifest; each GraphQL `query` string the diff adds or changes in a script or Python module, run once, read-only, through `gh api graphql` with fixture values (the
repository's owner and name, the PR's number for an `Int`: a GraphQL error fails the check with the error as its output; a `mutation` is never run, its fields are
checked against the schema's `Mutation` type, #663); and each command the config's `Repo-specific checks` entry carries (a `run: \`cmd\``-marked span).
CI is never checked: that is `watch-ci`'s. Appends one `gate` event (ref = the PR number, head = the PR's head
commit, outcome pass|fail, failed = the names of the failed checks). Exit codes: 0 every check passed;
1 a check failed (send the output to the worker); 2 the gate could not run (bad --cwd, `gh` missing or
failed, unreadable `gh` output); 3 GitHub still reports the PR's mergeability as UNKNOWN after retries
and nothing else failed, or the PR waits for an older open PR on a shared path to merge and nothing else failed
(run the gate again, after that PR merges; not the worker's fault); either with another failure exits
1. behind_by is shown and logged (null when unreadable) but never fails. A marker is `run: \`cmd\``; one
that yields no command fails the gate as malformed. Run the repo-specific commands in --cwd (the worker's
worktree, so they see the PR's code); default is the current directory. Each runs for at most --timeout
seconds (default 1800); one that outlives it is killed and fails with "timed out after Ns".
On a pass (exit 0), a `tier S|M|L` line comes just before `next: review <head>` (never above a `send-back`, whose lines go to the worker): the reviewer's tier (Config.tier_for: the
diff's changed lines and files against the config's Tiers, a risk path as L, and the ticket's `size:` label as a floor that
only raises it); the orchestrator dispatches the reviewer at that tier.
Every run ends with exactly one `next:` line, the verdict the orchestrator applies word for word:
`review <head>` (exit 0) | `send-back <pr>` (exit 1; the lines above it are what the worker gets) |
`rerun-after-ci` (exit 3, mergeability still UNKNOWN) | `wait-older <pr> <older>` (exit 3, the PR waits for the older
PR to merge) | `wait-ticket <pr> <ticket>` (exit 3, the only overlap is with a ticket still building or in another
session: the PR is fine; run the gate again when that ticket opens its PR or merges, whichever comes first) | `retry-after <time>` (exit 2, a rate limit) | `could-not-run` (exit 2, the reason on stderr).
The config (checks, tiers, shared files) is read from the main checkout, never from --cwd: a PR that edits
`.claude/orchestration.md` must not edit the gate that judges it (#535). The `run:` commands still run in --cwd.
Stdlib only, Python 3.9+.
"""

import argparse
import fnmatch
import re
import sys
import time
from pathlib import Path

import checks
import claims
import common
import config
import github
import gqlcheck
import holds
import repo
import runlog
import touchmap
import tracker

WAIT = "wait"  # a Result status: not a failure and not a pass; the PR waits for an older one (exit 3)
NEXT = {}  # what main() needs for the `next:` line: the PR and its head
# Paths (by file name) that hold secrets, and added lines that are secrets.
SECRET_NAMES = (".env", ".env.*", "*.pem", "*.key", "*.p12", "*.pfx", "*.keystore", "id_rsa*", "id_ed25519*",
                "*credentials*.json")
SECRET_LINE = re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{20,}|github_pat[_]|xox[abp]-")
# A lockfile and the manifest that must change with it (same directory).
LOCKFILES = {"package-lock.json": "package.json", "yarn.lock": "package.json", "pnpm-lock.yaml": "package.json",
             "poetry.lock": "pyproject.toml", "uv.lock": "pyproject.toml", "Cargo.lock": "Cargo.toml",
             "Gemfile.lock": "Gemfile", "go.sum": "go.mod", "composer.lock": "composer.json"}
CLOSES = re.compile(r"\bcloses\s+#(\d+)", re.I)
DIFF_HEADER = re.compile(r"^diff --git a/.* b/(.*)$")

TITLE_RE = re.compile(
    r"^(feat|fix|docs|refactor|test|chore|build|ci|perf|style|revert)(\([^()\s][^()]*\))?!?: \S")


def check(name, ok, why=""):
    return checks.Result(name, "pass" if ok else "fail", 0.0, None if ok else 1, why)


def parse_diff(diff):
    """(changed, added, lines) of a unified diff: every changed path, the paths created or renamed/copied to (a
    header block with `new file mode`, `rename to` or `copy to`; not an edit of an existing file), and the added
    lines."""
    changed, added, lines, current, created = [], [], [], None, False
    for line in diff.splitlines():
        m = DIFF_HEADER.match(line)
        if m:
            if current is not None and created:
                added.append(current)
            current, created = m.group(1), False
            changed.append(current)
        elif line.startswith(("new file mode", "rename to ", "copy to ")):
            created = True
        elif line.startswith("+") and not line.startswith("+++"):
            lines.append(line[1:])
    if current is not None and created:
        added.append(current)
    return changed, added, lines


def changed_lines(diff) -> int:
    """Added plus removed lines of a unified diff, counted inside hunks only (after an `@@` line, by first character), so
    file headers are not lines but a removed `---` or an added `++x` is."""
    n, inside = 0, False
    for l in diff.splitlines():
        if l.startswith("diff --git"):
            inside = False
        elif l.startswith("@@"):
            inside = True
        elif inside and l[:1] in ("+", "-"):
            n += 1
    return n


def review_tier(view, changed, diff, snap, cwd) -> str:
    """The reviewer tier `S|M|L` of the PR (Config.tier_for): its diff against the config's thresholds, a risk path
    as L, and the ticket's `size:` label as a floor. The ticket is the branch's, else the body's `Closes #n`."""
    cfg = config.for_checkout(cwd)  # the main checkout's config, not the PR's (#535)
    ticket = repo.ticket_of_branch(view.get("headRefName"))
    if ticket is None:
        m = CLOSES.search(view.get("body") or "")
        ticket = int(m.group(1)) if m else None
    labels = next((i["labels"] for i in snap.issues if i["number"] == ticket), ())
    return cfg.tier_for(changed_lines(diff), len(set(changed)), labels, cfg.risk_hit(changed))


def secrets_found(added, lines):
    found = [f"path {p}" for p in added if any(fnmatch.fnmatch(p.rsplit("/", 1)[-1], g) for g in SECRET_NAMES)]
    found += [f"added line matching {m.group(0)!r}" for m in map(SECRET_LINE.search, lines) if m]
    return found


def lockfiles_without_manifest(changed):
    paths = set(changed)
    out = []
    for p in sorted(paths):
        head, _, name = p.rpartition("/")
        manifest = LOCKFILES.get(name)
        if manifest and (f"{head}/{manifest}" if head else manifest) not in paths:
            out.append(f"{p} changed but {manifest} did not")
    return out


def dependencies_check(view, snap, cwd="."):
    """Pass when the PR's ticket has no open blocker and the PR is based on the default branch."""
    name = "dependencies merged"
    ticket = repo.ticket_of_branch(view.get("headRefName"))
    if ticket is None:
        m = CLOSES.search(view.get("body") or "")
        ticket = int(m.group(1)) if m else None
    if ticket is None:
        return check(f"{name} (no ticket)", True)
    problems = []
    blockers = snap.blockers(ticket)
    if blockers:
        problems.append(f"#{ticket} has {len(blockers)} open blocker(s): "
                        + " ".join(f"#{n} (body)" if from_body else f"#{n}" for n, from_body in blockers))
    default = github.default_branch(cwd)
    if view.get("baseRefName") != default:
        problems.append(f"based on {view.get('baseRefName')}, not {default}: a dependency is not merged")
    return check(name, not problems, "\n".join(problems))


def query_sources(changed, base, cwd) -> list:
    """[(path, head source, base source)] for each changed Python file that can hold a query (a `.py` file or an
    extensionless script, outside tests/). The head is the file in --cwd (the PR's tree, as the `run:` commands see it);
    the base is `origin/<base>`'s copy, empty for a new file or when git cannot show it."""
    out = []
    for path in sorted(set(changed)):
        if path.startswith("tests/") or not (path.endswith(".py") or "." not in path.rsplit("/", 1)[-1]):
            continue
        try:
            head = (Path(cwd) / path).read_text()
        except (OSError, UnicodeDecodeError):
            continue  # deleted, or not text
        shown = common.run("git", "show", f"origin/{base}:{path}", cwd=cwd)
        out.append((path, head, shown.stdout if shown.code == 0 else ""))
    return out


def query_checks(pr, changed, base, cwd):
    """One result per GraphQL query the PR adds or changes (see gqlcheck): run once, read-only; a mutation is only
    checked against the schema. Raises github.GhError when gh could not run."""
    return [check(label, ok, why) for label, ok, why in gqlcheck.check(query_sources(changed, base, cwd), pr, cwd)]


def overlap_check(pr, cwd, snap):
    """The `holds` verdict for the PR as a check, or an error string when holds could not run. A `waits-for` result is
    a `wait`, not a failure."""
    # The repo is the main checkout: the state file holding the building tickets' touch maps lives only there,
    # and from a worker's worktree holds would read none. holds gets the gate's own snapshot (#367), so one gate run
    # reads the tracker once; the open PRs' file lists come from the main checkout's snapshot file when their head
    # SHAs match (#446) and the misses are written back.
    main = Path(repo.main_checkout(cwd))
    try:
        snap.use_cache(main / tracker.SNAPSHOT_FILE)
        result = holds.find(snap, main, pr=pr)
    except github.GhError as e:
        return f"holds could not run: gh failed: {e.message}"
    except (KeyError, TypeError) as e:  # a malformed gh reply: could not run, not a failed check
        return f"gh returned a malformed gh reply ({e!r})"
    except (ValueError, OSError) as e:  # an unreadable state file, say
        return f"holds could not run: {common.one_line(str(e) or type(e).__name__)}"
    if result.code == 0:
        return check("no overlap with held paths", True)
    if result.code == 1:
        return check("no overlap with held paths", False, "\n".join(result.lines()))
    if result.waits:
        NEXT["older"] = sorted({o.pr for o in result.waits})[0]  # the verdict names the oldest PR to wait for
    else:  # only tickets still building hold the paths: a hold naming the lowest one, not a send-back (#535)
        NEXT["ticket"] = sorted({o.ticket for o in result.ticket_waits})[0]
    return checks.Result("no overlap with held paths: " + "; ".join(result.wait_lines()), WAIT, 0.0, None, "")


def outside_map(branch, changed, cwd) -> int:
    """How many of the PR's changed files lie outside its ticket's touch map (the worker record in the state file); 0
    when there is no record or no map, or the state cannot be read."""
    try:
        ticket = repo.ticket_of_branch(branch)
        state = claims.read_state(Path(repo.main_checkout(cwd)) / repo.STATE)
        record = state.get(str(ticket)) if ticket is not None else None
        mapped = touchmap.parse(record.get("touch_map")) if isinstance(record, dict) and isinstance(record.get("touch_map"), str) else []
    except (ValueError, OSError, github.GhError):  # touchmap.TouchMapError is a ValueError
        return 0
    if not mapped:
        return 0
    return len({p for p in changed if not any(touchmap.overlaps(m, touchmap.Entry(p)) for m in mapped)})


def pr_checks(pr, base_override, retries=4, delay=2.5, cwd="."):
    """The built-in checks: title, mergeability (conflicts; behind_by is informational), overlap, dependencies,
    secrets and lockfiles. Returns (results, (behind, unknown, head)) or (None, why) when a check could not run."""
    # GitHub computes mergeability lazily: UNKNOWN right after a push usually settles in seconds.
    for attempt in range(retries + 1):
        try:
            view = github.pr_view(pr, "title,mergeable,baseRefName,headRefName,headRefOid,body", cwd)
        except github.GhError as e:
            if e.kind == github.MALFORMED:
                return None, "gh pr view returned malformed JSON"
            return None, f"gh pr view failed: {e.message}"
        if view.get("mergeable", "UNKNOWN") != "UNKNOWN" or attempt == retries:
            break
        time.sleep(delay)
    results = [check("title follows Conventional Commits", bool(TITLE_RE.match(view.get("title", ""))),
                     f"title: {view.get('title')!r}\nexpected: type(scope): description")]
    base = base_override or view.get("baseRefName") or "main"
    mergeable = view.get("mergeable", "UNKNOWN")
    behind = None
    try:
        behind = github.behind_by(base, view.get("headRefName"), cwd)
    except github.GhError:
        pass  # shown as ? and logged as null
    problems = []
    if mergeable == "CONFLICTING":
        problems.append(f"conflicts with {base}")
    elif mergeable == "UNKNOWN":
        problems.append("GitHub still reports mergeability as UNKNOWN; run the gate again (not the worker's fault)")
    elif mergeable != "MERGEABLE":
        problems.append(f"not mergeable ({mergeable})")
    # Being behind is not a failure: `merge --approved-head` updates the branch (exit 5) and CI reruns (#230).
    label = f"mergeable with {base} (behind_by {behind if behind is not None else '?'})"
    results.append(check(label, not problems, "\n".join(problems)))
    snap = tracker.Snapshot(cwd)
    overlap = overlap_check(pr, cwd, snap)
    if isinstance(overlap, str):
        return None, overlap
    results.append(overlap)
    try:
        results.append(dependencies_check(view, snap, cwd))
        diff = github.pr_diff(pr, cwd)
    except github.GhError as e:
        return None, e.message if e.kind == github.MALFORMED else f"gh failed: {e.message}"
    except (KeyError, TypeError, ValueError) as e:  # a malformed issues reply: could not run, not a failed check
        return None, f"gh returned a malformed issues reply ({e!r})"
    changed, added, lines = parse_diff(diff)
    NEXT["tier"] = review_tier(view, changed, diff, snap, cwd)
    found = secrets_found(added, lines)
    results.append(check("no secrets added", not found, "\n".join(found)))
    bad = lockfiles_without_manifest(changed)
    results.append(check("lockfile changes have a manifest change", not bad, "\n".join(bad)))
    try:
        results += query_checks(pr, changed, base, cwd)
    except github.GhError as e:
        return None, f"graphql query check could not run: {e.message}"
    outside = outside_map(view.get("headRefName"), changed, cwd)
    if outside:  # information, not a failure: the drift shows at gate time (#398)
        results.append(check(f"touch map: +{outside} files outside the map", True))
    return results, (behind, mergeable == "UNKNOWN", view.get("headRefOid"))


def main(argv=None) -> int:
    """Run the gate, then print the one `next:` line (see the module docstring)."""
    NEXT.clear()
    github.rate_limited_until = None
    try:
        code = run_gate(argv)
    except SystemExit as e:  # an argparse usage error (2); --help (0) prints no verdict
        if e.code in (0, None):
            raise
        code = e.code if isinstance(e.code, int) else 2
    pr, head = NEXT.get("pr", "?"), NEXT.get("head")
    if code == 0:
        # the reviewer's tier, for the dispatch that follows `review <head>`; a send-back's lines go to the worker, so no tier there
        if NEXT.get("tier"):
            print(f"tier {NEXT['tier']}", flush=True)
        return common.verdict("review", head, exit_code=code)
    if code == 1:
        return common.verdict("send-back", pr, exit_code=code)
    if code == 3:  # waiting for an older PR is its own word; an UNKNOWN mergeability is a rerun after CI
        if NEXT.get("older") is not None and not NEXT.get("unknown"):
            return common.verdict("wait-older", pr, NEXT["older"], exit_code=code)
        if NEXT.get("ticket") is not None and not NEXT.get("unknown"):
            return common.verdict("wait-ticket", pr, NEXT["ticket"], exit_code=code)
        return common.verdict("rerun-after-ci", exit_code=code)
    until = github.rate_limit_verdict(code)
    if until:
        return common.verdict("retry-after", until, exit_code=code)
    return common.verdict("could-not-run", exit_code=code)


def run_gate(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0], allow_abbrev=False)
    ap.add_argument("pr", help="PR number")
    ap.add_argument("--cwd", default=".", help="directory holding the PR's code and the config")
    ap.add_argument("--base", help="base branch (default: the PR's)")
    ap.add_argument("--timeout", type=float, default=checks.DEFAULT_TIMEOUT,
                    help="seconds a repo-specific command may run before it is killed (default: %(default)g)")
    ap.add_argument("--retry-delay", type=float, default=2.5, help="seconds between mergeability retries")
    claims.add_session_arg(ap)
    args = ap.parse_args(argv)
    claims.use_session(args.session)
    if args.timeout <= 0:
        print("gate: --timeout must be above 0", file=sys.stderr)
        return 2
    if not Path(args.cwd).is_dir():
        print(f"gate: --cwd {args.cwd} does not exist", file=sys.stderr)
        return 2
    pr, ref = common.pr_ref(args.pr)
    NEXT["pr"] = pr

    results, extra = pr_checks(pr, args.base, delay=args.retry_delay, cwd=args.cwd)
    if results is None:
        print(f"gate: {extra}", file=sys.stderr)
        return 2
    behind, unknown, head = extra
    NEXT["head"] = head
    # The config is the main checkout's copy, so a PR that edits `.claude/orchestration.md` does not edit the checks that
    # judge it (#535); the `run:` commands still run in --cwd, the PR's tree.
    cfg = config.for_checkout(args.cwd)
    malformed = cfg.problems_of(config.RUN)  # only a bad `run:` fails the gate; other problems are not its business
    results += checks.run_stages([list(cfg.check_commands)], args.cwd, args.timeout)
    if malformed:
        results.append(check("repo-specific checks: malformed run: marker", False,
                             f"{len(malformed)} `run:` marker(s) without a single `backticked` command"))
    print(f"PR #{pr} head {head}")
    print(checks.format_results(results))
    failed = [r.command for r in results if r.status == "fail"]
    # An UNKNOWN mergeability that was the only failure is not a verdict: rerun, don't send to the worker.
    waits = any(r.status == WAIT for r in results)
    undecided = (unknown and len(failed) == 1) or (waits and not failed)
    NEXT["unknown"] = unknown and len(failed) == 1  # the mergeability, not the older PR, is what the rerun waits for
    outcome = "unknown" if undecided else "fail" if failed else "pass"
    # The event lands in the main checkout's run log, beside the pass log.
    try:
        runlog.append_event(args.cwd, "gate", outcome, ref=ref, failed=failed, behind_by=behind, head=head)
    except runlog.NoSession as e:
        print(e, file=sys.stderr)  # the verdict stands; only its log line is lost
    return 3 if undecided else 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
