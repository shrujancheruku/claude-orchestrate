#!/usr/bin/env python3
r"""gate <pr> [--cwd DIR] [--base BRANCH] : the mechanical checks that run before any reviewer.

Checks a PR's mergeability with its base (conflicts, and how far it is behind), its title against
Conventional Commits, and each command the config's `Repo-specific checks` entry carries (a
`run: \`cmd\``-marked span). Prints one line per check, with the last ~40 lines of a failure's output, in
the same format as `verify`. Appends one `gate` event (ref = the PR number, outcome pass|fail,
failed = the names of the failed checks). Exit codes: 0 every check passed; 1 a check failed (send the
output to the worker); 2 the gate could not run (bad --cwd, `gh` missing or failed, unreadable `gh` output); 3 GitHub still reports the
PR's mergeability as UNKNOWN after retries, behind_by reads 0, and nothing else failed (run the gate again;
not the worker's fault); UNKNOWN with behind_by above 0 or unreadable exits 1. A marker is `run: \`cmd\``;
one that yields no command fails the gate as malformed. Run the repo-specific commands in --cwd (the worker's
worktree, so they see the PR's code); default is the current directory. Each runs for at most
--timeout seconds (default 1800); one that outlives it is killed and fails with "timed out after Ns".
Stdlib only, Python 3.9+.
"""

import argparse
import json
import re
import sys
import time
from pathlib import Path

import checks
import common

TITLE_RE = re.compile(
    r"^(feat|fix|docs|refactor|test|chore|build|ci|perf|style|revert)(\([^()\s][^()]*\))?!?: \S")


def gh(*args):
    return common.run("gh", *args)


def check(name, ok, why=""):
    return checks.Result(name, "pass" if ok else "fail", 0.0, None if ok else 1, why)


LABEL_RE = re.compile(r"^\s*-\s+\*\*Repo-specific checks:?\*\*")
MARKER_RE = re.compile(r"(?<![\w-])run:")
COMMAND_RE = re.compile(r"(?<![\w-])run:\s*`([^`]+)`(?!`)")


def repo_commands(cwd):
    """(commands, malformed markers) from the `Repo-specific checks` item of the config's Review section.

    A command is marked `run: `cmd``. Opt-in: plain backticked text (a file name, a flag) is prose and
    never executed. A `run:` marker that yields no command (empty, nested or doubled backticks) is
    counted as malformed, so it fails the gate instead of vanishing.
    """
    review = common.config_section(cwd, "Review")
    commands, malformed, inside = [], 0, False
    for line in (review or "").splitlines():
        if not line.startswith((" ", "\t")) and line.strip():
            inside = bool(LABEL_RE.match(line))
        if inside:
            found = [c.strip() for c in COMMAND_RE.findall(line) if c.strip()]
            commands.extend(found)
            malformed += max(0, len(MARKER_RE.findall(line)) - len(found))
    return commands, malformed


def pr_checks(pr, base_override, retries=4, delay=2.5):
    """The built-in checks: title convention, then mergeability (conflicts and behind_by)."""
    # GitHub computes mergeability lazily: UNKNOWN right after a push usually settles in seconds.
    for attempt in range(retries + 1):
        code, out, err = gh("pr", "view", pr, "--json", "title,mergeable,baseRefName,headRefName")
        if code != 0:
            return None, f"gh pr view failed: {common.one_line(err)}"
        try:
            view = json.loads(out)
        except ValueError:
            return None, "gh pr view returned malformed JSON"
        if not isinstance(view, dict):
            return None, "gh pr view returned malformed JSON"
        if view.get("mergeable", "UNKNOWN") != "UNKNOWN" or attempt == retries:
            break
        time.sleep(delay)
    results = [check("title follows Conventional Commits", bool(TITLE_RE.match(view.get("title", ""))),
                     f"title: {view.get('title')!r}\nexpected: type(scope): description")]
    base = base_override or view.get("baseRefName") or "main"
    mergeable = view.get("mergeable", "UNKNOWN")
    behind = None
    code, out, err = gh("api", f"repos/{{owner}}/{{repo}}/compare/{base}...{view.get('headRefName')}", "--jq", ".behind_by")
    if code == 0 and out.strip().isdigit():
        behind = int(out.strip())
    problems = []
    if mergeable == "CONFLICTING":
        problems.append(f"conflicts with {base}")
    elif mergeable == "UNKNOWN":
        # Rerun advice only when behind_by reads 0; otherwise it would hide the real problem.
        rerun = "; run the gate again (not the worker's fault)" if behind == 0 else ""
        problems.append(f"GitHub still reports mergeability as UNKNOWN{rerun}")
    elif mergeable != "MERGEABLE":
        problems.append(f"not mergeable ({mergeable})")
    if behind is None:
        problems.append(f"could not read behind_by: {common.one_line(err)}; retry later")
    elif behind:
        problems.append(f"behind {base} by {behind} commit(s); rebase or merge {base}")
    label = f"mergeable with {base} (behind_by {behind if behind is not None else '?'})"
    results.append(check(label, not problems, "\n".join(problems)))
    return results, (behind, mergeable == "UNKNOWN")


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("pr", help="PR number")
    ap.add_argument("--cwd", default=".", help="directory holding the PR's code and the config")
    ap.add_argument("--base", help="base branch (default: the PR's)")
    ap.add_argument("--timeout", type=float, default=checks.DEFAULT_TIMEOUT,
                    help="seconds a repo-specific command may run before it is killed (default: %(default)g)")
    ap.add_argument("--retry-delay", type=float, default=2.5, help="seconds between mergeability retries")
    args = ap.parse_args(argv)
    if args.timeout <= 0:
        print("gate: --timeout must be above 0", file=sys.stderr)
        return 2
    if not Path(args.cwd).is_dir():
        print(f"gate: --cwd {args.cwd} does not exist", file=sys.stderr)
        return 2
    pr, ref = common.pr_ref(args.pr)

    results, extra = pr_checks(pr, args.base, delay=args.retry_delay)
    if results is None:
        print(f"gate: {extra}", file=sys.stderr)
        return 2
    behind, unknown = extra
    commands, malformed = repo_commands(args.cwd)
    results += checks.run_stages([commands], args.cwd, args.timeout)
    if malformed:
        results.append(check("repo-specific checks: malformed run: marker", False,
                             f"{malformed} `run:` marker(s) without a single `backticked` command"))
    print(checks.format_results(results))
    failed = [r.command for r in results if r.status == "fail"]
    # An UNKNOWN mergeability that was the only failure is not a verdict: rerun, don't send to the worker.
    # Only when behind_by is a readable 0; behind above 0 or unreadable is a real failure to report.
    undecided = unknown and behind == 0 and len(failed) == 1
    outcome = "unknown" if undecided else "fail" if failed else "pass"
    # The event lands in the orchestrator's repo, beside the pass log.
    common.append_event(".", "gate", outcome, ref=ref, failed=failed, behind_by=behind)
    return 3 if undecided else 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
