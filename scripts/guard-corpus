#!/usr/bin/env python3
"""Mine session transcripts into the guard regression corpus.

    guard-corpus SESSION [SESSION ...] [--projects-dir DIR] [--out FILE] [--dry-run]

SESSION is a session id (looked up under every project dir in --projects-dir, default
~/.claude/projects) or the path of a session's main transcript. For each subagent transcript
beside it (`<session>/subagents/*.jsonl`, role from its `.meta.json` agentType) it takes every Bash
call and appends one line to the corpus (default tests/fixtures/guard-corpus.jsonl):

    {"role": "orchestrate:worker", "command": "...", "expected": "allow" | "deny"}

The main session's own calls are skipped: the guard never acts on them. Transcripts are only
read. The command is normalised first (home and repo paths, emails, token-shaped strings,
heredoc bodies and long quoted text are replaced by TEXT, BODY, REDACTED or zeros), and no tool output is read. A line whose
(role, command) is already in the corpus is skipped, so rerunning on the same or later sessions
only adds new lines and never changes a label, including a hand-corrected one. A new line's
`expected` is a snapshot of what hooks/guard.py decides now; review it, and relabel by hand
only with a ticket for the guard (see tests/test_guard_corpus.py, "gap").

Exit codes: 0 done; 2 could not run (no transcript for a SESSION).
"""

import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

import common
import runlog
import session

ROOT = Path(__file__).resolve().parent.parent
GUARD = ROOT / "hooks" / "guard.py"
DEFAULT_OUT = ROOT / "tests" / "fixtures" / "guard-corpus.jsonl"

TOKENS = re.compile(
    r"\b(?:gh[pousr]_[A-Za-z0-9]{20,}|github_pat_\w{20,}|sk-[A-Za-z0-9_-]{16,}|xox[a-z]-[\w-]{10,}"
    r"|AKIA[0-9A-Z]{16}|AIza[\w-]{30,}|eyJ[\w-]{10,}\.[\w-]{10,}\.[\w-]{10,})"
    r"|(?i:\b(?:bearer|token|secret|password|passwd|api[_-]?key)\b(?:\s+|\s*[=:]\s*)(?!REDACTED)[^\s'\"]{8,})"
)
SHA = re.compile(r"\b[0-9a-f]{40}\b")
LONG_RUN = re.compile(r"(?<![\w/.-])(?=[A-Za-z0-9+_-]*\d)(?=[A-Za-z0-9+_-]*[A-Za-z])[A-Za-z0-9+_-]{32,}(?![\w/.-])")
EMAIL = re.compile(r"[\w.+-]+@[\w-]+(?:\.[\w-]+)+")
HOME = re.compile(r"(?:/Users|/home)/[^/\s'\"]+")
HEREDOC = re.compile(r"(<<-?\s*(['\"]?)(\w+)\2[^\n]*\n)(.*?)(\n[ \t]*\3[ \t]*(?:\n|$))", re.DOTALL)
# The account in a repo path or flag (repos/<acct>/..., github.com/<acct>/..., --repo <acct>/...).
OWNER = re.compile(r"(repos/|github\.com/|(?:--repo|-R)[ =])(?!owner/|\{)[\w.-]+/")
MANGLED_HOME = re.compile(r"-(?:Users|home)-(?!owner\b)[^-/\s]+")  # a project dir name: /Users/x/y -> -Users-x-y
UUID = re.compile(r"\b[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\b")
TMP_DIR = re.compile(r"/private/tmp/claude-\d+/|/var/folders/[^/\s]+/[^/\s]+/T/(?:tmp[\w.]*/?)?")
TOOL_USE_ID = re.compile(r"\btoolu_\w+")
AGENT_ID = re.compile(r"\b(?:agent-)?a[0-9a-f]{16}\b|(?<=agent-)[0-9a-f]{16,}\b")
SSH_KEY = re.compile(r"\.ssh/[^\s'\"]+")
SSH_SOCK = re.compile(r"(SSH_AUTH_SOCK=)[^\s'\"]+")


def _blank_json(value, key=None):
    """A JSON payload keeps its shape and its `event`; every other string becomes `x`."""
    if isinstance(value, dict):
        return {k: _blank_json(v, k) for k, v in value.items()}
    if isinstance(value, list):
        return [_blank_json(v) for v in value]
    if isinstance(value, str) and key != "event":
        return "x"
    return value


def _heredoc(m):
    body = m.group(4)
    try:
        payload = json.loads(body)
    except ValueError:
        replacement = "BODY"
    else:
        replacement = json.dumps(_blank_json(payload))
    return m.group(1) + replacement + m.group(5)


def shorten_quoted(command, limit=60):
    """Replace the text of each long quoted string with `<text>`, reading quotes as a shell does
    (no escapes inside single quotes, backslash escapes inside double quotes and outside quotes),
    so nested quoting stays paired. Any `$`, backtick or backslash in the text is kept, after a space, because
    the guard looks for them in review bodies."""
    out, i, n = [], 0, len(command)
    while i < n:
        c = command[i]
        if c == "\\":
            out.append(command[i:i + 2])
            i += 2
        elif c in "'\"":
            j = i + 1
            while j < n and command[j] != c:
                j += 2 if (c == '"' and command[j] == "\\") else 1
            if j >= n:  # unterminated: leave the rest alone
                out.append(command[i:])
                break
            text = command[i + 1:j]
            if len(text) >= limit:
                keep = "".join(k for k in "\\`$" if k in text)
                text = "TEXT" + (" " + keep + "." if keep else "")
            out.append(c + text + c)
            i = j + 1
        else:
            out.append(c)
            i += 1
    return "".join(out)


def normalise(command, repo_roots=()):
    for root in sorted(set(repo_roots), key=len, reverse=True):
        command = command.replace(root, "/repo")
    command = re.sub(r"/repo/\.claude/worktrees/[\w-]+", "/repo/.claude/worktrees/agent-x", command)
    # The extracting user's own home first, read at run time: the generic patterns below can't tell where
    # a dashed or dotted name ends in the mangled form (-Users-jane-doe-code). Another user's dashed name
    # in a transcript can still be only half scrubbed.
    home = str(Path.home())
    if len(home) > len("/home/x"):
        command = command.replace(re.sub(r"[/.]", "-", home), "-Users-owner").replace(home, "/home/user")
    command = UUID.sub("00000000-0000-0000-0000-000000000000", command)
    command = TMP_DIR.sub(lambda m: "/private/tmp/claude-0/" if m.group().startswith("/private") else "/var/folders/xx/yy/T/", command)
    command = TOOL_USE_ID.sub("toolu_REDACTED", command)
    command = AGENT_ID.sub("agent-x", command)
    command = SSH_KEY.sub(".ssh/KEY", command)
    command = SSH_SOCK.sub(r"\1SOCK", command)
    command = MANGLED_HOME.sub("-Users-owner", command)
    command = HEREDOC.sub(_heredoc, command)
    command = shorten_quoted(command)
    command = TOKENS.sub("REDACTED", command)
    command = SHA.sub("0" * 40, command)
    command = LONG_RUN.sub("REDACTED", command)
    command = EMAIL.sub("user@example.com", command)
    command = HOME.sub("/home/user", command)
    return OWNER.sub(r"\1owner/", command)


def decide(role, command, cwd):
    """The guard's decision for one call, run as the hook runs it."""
    payload = {"tool_name": "Bash", "tool_input": {"command": command}, "cwd": cwd}
    if role:
        payload["agent_type"] = role
    cmd = [sys.executable, "-I", str(GUARD)]
    p = subprocess.run(cmd, input=json.dumps(payload), capture_output=True, text=True)
    if p.returncode != 0:
        common.die(f"guard-corpus: the guard crashed (exit {p.returncode}): {' '.join(cmd)}\n"
                   f"  on command: {command[:200]}\n  stderr: {p.stderr.strip()}")
    out = p.stdout
    return "deny" if out and json.loads(out)["hookSpecificOutput"]["permissionDecision"] == "deny" else "allow"


def write_config(cwd):
    """A cwd whose config turns review posting on, so a well-formed review post is judged on its shape.
    tests/test_guard_corpus.py builds the same one."""
    (Path(cwd) / ".claude").mkdir(exist_ok=True)
    (Path(cwd) / ".claude" / "orchestration.md").write_text("- **Post reviews:** yes\n")


def find_session(arg, projects_dir):
    found = common.find_transcript(arg, projects_dir)
    if not found:
        print(f"guard-corpus: no transcript for session {arg!r} under {projects_dir}", file=sys.stderr)
        sys.exit(2)
    return found


def mine(main_transcript):
    """(role, normalised command) per subagent Bash call in a session, in transcript order.

    The repo a call is normalised against is the main checkout its cwd belongs to (runlog.main_checkout,
    which also finds the checkout of a worktree the harness has since removed); looked up once per cwd."""
    checkouts = {}
    for role, transcript in session.subagents(session.Transcript(main_transcript)):
        for command, cwd in transcript.bash_calls():
            if cwd not in checkouts:
                # When the worktree and its checkout are both gone, git can't answer and main_checkout returns the
                # path itself: the text before `/.claude/worktrees/` still names the checkout.
                checkouts[cwd] = str(runlog.main_checkout(cwd)).split("/.claude/worktrees/")[0] if cwd else None
            root = checkouts[cwd]
            yield role, normalise(command, [root] if root else [])


def main():
    ap = argparse.ArgumentParser(description="Add a session's subagent Bash calls to the guard corpus.")
    ap.add_argument("sessions", nargs="+", help="session id or main transcript path")
    ap.add_argument("--projects-dir", default="~/.claude/projects")
    ap.add_argument("--out", default=str(DEFAULT_OUT))
    ap.add_argument("--dry-run", action="store_true", help="report what would be added; write nothing")
    args = ap.parse_args()

    out = Path(args.out)
    raw = out.read_text(encoding="utf-8").splitlines() if out.exists() else []
    lines, seen = [], set()
    for n, line in enumerate(raw, 1):  # number the file's own lines; blank ones are skipped, not kept
        if not line.strip():
            continue
        try:
            r = json.loads(line)
            seen.add((r["role"], r["command"]))
        except (ValueError, KeyError, TypeError):
            common.die(f"guard-corpus: {out}: line {n} is not a corpus row: {line[:80]}")
        lines.append(line)
    added = []
    with tempfile.TemporaryDirectory() as cwd:
        write_config(cwd)
        for session in args.sessions:
            for role, command in mine(find_session(session, args.projects_dir)):
                if (role, command) in seen:
                    continue
                seen.add((role, command))
                row = {"role": role, "command": command, "expected": decide(role, command, cwd)}
                added.append(json.dumps(row, ensure_ascii=False))
    if not args.dry_run and added:
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text("\n".join(lines + added) + "\n")
    print(f"{'would add' if args.dry_run else 'added'} {len(added)} line(s); corpus has {len(lines) + len(added)}")


if __name__ == "__main__":
    main()
