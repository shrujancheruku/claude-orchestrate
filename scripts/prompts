#!/usr/bin/env python3
"""prompts [--repo DIR] [--session ID] [--since ISO | --watermark | --mark] : the permission prompts a run gave the developer.

Reads `.claude/orchestrate-prompts.jsonl` in the main checkout, which hooks/prompt_log.py appends to on every
PermissionRequest (#569) and every permission Notification (#579). A prompt both events saw counts once: a
notification line within 2 seconds of a request line of the same session is dropped; an unpaired notification
(a prompt PermissionRequest never sees, such as the sensitive-file check) counts on its own, listed with the
tool `?` and the notification's message. Prints, in this order:
    prompts: <n>                    always, so a count of 0 shows
    by role: <role> <n>, ...        only with prompts; roles are worker, reviewer, scout... (agent_type), orchestrator (the logged
                                    `role`), lead (a session named lead), main (any other session with no agent_type)
    by tool: <tool> <n>, ...        only with prompts, most frequent first
    then one line per prompt, oldest first: `<time> <role> <tool> <first 200 characters of the command or path>`
The list shows the newest 40 prompts, with a `... <n> earlier` line first when more matched; the counts cover all.
--session ID keeps one session's prompts. --since ISO keeps prompts at or after that time.
--watermark means "since the last mark": the newer of the newest line of `.claude/orchestrate-prompts.mark` (written
by --mark) and the newest pass record (`profile.py record`, written only under --profile), both for --session only; with no
session only the sessionless marks (the lead's own) count, and no pass records. With neither yet it keeps everything and says so on the `prompts:` line
(`prompts: <n> (no mark yet: counted from the start of the log)`), so a whole-log count is never read as per-pass.
--mark appends the current time to the mark file for --session (or for no session), prints `mark: <time>`, and counts
nothing: the lead runs it after posting a digest, the orchestrator after a pass table, so every run has a mark whether
or not it uses --profile. --since, --watermark and --mark are exclusive.
--all lists every prompt (no cutoff, no 40-line limit; exclusive with those three): `sweep` reads new prompt kinds with it.
No log yet is not an error: it prints `prompts: 0`. Exit codes: 0 ran; 2 could not run (bad --repo, --since or
no usable argument), one line on stderr. Stdlib only, Python 3.9+.
"""

import argparse
import json
import shutil
import sys
from collections import Counter
from datetime import datetime, timezone
from pathlib import Path

import common
import repo as repolib
import runlog

LOG = Path(".claude") / "orchestrate-prompts.jsonl"
MARK = Path(".claude") / "orchestrate-prompts.mark"
LIST_LIMIT = 40
DETAIL_WIDTH = 200
PAIR_WINDOW = 2  # seconds between a notification and the request of the same prompt


AGENTS_TIMEOUT = 15  # seconds `claude agents` may take: a hung call falls back to {} (#718) instead of hanging prompts, and the sweep with it
LEAD_NAME = "lead"  # the name scripts/launch --lead gives the lead's session
_names = None


def session_names() -> dict:
    """sessionId -> name from `claude agents --json --all`, read once. {} when `claude` is missing or answers badly:
    a count must not fail on it, so a session it cannot name falls back to `main`."""
    global _names
    if _names is None:
        _names = {}
        if shutil.which("claude"):
            code, out, _ = common.run("claude", "agents", "--json", "--all", timeout=AGENTS_TIMEOUT)
            try:
                rows = json.loads(out) if code == 0 else None
            except ValueError:
                rows = None
            for r in rows if isinstance(rows, list) else []:
                if isinstance(r, dict) and isinstance(r.get("sessionId"), str) and isinstance(r.get("name"), str):
                    _names[r["sessionId"]] = r["name"]
    return _names


def role(entry: dict) -> str:
    """Whose prompt it is (#642): `agent_type` set -> that role; else the `role` field the hook logged from
    ORCHESTRATE_ROLE (`orchestrator`); else a session named `lead` in `claude agents --json --all` -> `lead`; else
    `main`, a hand-started session. Lines logged before the `role` field fall to the name lookup, then `main`."""
    agent = entry.get("agent_type")
    if isinstance(agent, str) and agent:
        return agent.split(":", 1)[-1]
    # A notification of a worker's prompt may carry no agent_type, but its type says whose prompt it is.
    if entry.get("notification_type") == "worker_permission_prompt":
        return "worker"
    if entry.get("role") == "orchestrator":
        return "orchestrator"
    if session_names().get(entry.get("session_id")) == LEAD_NAME:
        return LEAD_NAME
    return "main"


def is_notification(entry: dict) -> bool:
    return entry.get("source") == "notification"


def dedupe(entries: list) -> list:
    """Count a prompt once (#579). A prompt can be seen by PermissionRequest (a `request` line) and by the
    Notification hook (a `notification` line); a notification within PAIR_WINDOW seconds of a request of the same
    session is the same prompt and is dropped (a request pairs with one notification at most). An unpaired
    notification is a prompt PermissionRequest never saw (the sensitive-file check) and counts on its own. A line
    with no `source` is a request (the log before #579)."""
    requests = [(repolib.parse_ts(e.get("time")), e.get("session_id"), i) for i, e in enumerate(entries) if not is_notification(e)]
    used, drop = set(), set()
    for i, e in enumerate(entries):
        if not is_notification(e):
            continue
        t = repolib.parse_ts(e.get("time"))
        best = None
        for rt, session, j in requests:
            if j in used or session != e.get("session_id") or t is None or rt is None:
                continue
            gap = abs((t - rt).total_seconds())
            if gap <= PAIR_WINDOW and (best is None or gap < best[0]):
                best = (gap, j)
        if best:
            used.add(best[1])
            drop.add(i)
    return [e for i, e in enumerate(entries) if i not in drop]


def detail(entry: dict) -> str:
    if is_notification(entry):
        return common.one_line(str(entry.get("message") or entry.get("title") or ""), DETAIL_WIDTH)
    tool_input = entry.get("tool_input")
    if isinstance(tool_input, dict):
        for key in ("command", "file_path", "path"):
            if tool_input.get(key):
                return common.one_line(tool_input[key], DETAIL_WIDTH)
        if isinstance(tool_input.get("keys"), list) and tool_input["keys"]:
            return common.one_line("(" + ", ".join(map(str, tool_input["keys"])) + ")", DETAIL_WIDTH)
    if isinstance(tool_input, list) and tool_input:
        return common.one_line("(" + ", ".join(map(str, tool_input)) + ")", DETAIL_WIDTH)
    return ""


def watermark(root: Path, session) -> object:
    """The newer of the newest mark and the newest pass record of this session, or None.

    With no session only the sessionless marks count (the lead's own): an orchestrator's
    pass table runs just before the lead's digest, and its marks must not move the lead's cutoff."""
    passes = runlog.read_passes(root, session) if session else []
    marks = [m for m in common.read_jsonl(repolib.main_checkout(root) / MARK) if (m.get("session") or None) == (session or None)]
    times = [t for t in (repolib.parse_ts(p.get("ts")) for p in passes + marks) if t]
    return max(times) if times else None


def write_mark(root: Path, session) -> str:
    """Append now as a mark (one line, so parallel runs stay whole) and return the time."""
    ts = datetime.now(timezone.utc).isoformat(timespec="seconds")
    path = repolib.main_checkout(root) / MARK
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "a", encoding="utf-8") as f:
        f.write(json.dumps({"ts": ts, "session": session or None}, separators=(",", ":")) + "\n")
    return ts


def render(entries: list, note: str = "", limit=LIST_LIMIT) -> list:
    lines = [f"prompts: {len(entries)}{note}"]
    if not entries:
        return lines
    by_role = Counter(role(e) for e in entries)
    by_tool = Counter(str(e.get("tool_name") or "?") for e in entries)
    lines.append("by role: " + ", ".join(f"{k} {n}" for k, n in sorted(by_role.items(), key=lambda kv: (-kv[1], kv[0]))))
    lines.append("by tool: " + ", ".join(f"{k} {n}" for k, n in sorted(by_tool.items(), key=lambda kv: (-kv[1], kv[0]))))
    shown = entries if limit is None else entries[-limit:]
    if len(entries) > len(shown):
        lines.append(f"... {len(entries) - len(shown)} earlier")
    for e in shown:
        lines.append(" ".join(p for p in (str(e.get("time") or "?"), role(e), str(e.get("tool_name") or "?"), detail(e)) if p))
    return lines


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0], allow_abbrev=False)
    ap.add_argument("--repo", default=".", help="a directory of the repository (default: the current one)")
    ap.add_argument("--session", help="only this session's prompts")
    since = ap.add_mutually_exclusive_group()
    since.add_argument("--since", help="only prompts at or after this ISO time")
    since.add_argument("--watermark", action="store_true", help="only prompts since the last mark or pass record")
    since.add_argument("--mark", action="store_true", help="record now as the mark the next --watermark counts from")
    since.add_argument("--all", action="store_true", help="list every prompt in the log, not the newest 40 (what `sweep` reads for new kinds)")
    args = ap.parse_args(argv)
    root = Path(args.repo).resolve()
    if not root.is_dir():
        common.die(f"prompts: cannot run: {args.repo} is not a directory")
    if args.mark:
        print(f"mark: {write_mark(root, args.session)}")
        return 0
    cutoff = None
    note = ""
    if args.since is not None:
        cutoff = repolib.parse_ts(args.since)
        if cutoff is None:
            common.die(f"prompts: cannot run: --since {args.since!r} is not an ISO time")
    elif args.watermark:
        cutoff = watermark(root, args.session)
        if cutoff is None:
            note = " (no mark yet: counted from the start of the log)"
    entries = [e for e in common.read_jsonl(repolib.main_checkout(root) / LOG)
               if not args.session or e.get("session_id") == args.session]
    entries = dedupe(entries)  # before the cutoff, so a pair straddling it is dropped whole
    if cutoff is not None:
        entries = [e for e in entries if (t := repolib.parse_ts(e.get("time"))) is not None and t >= cutoff]
    for line in render(entries, note, None if args.all else LIST_LIMIT):
        print(line)
    return 0


if __name__ == "__main__":
    sys.exit(main())
