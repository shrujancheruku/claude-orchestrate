#!/usr/bin/env python3
"""board [--repo PATH] [--dry-run] [--verbose] : sync the opt-in GitHub Projects board from tracker and PR state.

Reads the config's `- **Board:** <project URL>` line; with none it does nothing (exit 0, silent). Otherwise it
rebuilds each card's `Stage` from the tracker, the PRs and `claims` only, so a second run changes nothing. The columns
read left to right as a ticket's life:
    Backlog          open, unclaimed `ready-for-agent` tickets that are not parents, `lead` or `wayfinder:`: the
                     takeable ones in `frontier` order, then the held ones by number (tracker.backlog)
    Building         claimed, and `claims` says building, elsewhere, stalled or with-lead (a draft PR is building)
    In review        claimed, and `claims` says in-review (a ready PR)
    Needs lead       labelled `needs-lead`
    Waiting on you   labelled `ready-for-human` or `needs-info`, or claimed with no PR while the newest
                     `worker-report` in the run log for it is a `permission-denied` stop (the user must act)
                     (it stays there after the user allows the command, until the PR exists)
    Done             the ticket's PR merged; the card is archived a day after the merge
A card is added when its ticket first qualifies for Backlog, is first claimed, or is a `lead` ticket (which is never
assigned: no PR is Building, a ready PR In review, as `lead-route`'s LEAD-TICKET and LEAD-PR lines say). A Backlog card
whose ticket stops qualifying without being claimed (relabelled, closed) is deleted; one that gets claimed moves on. Cards in Backlog are put in order with `updateProjectV2ItemPosition`, writing only where a card's predecessor
differs, so an ordered column makes no write.
The column is the custom single-select field `Stage`, created on first sync: GitHub's built-in `Status` options
are not editable through `gh`. A field that lacks an option, or has them out of order, is upgraded in place through
`updateProjectV2Field`, keeping every existing option's id and color. Needs lead stays empty without a lead. The lead
never reads or writes the board. One tracker Snapshot serves the whole sync (and `lead-route`): no per-ticket calls.
Only cards whose content is an issue of this repository (repository plus number) are the board's: draft, hand-placed
and other repositories' cards are left alone. A card whose ticket closed without a merged PR is archived. If
`lead-route` fails, the lead's cards are skipped with one stderr line and the rest syncs. The sync reads the project's
fields and items once and writes only the difference from the wanted state (an add, a move, an archive or a delete per
card that differs), so a board that already matches makes no write. `--dry-run` prints each write it would make (and each
card left alone), then `<n> writes planned`, and makes none. `--verbose` prints `writes: <n>` on stderr: the writes
made (planned, with `--dry-run`).
Exit codes: 0 synced or no board; 1 any failure, one line on stderr (`run` carries on: the board never fails a pass).
Stdlib only, Python 3.9+.
"""

import argparse
import json
import re
import sys
import tempfile
from datetime import datetime, timedelta, timezone
from pathlib import Path

import claims
import common
import config
import github
import runlog
import tracker
from repo import STATE, parse_ts, ticket_of_branch

LEAD_ROUTE = Path(__file__).resolve().parent / "lead-route"
FIELD = "Stage"
BACKLOG, BUILDING, REVIEW = "Backlog", "Building", "In review"
NEEDS_LEAD, WAITING, DONE = "Needs lead", "Waiting on you", "Done"
STAGES = [BACKLOG, BUILDING, REVIEW, NEEDS_LEAD, WAITING, DONE]  # left to right on the board layout
NEW_OPTION_COLOR = "GRAY"
ARCHIVE_AFTER = timedelta(days=1)
PROJECT_URL = re.compile(r"^https://[^/]+/(?:orgs|users)/([^/]+)/projects/(\d+)/?")
LEAD_LINE = re.compile(r"^LEAD-(TICKET|PR) #(\d+)(?: (\d+))?$")
# The board is the coarse view: every claim state that is not in review or done is Building. Liveness and stalls
# stay in the pass table (`claims`).
CLAIM_STAGE = {"building": BUILDING, "elsewhere": BUILDING, "stalled": BUILDING, "with-lead": BUILDING,
               "in-review": REVIEW, "done": DONE}


def permission_denied(repo, found) -> set:
    """The claimed tickets whose newest worker report is a permission-denied stop and that have no PR yet: the
    worker's finished branch waits on the user (the marker is the run log, so a later session sees it too)."""
    out = set()
    for t, claim in found.items():
        if claim.state == "in-review":
            continue
        last = runlog.latest_event(repo, runlog.WORKER_REPORT, t, skip_outcomes=("duplicate",))
        if last and last.get("stop_reason") == "permission-denied":
            out.add(t)
    return out


def desired(issues, found, denied=(), backlog=(), lead=None):
    """{ticket: (stage, issue, addable)} for the open tickets that belong on the board. found: claims.claims' {ticket:
    Claim}, which holds every claimed open ticket. backlog: the Backlog tickets' numbers. lead: {ticket: stage} for the
    lead's tickets (lead_stages). addable: the ticket gets a card when it has none (it is claimed, a lead ticket, or
    in Backlog); a labelled ticket that is none of those only moves an existing card."""
    lead = lead or {}
    out = {}
    for issue in issues:
        n = issue["number"]
        labels = issue["labels"]
        claimed = issue["claimed"]
        if "needs-lead" in labels:
            stage, addable = NEEDS_LEAD, claimed
        elif labels & {"ready-for-human", "needs-info"} or n in denied:
            stage, addable = WAITING, claimed
        elif n in lead:
            stage, addable = lead[n], True
        elif claimed:
            stage, addable = CLAIM_STAGE[found[n].state], True
        elif n in backlog:
            stage, addable = BACKLOG, True
        else:
            continue
        out[n] = (stage, issue, addable)
    return out


def lead_stages(lines, open_prs) -> dict:
    """{ticket: stage} from lead-route's LEAD-TICKET and LEAD-PR lines: no PR or a draft is Building, a ready PR In
    review. open_prs: {PR number: isDraft}."""
    out = {}
    for line in lines:
        m = LEAD_LINE.match(line.strip())
        if m:
            kind, n, pr = m.group(1), int(m.group(2)), m.group(3)
            out[n] = REVIEW if kind == "PR" and not open_prs.get(int(pr), True) else BUILDING
    return out


def lead_lines(snapshot_file, root) -> list:
    """lead-route's output for this snapshot. It decides which open tickets are the lead's and where their PRs are;
    the board decides nothing of that itself. --lead none and --cap 1 only satisfy its arguments: the lines used here
    do not depend on them."""
    r = common.run(sys.executable, str(LEAD_ROUTE), "--lead", "none", "--cap", "1", "--repo", str(root),
                   "--snapshot", str(snapshot_file), cwd=root)
    if r.code != 0:
        raise github.GhError(github.FAILED, (r.stderr.strip().splitlines() or ["lead-route failed"])[0])
    return r.stdout.splitlines()


def literal_options(options) -> str:
    """The GraphQL literal for updateProjectV2Field's singleSelectOptions. An existing option keeps its id, color and
    description (so a card keeps its column); names are JSON strings, which GraphQL reads the same."""
    parts = []
    for o in options:
        if not re.fullmatch(r"[A-Z_]+", o["color"]):
            raise github.GhError(github.MALFORMED, "board field has an unreadable option color")
        id_part = f"id: {json.dumps(o['id'])}, " if o.get("id") else ""
        parts.append("{" + f"{id_part}name: {json.dumps(o['name'])}, color: {o['color']}, "
                     f"description: {json.dumps(o['description'])}" + "}")
    return "[" + ", ".join(parts) + "]"


class Writes:
    """Every write the sync makes goes through here, so `--dry-run` can print the plan instead of making the writes.
    The reads stay real. `planned` is what the write would have returned, for the steps after it."""

    def __init__(self, dry=False):
        self.dry = dry
        self.count = 0  # the writes made, or in a dry run the writes planned

    def do(self, what, run, planned=None):
        self.count += 1
        if self.dry:
            print(f"would {what}")
            return planned
        return run()


def upgrade_field(field, repo, writes):
    """Add the missing options to an existing Stage field and put them in STAGES order, in one updateProjectV2Field
    call that keeps every existing option's id and color. No write when the field already matches. Returns the field's
    {option name: id}."""
    current = field.get("options") or []
    names = [o["name"] for o in current]
    if [n for n in names if n in STAGES] == STAGES:
        return {o["name"]: o["id"] for o in current}
    node = github.call_json("api", "graphql", "-f", "query=query($id: ID!) { node(id: $id) { ... on "
                            "ProjectV2SingleSelectField { options { id name color description } } } }",
                            "-f", f"id={field['id']}", cwd=repo)
    have = node["data"]["node"]["options"]
    by_name = {o["name"]: o for o in have}
    wanted = [by_name.get(s) or {"name": s, "color": NEW_OPTION_COLOR, "description": ""} for s in STAGES]
    wanted += [o for o in have if o["name"] not in STAGES]  # an option someone added by hand stays, after ours
    query = ("mutation { updateProjectV2Field(input: {fieldId: " + json.dumps(field["id"]) + ", singleSelectOptions: "
             + literal_options(wanted) + "}) { projectV2Field { ... on ProjectV2SingleSelectField "
             "{ options { id name } } } } }")
    reply = writes.do(f"update field {FIELD} options to {', '.join(o['name'] for o in wanted)} (ids kept)",
                      lambda: github.call_json("api", "graphql", "-f", f"query={query}", cwd=repo))
    if reply is None:  # a dry run: the new option has no id yet
        return {o["name"]: o.get("id") or f"new:{o['name']}" for o in wanted}
    return {o["name"]: o["id"] for o in reply["data"]["updateProjectV2Field"]["projectV2Field"]["options"]}


def move_after(project_id, item_id, after_id, repo, writes):
    """Put a card right after another (the first card when after_id is None): the Board layout orders cards inside a
    column by this position, and `gh project item-edit` cannot change it."""
    after = f", afterId: {json.dumps(after_id)}" if after_id else ""
    query = ("mutation { updateProjectV2ItemPosition(input: {projectId: " + json.dumps(project_id)
             + ", itemId: " + json.dumps(item_id) + after + "}) { clientMutationId } }")
    writes.do(f"move card {item_id} " + (f"after {after_id}" if after_id else "to the top"),
              lambda: github.call_json("api", "graphql", "-f", f"query={query}", cwd=repo))


def order_backlog(want_ids, current_ids, project_id, repo, writes):
    """Move the Backlog cards into want_ids order, writing only where a card's predecessor differs. current_ids is
    their present order; a card is only moved when it is not already where the order puts it."""
    cur = list(current_ids)
    for i, item in enumerate(want_ids):
        if cur[i] == item:
            continue
        move_after(project_id, item, want_ids[i - 1] if i else None, repo, writes)
        cur.remove(item)
        cur.insert(i, item)


def repository_of(content) -> str:
    """The `owner/name` a project item's content belongs to (gh prints a string; the API's shape is a dict)."""
    repository = (content or {}).get("repository")
    return repository.get("nameWithOwner") if isinstance(repository, dict) else repository


def sync(owner, number, repo, writes=None):
    writes = writes or Writes()
    own = ["--owner", owner]
    root = Path(repo).resolve()
    # One tracker read serves the whole sync: the issues (Backlog, claims, labels), the open and merged PRs (claims,
    # the lead's tickets) and, through a file, lead-route. Only the merge times of the archive come from another call.
    try:
        labels = tracker.label_strings(root)
    except ValueError as e:
        raise github.GhError(github.FAILED, str(e)) from None
    snap = tracker.Snapshot(root)
    issues, open_prs, merged_prs = snap.issues, snap.prs, snap.merged
    slug = f"{snap.repo['owner']['login']}/{snap.repo['name']}"
    try:
        found = claims.claims(root, root / STATE, issues, open_prs, merged_prs)
    except ValueError as e:  # claims could not run (an unreadable state file, a failed git call)
        raise github.GhError(github.FAILED, str(e)) from None
    lead = {}
    try:
        with tempfile.TemporaryDirectory() as tmp:
            shared = Path(tmp) / "snapshot.json"
            tracker.Snapshot(root, repo=snap.repo, issues=issues, prs=open_prs, merged=merged_prs,
                             abandoned=[]).write(shared)
            lead = lead_stages(lead_lines(shared, root), {p.get("number"): bool(p.get("isDraft")) for p in open_prs})
    except github.GhError as e:
        # Plugin features degrade: the worker and Backlog cards still sync, only the lead's cards are skipped.
        print(f"board: lead cards skipped: lead-route failed: {common.one_line(e.message)}", file=sys.stderr)
    in_backlog = tracker.backlog(issues, labels)
    merged_at = github.call_json("pr", "list", "--state", "merged", "--limit", "100", "--json",
                                 "number,headRefName,mergedAt", shape=list, cwd=repo)

    proj = github.call_json("project", "view", str(number), *own, "--format", "json", cwd=repo)
    fields = github.call_json("project", "field-list", str(number), *own, "--format", "json", cwd=repo)
    field = next((f for f in fields.get("fields", []) if f.get("name") == FIELD), None)
    if field is None:
        field = writes.do(f"create field {FIELD} with options {', '.join(STAGES)}", lambda: github.call_json(
            "project", "field-create", str(number), *own, "--name", FIELD, "--data-type", "SINGLE_SELECT",
            "--single-select-options", ",".join(STAGES), "--format", "json", cwd=repo),
            {"id": "new:field", "options": [{"id": f"new:{s}", "name": s} for s in STAGES]})
    # A board made before a column existed is upgraded in place, never refused.
    options = upgrade_field(field, repo, writes)
    merged = {}
    for p in merged_at:
        t, at = ticket_of_branch(p.get("headRefName")), parse_ts(p.get("mergedAt"))
        if t and at:
            merged[t] = max(merged.get(t, at), at)
    items = github.call_json("project", "item-list", str(number), *own, "--limit", "1000", "--format", "json",
                             cwd=repo).get("items", [])
    # The board's own cards are this repository's issues, keyed by number within it. A draft card, a hand-placed card
    # or another repository's issue (whose number may collide with ours) is never moved, archived or deleted.
    cards, left = {}, []
    for i in items:
        c = i.get("content") or {}
        if c.get("type") == "Issue" and repository_of(c) == slug and isinstance(c.get("number"), int):
            cards[c["number"]] = i
        else:
            left.append(i)
    if writes.dry:
        for i in left:
            c = i.get("content") or {}
            print(f"left alone: {c.get('type') or 'card'} {repository_of(c) or ''}#{c.get('number', '')} "
                  f"{c.get('title') or i.get('title') or i.get('id')}".replace("  ", " "))

    def set_stage(card_id, stage):
        writes.do(f"move card {card_id} to {stage}", lambda: github.call(
            "project", "item-edit", "--id", card_id, "--project-id", proj["id"], "--field-id", field["id"],
            "--single-select-option-id", options[stage], cwd=repo))

    def delete(card_id, t):
        writes.do(f"delete card {card_id} (#{t})", lambda: github.call(
            "project", "item-delete", str(number), *own, "--id", card_id, cwd=repo))

    def archive(card_id, t):
        writes.do(f"archive card {card_id} (#{t})", lambda: github.call(
            "project", "item-archive", str(number), *own, "--id", card_id, cwd=repo))

    want = desired(issues, found, permission_denied(repo, found), {i["number"] for i in in_backlog}, lead)
    ids = {}  # ticket -> card id, for the Backlog ordering below
    for t, (stage, issue, addable) in sorted(want.items()):
        card = cards.get(t)
        if card is None:
            if not addable:
                continue
            added = writes.do(f"add a card for #{t}", lambda: github.call_json(
                "project", "item-add", str(number), *own, "--url", issue["url"], "--format", "json", cwd=repo),
                {"id": f"new:{t}"})
            card = {"id": added["id"]}
            cards[t] = card
        elif not addable and card.get(FIELD.lower()) == BACKLOG:
            # It no longer qualifies (relabelled) and nobody claimed it: it leaves the board.
            delete(card["id"], t)
            del cards[t]
            continue
        ids[t] = card["id"]
        if card.get(FIELD.lower()) != stage:
            set_stage(card["id"], stage)
    now = datetime.now(timezone.utc)
    for t, at in sorted(merged.items()):
        card = cards.get(t)
        if card is None or t in want:
            continue
        if now - at > ARCHIVE_AFTER:
            archive(card["id"], t)
        elif card.get(FIELD.lower()) != DONE:
            set_stage(card["id"], DONE)
        cards.pop(t)
    open_numbers = {i["number"] for i in issues}
    for t, card in sorted(cards.items()):
        stage = card.get(FIELD.lower())
        if t in want:
            continue
        if stage == BACKLOG:
            # It no longer qualifies (closed without a merged PR, or relabelled out of the tracker's sight): it leaves.
            delete(card["id"], t)
        elif t not in open_numbers and stage in (BUILDING, REVIEW, NEEDS_LEAD, WAITING):
            # A card's life ends with its ticket: the ticket closed without a merged PR (a lead ticket, say).
            archive(card["id"], t)

    order = [t for t in (i["number"] for i in in_backlog) if want.get(t, (None,))[0] == BACKLOG]
    wanted_ids = [ids[t] for t in order]
    # The cards' present order is the project's item order; a card added just now is last.
    current = [c["id"] for c in items if c["id"] in wanted_ids]
    current += [i for i in wanted_ids if i not in current]
    order_backlog(wanted_ids, current, proj["id"], repo, writes)
    if writes.dry:
        print(f"{writes.count} write{'' if writes.count == 1 else 's'} planned")


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--repo", default=".", help="repo root: the config is read and gh runs there")
    ap.add_argument("--dry-run", action="store_true",
                    help="read everything, print each write the sync would make (and each card left alone), make none")
    ap.add_argument("--verbose", action="store_true", help="print `writes: <n>` (the writes made) on stderr")
    args = ap.parse_args(argv)
    url = config.Config.load(args.repo).board
    if not url:
        return 0
    m = PROJECT_URL.match(url)
    if not m:
        print(f"board: cannot read the Board URL: {url}", file=sys.stderr)
        return 1
    try:
        writes = Writes(args.dry_run)
        try:
            sync(m.group(1), int(m.group(2)), args.repo, writes)
        finally:
            if args.verbose:
                print(f"writes: {writes.count}", file=sys.stderr)
    except github.GhError as e:
        print(f"board: {common.one_line(e.message)}", file=sys.stderr)
        return 1
    except (KeyError, TypeError, ValueError, AttributeError):
        print("board: gh returned an unexpected reply", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
