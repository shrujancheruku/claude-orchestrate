#!/usr/bin/env python3
"""worker-report <ticket> --branch <branch> [--repo DIR] : classify a worker's completion (ADR 0006)
worker-report <pr> --reviewer                                : classify a reviewer's completion (#416)

Reads the worker's whole completion text (the harness notice plus the report) on stdin, ends with one
`next: <verdict>` line (ADR-0014; the verdicts below are the `next:` words, applied word for word) and appends a `worker-report` event to the run log. The orchestrator applies the line word for word:
    valid pr-opened <pr> <head>      `status: pr-opened` and an open non-draft PR exists; <pr> and <head> are the host's
    valid stopped <stop-reason>      `status: stopped` with a `stop-reason:` on the list below
    valid stopped transient exhausted  the third `transient` in a row on the same failed command (TRANSIENT_RETRIES retries done)
    interim                          no `status:` line, but text (a placeholder, a progress note)
    not-a-stop                       `status: stopped` with no `stop-reason:` line, or an unlisted one, or a
                                     `permission-denied` with no `denied-command:` line
    not-a-pr-opened                  `status: pr-opened`, but no open PR on the report's `pr:` or on --branch
    duplicate <verdict>              the newest earlier verdict for this ticket was the same, with the same head and stop-reason
    missing-report pr <pr> <head>    a bare completion notice, and an open PR on --branch
    missing-report none              a bare completion notice, and no open PR on --branch
    limit [<reset time>]             no report, and the text names a usage limit
    error <gist>                     no report, and the text names another API error
With `--reviewer` the text is a reviewer's short report and no PR is looked up and no `--branch` is needed. It appends one
`review` event (ref = the PR; outcome approve | request-changes | incomplete; round, head, suite, blocking, non_blocking, posted;
nothing for a resent report with the same round, head and outcome), which `claims` reads for escalation. It prints `valid` when the report has a `suite:` line that is `pass` or `fail` (alone or followed by free text,
such as `pass (py_compile, run_parallel)` or `fail 2`) or `not run (<reason>)`,
else `incomplete <why>` (`suite-missing`, `suite-not-run-without-reason` or `suite-unrecognised`): the orchestrator
sends an incomplete report back to the reviewer once.
`--reviewer --post-risk-notes` also posts the report's `risk-notes:` lines (`path:line-range — what to look at`, word for
word) as one PR comment whose first line is `> *Risk notes (review not posted).*`, when the report says `posted: off` or
`posted: failed...`, and never twice: a trusted author's comment with that first line already on the PR is left alone. It
prints a line before the verdict: `risk-notes posted`, `risk-notes exists` or `risk-notes none` (a posted review
carries them, or there are none) or `risk-notes unparsed` (the report has a `risk-notes:` line that holds no
`path:line-range — what to look at` note; the orchestrator posts nothing and tells the user). A failed post is exit 2.
Stop reasons: held-path, no-spec, ambiguous, adr-conflict, human-only, verify-outside-ticket, already-done,
no-primary-source, worktree-gone, transient (a host failure nobody decides: the event carries `retry_after` and
`failed_command`; a `permission-denied` or `human-only` report whose text names a rate limit or a wait-until time is
reclassified `transient`), permission-denied (which also needs the exact denied command in `denied-command:`; the event
carries it). A report's `refused:` lines (one per tool call the harness or guard refused) ride in the event as
`refused: [...]` (`refused: none` is `[]`, no line leaves the field out); the verdict never depends on them. A `followup-needed: <gist>` line (the worker's request for the one follow-up ticket of the threads it left) rides in the event as `followup_needed`, and never changes the verdict. Exit codes: 0 printed a verdict; 2 could not run (no `gh`, a failed PR lookup, an unwritable
run log): one line on stderr and `next: could-not-run` (`next: retry-after <time>` on a rate limit), run it again on the next wake.
With `--post-risk-notes` the `risk-notes <word>` line comes before the `next:` line. Stdlib only, Python 3.9+.
"""

from __future__ import annotations

import argparse
import re
import sys

import common
import github
import runlog
import session

STOP_REASONS = ("held-path", "no-spec", "ambiguous", "adr-conflict", "human-only",
                "verify-outside-ticket", "already-done", "no-primary-source", "permission-denied", "worktree-gone", "transient")
# The orchestrator retries a `transient` stop without the developer, at most this many times per failed command.
TRANSIENT_RETRIES = 2
RATE_LIMIT = re.compile(r"(?:api|secondary|github) rate[ -]limit|rate[ -]limit (?:exceeded|was hit|reset)", re.I)
# The phrase must be followed by a clock time or a date, so "waiting until you confirm" stays a human's.
WAIT_UNTIL = re.compile(r"\b(?:wait(?:ing)?|retry|try again|resets?)\s+(?:until|after|at)\s+(?:\d|`?\d{4}-\d\d)", re.I)
RETRY_AFTER = re.compile(r"^[ \t>*-]*retry-after:[ \t]*`*(.*?)`*[ \t]*$", re.I | re.M)
FAILED_COMMAND = re.compile(r"^[ \t>*-]*failed-command:[ \t]*`*([^\s`].*?)`*[ \t]*$", re.I | re.M)
STATUS = re.compile(r"^[ \t>*-]*status:[ \t]*(pr-opened|stopped)\b", re.I | re.M)
STOP_REASON = re.compile(r"^[ \t>*-]*stop-reason:[ \t]*`?([\w-]+)", re.I | re.M)
DENIED_COMMAND = re.compile(r"^[ \t>*-]*denied-command:[ \t]*`*([^\s`].*?)`*[ \t]*$", re.I | re.M)
REFUSED = re.compile(r"^[ \t>*-]*refused:[ \t]*`*(.*?)`*[ \t]*$", re.I | re.M)
FOLLOWUP_NEEDED = re.compile(r"^[ \t>*-]*followup-needed:[ \t]*`*([^\s`].*?)`*[ \t]*$", re.I | re.M)
REPORT_PR = re.compile(r"^[ \t>*-]*pr:[ \t]*\S*?/pull/(\d+)", re.I | re.M)
# The harness's own wrapper elements say nothing about the worker's work: a completion with only these is bare.
NOTICE = re.compile(r"<(task-id|tool-use-id|output-file|worktreePath|worktreeBranch|status|summary|usage)>.*?</\1>", re.S)
TAG = re.compile(r"</?[\w-]+>")
RESET = re.compile(r"resets?\s+(?:at|in)\s+([^.\n<]+)", re.I)
API_ERROR = re.compile(r"API Error|api_error|overloaded|internal server error|request failed|connection error|ECONNRESET", re.I)


def is_bare(text: str) -> bool:
    return not TAG.sub("", NOTICE.sub("", text)).strip()


def find_pr(prs: list, report_pr: str | None, branch: str):
    """The open PR the report names, else the one on the branch; None when neither is open. A draft is the worker's
    progress marker (ADR 0011), not the PR its `pr-opened` promises, so it never counts."""
    prs = [pr for pr in prs if not pr.get("isDraft")]
    for pr in prs:
        if report_pr and str(pr.get("number")) == report_pr:
            return pr
    for pr in prs:
        if pr.get("headRefName") == branch:
            return pr
    return None


def refused_calls(text: str):
    """The report's `refused:` lines as a list of strings; [] for `refused: none`; None when the report has no such line
    (an older worker prompt), so the event can tell "none refused" from "not reported"."""
    found = [m.group(1).strip() for m in REFUSED.finditer(text)]
    if not found:
        return None
    return [l for l in found if l and l.lower().rstrip(".") != "none"]


def classify(text: str, branch: str, lookup) -> tuple:
    """(verdict words, event fields). `lookup()` fetches the open PRs and is called only when a PR matters."""
    words, fields = _classify(text, branch, lookup)
    refused = refused_calls(text) if STATUS.search(text) else None
    if refused is not None:
        fields = dict(fields, refused=refused)
    # The worker asks for the one follow-up ticket of its left threads (#442); the orchestrator files it.
    followup = FOLLOWUP_NEEDED.findall(text) if STATUS.search(text) else []
    if followup:
        fields = dict(fields, followup_needed=followup[-1])
    return words, fields


def _classify(text: str, branch: str, lookup) -> tuple:
    m = STATUS.search(text)
    if not m:
        if session.LIMIT_TEXT.search(text):
            reset = RESET.search(text)
            return ("limit", reset.group(1).strip()) if reset else ("limit",), {}
        if API_ERROR.search(text):
            line = next(l for l in text.splitlines() if API_ERROR.search(l))
            return ("error", common.one_line(re.sub(r"<[^>]*>", "", line).strip(), 120)), {}
        if is_bare(text):
            pr = find_pr(lookup(), None, branch)
            if pr:
                return ("missing-report", "pr", str(pr["number"]), pr["headRefOid"]), {"head": pr["headRefOid"], "pr": pr["number"]}
            return ("missing-report", "none"), {}
        return ("interim",), {}
    status = m.group(1).lower()
    if status == "stopped":
        r = STOP_REASON.search(text)
        reason = r.group(1).lower() if r else None
        # A rate limit, or a wait for a stated time, is a host failure no human decides, whatever the worker called it.
        mislabelled = reason in ("permission-denied", "human-only") and (RATE_LIMIT.search(text) or WAIT_UNTIL.search(text))
        if reason == "transient" or mislabelled:
            reason = "transient"
            ra, fc = RETRY_AFTER.search(text), FAILED_COMMAND.search(text) or DENIED_COMMAND.search(text)
            return ("valid", "stopped", reason), {"status": status, "stop_reason": reason,
                                                  "retry_after": ra.group(1).strip() if ra else "",
                                                  "failed_command": fc.group(1).strip() if fc else ""}
        if reason == "permission-denied":
            # Nothing can resume a denial without the command: the user runs it with `!`, or allows it.
            d = DENIED_COMMAND.search(text)
            if not d:
                return ("not-a-stop",), {"status": status}
            return ("valid", "stopped", reason), {"status": status, "stop_reason": reason,
                                                  "denied_command": d.group(1).strip()}
        if reason in STOP_REASONS:
            return ("valid", "stopped", reason), {"status": status, "stop_reason": reason}
        return ("not-a-stop",), {"status": status}
    rp = REPORT_PR.search(text)
    pr = find_pr(lookup(), rp.group(1) if rp else None, branch)
    if not pr:
        return ("not-a-pr-opened",), {"status": status}
    return ("valid", "pr-opened", str(pr["number"]), pr["headRefOid"]), {"status": status, "head": pr["headRefOid"], "pr": pr["number"]}


SUITE = re.compile(r"^[ \t>*-]*suite:[ \t]*`*(.*?)`*[ \t]*$", re.I | re.M)
# `pass` or `fail`, alone or followed by free text (`pass (py_compile, run_parallel)`, `fail 2`); `not run` needs a reason.
SUITE_OK = re.compile(r"(?:pass|fail)(?![\w-])`*(?:[ \t,:(;.-].*)?|not run\s*\(\s*\S[^)]*\)", re.I)


def classify_reviewer(text: str) -> tuple:
    """`("valid",)` or `("incomplete", why)` for a reviewer's report. The last `suite:` line counts."""
    found = SUITE.findall(text)
    if not found:
        return ("incomplete", "suite-missing")
    value = found[-1].strip()
    if SUITE_OK.fullmatch(value):
        return ("valid",)
    if re.fullmatch(r"not run\s*(\(\s*\))?", value, re.I):
        return ("incomplete", "suite-not-run-without-reason")
    return ("incomplete", "suite-unrecognised")


def _field(name, text):
    """The last `<name>: value` line of a reviewer's report, backticks and blanks trimmed; None when there is none."""
    found = re.findall(rf"^[ \t>*-]*{name}:[ \t]*`*(.*?)`*[ \t]*$", text, re.I | re.M)
    return found[-1].strip() if found and found[-1].strip() else None


def _count(name, text):
    value = _field(name, text)
    m = re.match(r"\d+", value or "")
    return int(m.group()) if m else None


def review_fields(words, text) -> tuple:
    """(outcome, event fields) of a reviewer's report: `approve | request-changes | incomplete`, then the round, the head
    reviewed, the suite line, the blocking and non-blocking counts and the `posted:` value (each None when absent)."""
    verdict = (_field("verdict", text) or "").lower()
    outcome = ("incomplete" if words[0] == "incomplete" else "approve" if verdict.startswith("approve")
               else "request-changes" if verdict.startswith(("change", "request")) else "incomplete")
    return outcome, {"round": _count("round", text), "head": _field("head", text), "suite": _field("suite", text),
                     "blocking": _count("blocking", text), "non_blocking": _count("non-blocking", text),
                     "posted": _field("posted", text)}


def record_review(repo, pr, words, text) -> None:
    """Append the `review` event for this report (ref = the PR), so review rounds are in the run log and `claims` can
    count them. The same PR, round, head and outcome as the newest earlier event writes nothing (a resent report)."""
    outcome, fields = review_fields(words, text)
    last = runlog.latest_event(repo, runlog.REVIEW, pr)
    if last and last.get("outcome") == outcome and all(last.get(k) == fields[k] for k in ("round", "head")):
        return
    try:
        runlog.append_event(repo, runlog.REVIEW, outcome, ref=pr, **fields)
    except runlog.NoSession as e:
        print(e, file=sys.stderr)  # the verdict line is the answer; only its log line is lost
    except OSError as e:
        common.die(f"worker-report: cannot write the run log: {e.strerror or e}")


# The first line of the fallback comment `--post-risk-notes` posts (scripts/lead-brief reads it back by this line).
RISK_MARKER = "> *Risk notes (review not posted).*"
RISK_NOTE = re.compile(r"^\s*[-*]?\s*`?([^\s`]+:\d+(?:-\d+)?)`?\s+—\s+(\S.*?)\s*$")  # backticks round the location are dropped


def risk_notes(text: str) -> list:
    """The notes of a reviewer's `risk-notes:` block, word for word: the rest of that line when it is a note, then each
    following line that is one (`path:line-range — what to look at`, bulleted or not), up to the first line that is not."""
    lines = text.splitlines()
    for i in range(len(lines) - 1, -1, -1):
        m = re.match(r"^[ \t>*-]*risk-notes:[ \t]*`*(.*?)`*[ \t]*$", lines[i], re.I)
        if not m:
            continue
        found = [f"{n.group(1)} — {n.group(2)}" for n in [RISK_NOTE.match(m.group(1))] if n]
        for line in lines[i + 1:]:
            n = RISK_NOTE.match(line)
            if not n:
                break
            found.append(f"{n.group(1)} — {n.group(2)}")
        return found
    return []


MAX_RISK_NOTES = 12  # the reviewer read an untrusted diff (ADR-0016): its text is bounded before it is posted
MAX_NOTE_CHARS = 300


def bound_risk_notes(notes: list) -> list:
    """The notes as the comment posts them: at most MAX_RISK_NOTES, each at most MAX_NOTE_CHARS long, with no live
    `@login` mention and no `> *` marker opener (a zero-width space breaks each), and a last line saying how many
    notes were dropped and how many cut."""
    kept = notes[:MAX_RISK_NOTES]
    out, cut = [], 0
    for n in kept:
        n = n.replace("@", "@​").replace("> *", ">​*")  # first, so the cap counts what is posted
        if len(n) > MAX_NOTE_CHARS:
            n, cut = n[:MAX_NOTE_CHARS - 1] + "…", cut + 1
        out.append(n)
    dropped = len(notes) - len(kept)
    if dropped or cut:
        out.append(f"(notes dropped: {dropped}; notes cut to {MAX_NOTE_CHARS} characters: {cut})")
    return out


def post_risk_notes(repo, pr, text) -> str:
    """Post the report's risk notes as one PR comment when the review was not posted (`posted: off` or `failed`), once:
    `posted`, `exists` (the PR already has a trusted author's comment starting with RISK_MARKER) or `none` (a posted
    review carries them, or the report has none). The script that reads the report posts it, so the orchestrator's
    own pass holds no hand-made dedupe (#545)."""
    notes = risk_notes(text)
    if not (_field("posted", text) or "").lower().startswith(("off", "failed")):
        return "none"
    if not notes:
        # A `risk-notes:` line with text that is no `path:line-range — what to look at` note: say so, never drop it silently.
        stated = (_field("risk-notes", text) or "").lower().rstrip(".")
        return "unparsed" if stated and stated != "none" else "none"
    try:
        trusted = github.trusted_logins(repo)
        if any(str(c.get("body") or "").strip().split("\n", 1)[0].strip() == RISK_MARKER
               and github.is_trusted(c.get("author_association"), (c.get("user") or {}).get("login"), trusted)
               for c in github.conversation_comments(pr, cwd=repo)):
            return "exists"
        github.call("api", "--method", "POST", f"repos/{{owner}}/{{repo}}/issues/{pr}/comments", "-f",
                    "body=" + "\n".join([RISK_MARKER, "", *bound_risk_notes(notes)]), cwd=repo)
    except github.GhError as e:
        common.die(f"worker-report: cannot post the risk notes: {e.message}")
    return "posted"


VERDICT: list = []  # the words of the last classification: the `next:` line of the run


def main(argv=None) -> int:
    """Run, then end with the one `next:` line, which is the classification word for word (ADR-0014)."""
    VERDICT.clear()
    return common.finish(run, argv, {0: lambda: tuple(VERDICT)})


def run(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0], allow_abbrev=False)
    ap.add_argument("ticket", help="the ticket number")
    ap.add_argument("--branch", help="the ticket's branch (required unless --reviewer)")
    ap.add_argument("--reviewer", action="store_true", help="classify a reviewer's report by its `suite:` line")
    ap.add_argument("--post-risk-notes", action="store_true",
                    help="with --reviewer: post the report's risk notes as one PR comment when its review was not posted (once)")
    ap.add_argument("--repo", default=".", help="a directory of the repository (default: the current one)")
    args = ap.parse_args(argv)
    if args.post_risk_notes and not args.reviewer:
        ap.error("--post-risk-notes goes with --reviewer")
    _, ticket = common.pr_ref(args.ticket)
    text = sys.stdin.read()
    if args.reviewer:
        words = classify_reviewer(text)
        record_review(args.repo, ticket, words, text)
        if args.post_risk_notes:
            print("risk-notes " + post_risk_notes(args.repo, ticket, text))
        VERDICT.extend(words)
        return 0
    if not args.branch:
        common.die("worker-report: --branch is required (unless --reviewer)")

    def lookup():
        try:
            return github.own_prs(github.open_prs_with_heads(cwd=args.repo))  # a fork PR is never the worker's (ADR-0015)
        except github.GhError as e:
            common.die(f"worker-report: cannot look up PRs: {e.message}")

    words, fields = classify(text, args.branch, lookup)
    if words[:3] == ("valid", "stopped", "transient"):
        if transient_run(args.repo, ticket, fields["failed_command"]) >= TRANSIENT_RETRIES:
            words = (*words, "exhausted")
            fields["exhausted"] = True
    elif words[0] == "valid" and runlog_dup(args.repo, ticket, words, fields):
        words = ("duplicate", *words)
    try:
        runlog.append_event(args.repo, runlog.WORKER_REPORT, words[0], ref=ticket, **fields)
    except runlog.NoSession as e:
        print(e, file=sys.stderr)  # the verdict line below is the answer
    except OSError as e:
        common.die(f"worker-report: cannot write the run log: {e.strerror or e}")
    VERDICT.extend(words)
    return 0


def norm_command(c) -> str:
    """A failed command compared without a leading `! ` and with its whitespace collapsed."""
    return re.sub(r"\s+", " ", re.sub(r"^\s*!\s*", "", c or "")).strip()


def transient_run(repo, ticket, command) -> int:
    """How many `transient` stops in a row, newest first and ending at the latest verdict for this ticket, were on
    this failed command: the retries already spent (a duplicate or an interim does not count; any other verdict ends the run)."""
    n = 0
    for e in reversed(list(common.read_jsonl(runlog.log_path(repo, runlog.EVENTS_LOG)))):
        if e.get("kind") != runlog.WORKER_REPORT or str(e.get("ref")) != str(ticket) or e.get("outcome") in ("duplicate", "interim"):
            continue
        if e.get("stop_reason") != "transient" or norm_command(e.get("failed_command")) != norm_command(command):
            break
        n += 1
    return n


def runlog_dup(repo, ticket, words, fields) -> bool:
    """True when the newest earlier verdict for this ticket (a duplicate does not count) matches this one."""
    last = runlog.latest_event(repo, runlog.WORKER_REPORT, ticket, skip_outcomes=("duplicate",))
    return bool(last) and last.get("outcome") == words[0] and all(
        last.get(k) == fields.get(k) for k in ("status", "head", "stop_reason", "denied_command"))


if __name__ == "__main__":
    sys.exit(main())
