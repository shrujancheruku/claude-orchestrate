#!/usr/bin/env python3
"""sandbox-git [--repo PATH] : let agents git fetch/pull/push over SSH under the sandbox.

On macOS, SSH from inside the sandbox fails even for an allowed host (plain ssh ignores the
proxy), so the documented fix is to run the git commands outside it. For an SSH `origin`
this merges into <repo>/.claude/settings.local.json:

    sandbox.excludedCommands       += "git fetch *", "git pull *", "git push *"
    sandbox.network.allowedDomains += <origin's host>

Lists are unioned without duplicates and every other key is kept. The file is created when
missing, and refused (exit 1, untouched) when it isn't a JSON object of the expected shape.
A non-SSH origin changes nothing. The file is local, so `.claude/settings.local.json` is
added to .gitignore if no line already names it.
Docs: https://code.claude.com/docs/en/sandboxing

Exit 0 done (or nothing to do), 1 refused. Stdlib only, Python 3.9+.
"""

import json
import re
import subprocess
import sys
from pathlib import Path

COMMANDS = ["git fetch *", "git pull *", "git push *"]
SETTINGS = ".claude/settings.local.json"


def ssh_host(url):
    m = re.match(r"^ssh://(?:[^@/]+@)?([^/:]+)", url) or re.match(r"^[^@/\s]+@([^:/\s]+):", url)
    return m.group(1) if m else None


def union(existing, wanted):
    return list(existing) + [w for w in wanted if w not in existing]


def refuse(why):
    print(f"refused: {SETTINGS} {why}; left untouched", file=sys.stderr)
    return 1


def main(argv):
    repo = Path(".")
    if argv:
        if argv[0] != "--repo" or len(argv) != 2:
            sys.exit("usage: sandbox-git [--repo PATH]")
        repo = Path(argv[1])
    r = subprocess.run(["git", "remote", "get-url", "origin"], cwd=repo, capture_output=True, text=True)
    host = ssh_host(r.stdout.strip()) if r.returncode == 0 else None
    if not host:
        print("origin is not an SSH remote: nothing to change")
        return 0

    path = repo / SETTINGS
    data = {}
    if path.exists():
        try:
            data = json.loads(path.read_text())
        except ValueError:
            return refuse("is not valid JSON")
        if not isinstance(data, dict):
            return refuse("is not a JSON object")
    sandbox = data.setdefault("sandbox", {})
    if not isinstance(sandbox, dict):
        return refuse("has a non-object sandbox")
    network = sandbox.setdefault("network", {})
    if not isinstance(network, dict):
        return refuse("has a non-object sandbox.network")
    excluded = sandbox.get("excludedCommands", [])
    domains = network.get("allowedDomains", [])
    if not isinstance(excluded, list) or not isinstance(domains, list):
        return refuse("has non-list excludedCommands or allowedDomains")
    sandbox["excludedCommands"] = union(excluded, COMMANDS)
    network["allowedDomains"] = union(domains, [host])
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + "\n")

    ignore = repo / ".gitignore"
    lines = ignore.read_text().splitlines() if ignore.exists() else []
    if not any(l.strip().lstrip("/") in (SETTINGS, "settings.local.json") for l in lines):
        ignore.write_text("\n".join(lines + [SETTINGS]) + "\n")
    print(f"updated {SETTINGS}: {', '.join(COMMANDS)} now run unsandboxed; {host} allowed")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
