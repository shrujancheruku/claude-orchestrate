#!/usr/bin/env python3
"""sandbox-git [--repo PATH] : let agents git fetch/pull/push over SSH under the sandbox.

On macOS, SSH from inside the sandbox fails even for an allowed host (plain ssh ignores the
proxy), so the documented fix is to run the git commands outside it. For an SSH `origin`
this merges into <repo>/.claude/settings.local.json:

    sandbox.excludedCommands       += "git fetch *", "git pull *", "git push *"
    sandbox.network.allowedDomains += <origin's host>

Lists are unioned without duplicates and every other key is kept. The file is created when
missing, and refused (exit 1, untouched) when it isn't a JSON object of the expected shape.
A non-SSH origin changes nothing. The file is local, so `.claude/settings.local.json` is
added to .gitignore when `git check-ignore` doesn't already ignore it.
Docs: https://code.claude.com/docs/en/sandboxing

Exit 0 done (or nothing to do), 1 refused, 2 could not run (bad usage, no repo or origin, unreadable file). Stdlib only, Python 3.9+.
"""

import argparse
import json
import os
import re
import stat
import sys
import tempfile
from pathlib import Path

import common

COMMANDS = ["git fetch *", "git pull *", "git push *"]
SETTINGS = ".claude/settings.local.json"


HOST = r"(\[[^\]]+\]|[^@/:\[\s]+)"  # a bracketed IPv6 literal, or a plain name


def ssh_host(url):
    """The host of an SSH remote (brackets stripped from IPv6), or None for anything else."""
    m = re.match(r"^ssh://(?:[^@/]+@)?" + HOST, url)
    if not m and "://" not in url:
        # scp-like `[user@]host:path`: no slash before the colon, and a host longer than
        # one letter so a Windows drive (`C:\\x`) isn't mistaken for one.
        m = re.match(r"^(?:[^@/\s:]+@)?" + HOST + ":", url)
        if m and len(m.group(1)) < 2:
            m = None
    return m.group(1).strip("[]") if m else None


def write_atomic(path, text):
    """Write beside the target, then replace, so a crash never leaves a half-written file."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        # mkstemp makes 0600; keep an existing file's mode, else a normal 0644.
        os.chmod(tmp, stat.S_IMODE(path.stat().st_mode) if path.exists() else 0o644)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def union(existing, wanted):
    return list(existing) + [w for w in wanted if w not in existing]


def refuse(why):
    print(f"refused: {SETTINGS} {why}; left untouched", file=sys.stderr)
    return 1


def main(argv):
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--repo", default=".", help="the repo (default: current directory)")
    repo = Path(ap.parse_args(argv).repo)
    r = common.run("git", "remote", "get-url", "origin", cwd=repo)
    if r.returncode != 0:
        # Not "nothing to change": a wrong --repo or a missing origin must not pass quietly.
        common.die(f"sandbox-git: cannot read origin of {repo}: {common.one_line(r.stderr) or 'git failed'}")
    host = ssh_host(r.stdout.strip())
    if not host:
        print("origin is not an SSH remote: nothing to change")
        return 0

    path = repo / SETTINGS
    data = {}
    if path.exists():
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except OSError as e:
            common.die(f"sandbox-git: cannot read {path}: {e.strerror or e}")
        except ValueError:
            return refuse("is not valid JSON")
        if not isinstance(data, dict):
            return refuse("is not a JSON object")
    sandbox = data.setdefault("sandbox", {})
    if not isinstance(sandbox, dict):
        return refuse("has a non-object sandbox")
    network = sandbox.setdefault("network", {})
    if not isinstance(network, dict):
        return refuse("has a non-object sandbox.network")
    excluded = sandbox.get("excludedCommands", [])
    domains = network.get("allowedDomains", [])
    if not isinstance(excluded, list) or not isinstance(domains, list):
        return refuse("has non-list excludedCommands or allowedDomains")
    sandbox["excludedCommands"] = union(excluded, COMMANDS)
    network["allowedDomains"] = union(domains, [host])
    write_atomic(path, json.dumps(data, indent=2) + "\n")

    # check-ignore handles `.claude/`, `*.local.json` and negations; append only if not ignored.
    ignored = common.run("git", "check-ignore", "-q", SETTINGS, cwd=repo).returncode == 0
    if not ignored:
        ignore = repo / ".gitignore"
        try:
            old = ignore.read_text(encoding="utf-8") if ignore.exists() else ""
        except OSError as e:
            common.die(f"sandbox-git: cannot read {ignore}: {e.strerror or e}")
        if old and not old.endswith("\n"):
            old += "\n"
        write_atomic(ignore, old + SETTINGS + "\n")
    print(f"updated {SETTINGS}: {', '.join(COMMANDS)} now run unsandboxed; {host} allowed")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
