#!/usr/bin/env python3
"""worker-live <branch> [--repo DIR] : is the old worker on this branch still live in some session? (ADR 0009)

Finds the worktree checked out on <branch> with `git worktree list` (never the state file) and reads its lock.
Prints one line:
    live <pid> <worktree>    locked, and the lock's session pid is running with the start time the lock records
                             (`?` for the pid, then ` (lock: <reason>)`, when the reason doesn't parse: it counts as live;
                             unlock the worktree if it is stale)
    dead <worktree>          locked, but the pid is gone or running with another start time: unlock it, then rescue it
    none                     no lock, or no worktree on the branch
Exit codes: 0 printed a line; 2 could not run (not a repository, no git). Stdlib only, Python 3.9+.
"""

import argparse
import sys
from pathlib import Path

import common


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("branch", help="the ticket's branch")
    ap.add_argument("--repo", default=".", help="a directory of the repository (default: the current one)")
    args = ap.parse_args(argv)
    root = Path(args.repo)
    r = common.run("git", "rev-parse", "--git-dir", cwd=root if root.is_dir() else None)
    if not root.is_dir() or r.code != 0:
        common.die(f"worker-live: cannot run: {args.repo} is not in a git repository")
    state, pid, worktree, reason = common.worker_liveness(root, args.branch)
    if state == "live":
        print(f"live {pid} {worktree}" if pid is not None else f"live ? {worktree} (lock: {reason or 'no reason given'})")
    elif state == "dead":
        print(f"dead {worktree}")
    else:
        print("none")
    return 0


if __name__ == "__main__":
    sys.exit(main())
